@model IEnumerable<BANA.Models.Examen>

@{
    ViewData["Title"] = "Index";
}
   <div class="container-fluid">
          <div class="block-header">
            <div class="row clearfix">
             <div class="col-lg-4 col-md-12 col-sm-12">
                <h1>Policlinique de Poitiers</h1>
                <span>Imagerie, Analyses Médicales, Tables des réactifs...</span>
              </div>
              <div class="col-lg-8 col-md-12 col-sm-12 text-lg-right">
                <div class="d-flex align-items-center justify-content-md-end mt-4 mt-md-0 flex-wrap vivify pullUp delay-550">
                  <div class="mb-3 mb-xl-0">
                    <button class="btn btn-primary" onclick="location.href='/Examen/Create';" title="" >Ajouter un Template</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="row clearfix">

           

            @if (Model.Count()==0)
            {
                 <!-- Blank Start -->
                <div class="container-fluid pt-4 px-4">
                    <div class="row vh-100 bg-light rounded align-items-center justify-content-center mx-0">
                        <div class="col-md-6 text-center">
                            <h3>Aucun Template Crée !</h3>
                        </div>
                    </div>
                </div>
                <!-- Blank End -->

            }else{
                
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                <div class="card">
                    <img class="img-fluid rounded" width=100px style="margin: auto;display: flex;" src="/img1/reactifs.png" alt="">
                    <div style="text-align: center;" class="body">
                    <h6 class="mt-3">Table des réactifs</h6>
                    <div class="">
                       
                        <div class="ml-2 mr-2">
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i class="fa fa-star-o"></i>
                        <i class="fa fa-star-o"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        @* <a asp-action="Index" asp-controller="Service" asp-route-departement="@item.Nom" class="btn btn-outline-secondary">Services</a> *@
                        <a asp-action="Index2" asp-route-tipe="Table des réactifs" class="btn btn-outline-secondary">Afficher</a>
                        <div class="avatar-list avatar-list-stacked">
                        <img class="avatar sm" src="/template/assets/images/xs/avatar5.jpg" data-toggle="tooltip" title="" data-original-title="Avatar">
                        </div>
                    </div>
                    </div>
                </div>
                </div>



                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                <div class="card">
                    <img class="img-fluid rounded" width=100px style="margin: auto;display: flex;" src="/img1/analyse.png" alt="">
                    <div style="text-align: center;" class="body">
                    <h6 class="mt-3">Analyse Médicale</h6>
                    <div class="">
                       
                        <div class="ml-2 mr-2">
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i class="fa fa-star-o"></i>
                        <i class="fa fa-star-o"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        @* <a asp-action="Index" asp-controller="Service" asp-route-departement="@item.Nom" class="btn btn-outline-secondary">Services</a> *@
                        <a asp-action="Index2" asp-route-tipe="Analyse Médicale" class="btn btn-outline-secondary">Afficher</a>
                        <div class="avatar-list avatar-list-stacked">
                        <img class="avatar sm" src="/template/assets/images/xs/avatar5.jpg" data-toggle="tooltip" title="" data-original-title="Avatar">
                        </div>
                    </div>
                    </div>
                </div>
                </div>




                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                <div class="card">
                    <img class="img-fluid rounded" width=100px style="margin: auto;display: flex;" src="/img1/imagerie.png" alt="">
                    <div style="text-align: center;" class="body">
                    <h6 class="mt-3">Imagerie Médicale</h6>
                    <div class="">
                       
                        <div class="ml-2 mr-2">
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i style="color: #82b540;" class="fa fa-star"></i>
                        <i class="fa fa-star-o"></i>
                        <i class="fa fa-star-o"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        @* <a asp-action="Index" asp-controller="Service" asp-route-departement="@item.Nom" class="btn btn-outline-secondary">Services</a> *@
                        <a asp-action="Index2" asp-route-tipe="Imagerie Médicale" class="btn btn-outline-secondary">Afficher</a>
                        <div class="avatar-list avatar-list-stacked">
                        <img class="avatar sm" src="/template/assets/images/xs/avatar5.jpg" data-toggle="tooltip" title="" data-original-title="Avatar">
                        </div>
                    </div>
                    </div>
                </div>
                </div>
               


            }

            
          </div>
        </div>

