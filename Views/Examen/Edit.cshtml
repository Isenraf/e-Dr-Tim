@model BANA.Models.Examen

@{
    ViewData["Title"] = "Edit";
}

<link rel="stylesheet" href="~/css/richtext.css">

<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Examens et Imagerie
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card">
              <div class="card-body">
                <div
                  class="d-flex align-items-center justify-content-between mt-2 mx-3 mb-4"
                >
                  <h5 class="card-title">Création d'un Template d'examen!</h5>

                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">--</span>
                      <span class="text-success">Analyses Médicales</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">--</span>
                      <span class="text-danger">Imagerie Médicales</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">--</span>
                      <span class="text-info">Total des réactifs</span>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for=""
                            >Nomination
                            <span class="text-danger">*</span></label
                          >
                          <input
                            type="text"
                            class="form-control"
                            id="nom_examen" asp-for="Nom"
                          />
                        </div>
                        <input asp-for="Id" type="hidden" id="identifiant"  />
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Montant </label>
                          <input type="number" class="form-control" id="montant_examen" asp-for="Montant" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Catégorie </label>
                           <select id="categorie_examen"  asp-for="Categorie" class="form-select">
                              @foreach(var item in ViewBag.tipe){
                                <option asp-for="Categorie" value="@item">@item</option>
                              }
                            </select>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Code </label>
                          <input type="text" class="form-control" id="code" asp-for="Code" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Cote </label>
                          <input type="text" class="form-control" id="cote" asp-for="Cote" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Type </label>
                         <input id="ExamType" list="Extip" asp-for="ExamType" class="form-control">
                              <span asp-validation-for="ExamType" class="text-danger"></span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Min </label>
                          <input type="number" class="form-control" id="min" asp-for="Min" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 col-md-6 col-sm-12 my-2">
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="m-0">
                          <label class="form-label" for="">Max </label>
                          <input type="number" class="form-control" id="max" asp-for="Max" />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
          <!-- app body end-->

              <a  style="position: fixed;right: 110px;bottom: 45px;" onclick="history.back()" href="#" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-close"></i></a>
              <a  style="position: fixed;right: 50px;bottom: 45px;" id="savetemplate" href="#" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-save"></i></a>


<datalist id="Extip">
    @foreach (var item in ViewBag.Type)
    {
         
        <option  value="@item">@item</option>

    }
</datalist>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
