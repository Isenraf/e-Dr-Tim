@model IEnumerable<BANA.Models.Examen>

@{
    ViewData["Title"] = "Index";
    int i=1;
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Anapath
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                
                <div class="card-header">
                  
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      
                      <span><h6>Modèles Anapath</h6></span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-success">Total Modèles</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1"><span class="separateur">@ViewData["Anapath"]</span></span>
                      <span class="text-danger">Anapath</span>
                    </div>
                   
                    
                  </div>
                </div>

                <div class="card-body">
                  <!-- barre de recherche start-->
                  <div class="card">
                    <div class="card-body">
                      <input
                        id="search"
                        type="search"
                        class="form-control"
                        placeholder="Bare de Recherche"
                      />
                    </div>
                  </div>
                  <!-- barre de recheche end -->

                  <div class="table-outer">
                    <div class="table-responsive">
                      <table class="table truncate m-0">
                        <thead>
                          <tr>
                            <th><strong>Nomination</strong></th>
                            <th><strong>Prix</strong></th>
                            <th><strong>Catégorie</strong></th>
                            <th><strong>Status</strong></th>
                            <th><strong>Actions</strong></th>
                          </tr>
                        </thead>

                        <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                            <tr class="montest">
                              <td>
                                  <div class="d-flex align-items-center">
                                    @if(item.Categorie=="Imagerie Médicale"){
                                      <img src="/template2/assets/images/imageri.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="afficher le modèle"/>
                                    }else{
                                      <img src="/template2/assets/images/examen.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="afficher le modèle"/>
                                    }
                                    
                                    <div class="ml-3">
                                    <a asp-action="Details" asp-route-Id="@item.Id" title="">@item.Nom</a>
                                      
                                      <p style="max-width: 300px; overflow: hidden" class="mb-0">
                                        @item.Categorie
                                      </p>
                                    </div>
                                  </div>
                                </td>
                                <td><span class="separateur"> @item.Montant</span> FCFA</td>
                                <td>@item.Categorie</td>
                                <td><span class="badge border border-success text-success">Actif</span></td>
                                <td> 
                                  <button style="background-color: #116aef63;" type="button" onclick="location.href='/Examen/Edit/@item.Id';" class="btn btn-outline-secondary" title="Modifier">
                                      <i class="fa fa-pencil"></i>
                                    </button>
                                  @if(item.Categorie=="Imagerie Médicale"){
                                    <button type="button" onclick="location.href='/Examen/Edit3/@item.Id';" class="btn btn-outline-secondary" title="Modifier">
                                      <i class="fa fa-pencil"></i>
                                    </button>
                                  }else{
                                    <button type="button" onclick="location.href='/Examen/Edit2/@item.Id';" class="btn btn-outline-secondary" title="Modifier">
                                      <i class="fa fa-pencil"></i>
                                    </button>
                                  }
                                

                              </td>
                            </tr>
                          }

                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- app body end-->

      
<a  style="position: fixed;right: 100px;bottom: 45px;" href="/Examen/Create?tipe=@ViewData["cat"]" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
<a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Liste" asp-route-tipe="@ViewData["cat"]"  class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-list"></i></a>     
