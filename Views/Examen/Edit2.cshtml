@model BANA.Models.Examen

@{
    ViewData["Title"] = "Edit";
}

<link rel="stylesheet" href="~/css/richtext.css">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item"> <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i> <a asp-action="Index" asp-controller="Departement">Acceuil</a> </li>
            <li class="breadcrumb-item text-primary" aria-current="page"> Examens et Imagerie </li>
        </ol> <!-- Breadcrumb ends -->
    </div> <!-- App Hero header ends -->
    <!-- app body start -->
    <input asp-for="Id" type="hidden" id="identifiant"  />
                <input asp-for="Categorie" type="hidden" id="categorie_examen"  />
    <div class="app-body">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mt-2 mx-3 mb-4">
                    <h5 class="card-title">@Model.Nom</h5>
                    <div class="d-flex flex-wrap gap-1">
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"> <i class="ri-pie-chart-2-fill text-success fs-4"></i> <span class="me-1 fw-semibold ps-1">--</span> <span class="text-success">Analyses Médicales</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"> <i class="ri-pie-chart-2-fill text-danger fs-4"></i> <span class="me-1 fw-semibold ps-1">--</span> <span class="text-danger">Imagerie Médicales</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"> <i class="ri-pie-chart-2-fill text-info fs-4"></i> <span class="me-1 fw-semibold ps-1">--</span> <span class="text-info">Total des réactifs</span> </div>
                    </div>
                </div>
                <div id="summernote"> @Html.Raw(@Model.Contenu) </div>
            </div>
        </div>
    </div> <!-- app body end-->

              <a  style="position: fixed;right: 110px;bottom: 45px;" onclick="history.back()" href="#" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-close"></i></a>
              <a  style="position: fixed;right: 50px;bottom: 45px;" id="savetemplate" href="#" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-save"></i></a>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
