<!-- My script -->
    <script>
      const tds = document.querySelectorAll("td");
      const edits = document.querySelectorAll(".editable");

      tds.forEach((td) => {
        td.contentEditable = true;
      });

      edits.forEach((td) => {
        td.contentEditable = true;
      });
    </script>

    <script>
      const svgs = document.querySelectorAll("svg");
      const cx = 250,
        cy = 250,
        r = 200;

      // --- Dessine le cercle + graduations ---
      svgs.forEach((svg) => {
        for (let angle = 0; angle < 360; angle += 10) {
          const rad = (angle * Math.PI) / 180;
          const x = cx + r * Math.sin(rad);
          const y = cy - r * Math.cos(rad);

          const line = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "line"
          );
          line.setAttribute("x1", cx);
          line.setAttribute("y1", cy);
          line.setAttribute("x2", x);
          line.setAttribute("y2", y);
          line.setAttribute("stroke", "black");
          line.setAttribute("stroke-width", "1");
          svg.appendChild(line);

          // Texte
          const tx = cx + (r + 20) * Math.sin(rad);
          const ty = cy - (r + 20) * Math.cos(rad);
          const text = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "text"
          );
          text.setAttribute("x", tx);
          text.setAttribute("y", ty);
          text.setAttribute("font-size", "12");
          text.setAttribute("text-anchor", "middle");
          text.setAttribute("dominant-baseline", "middle");
          text.setAttribute("fill", "black");
          text.textContent = angle + "°";
          svg.appendChild(text);
        }

        // Crée la ligne rouge par défaut (0°)
        const redLine = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "line"
        );
        redLine.classList.add("axe-line");
        redLine.setAttribute("x1", cx);
        redLine.setAttribute("y1", cy);
        redLine.setAttribute("x2", cx);
        redLine.setAttribute("y2", cy - r);
        redLine.setAttribute("stroke", "red");
        redLine.setAttribute("stroke-width", "3");
        svg.appendChild(redLine);
      });

      // --- Fonction pour mettre à jour la ligne rouge ---
      function updateAxe(svg, angle) {
        const rad = (angle * Math.PI) / 180;
        const x = cx + r * Math.sin(rad);
        const y = cy - r * Math.cos(rad);

        const redLine = svg.querySelector(".axe-line");
        redLine.setAttribute("x2", x);
        redLine.setAttribute("y2", y);
      }

      // --- Rendre les cellules AXE éditables ---
      const axeCells = document.querySelectorAll(".axe");
      axeCells.forEach((cell) => {
        cell.contentEditable = true;
        cell.addEventListener("input", () => {
          const angle = parseFloat(cell.textContent);
          if (!isNaN(angle)) {
            const svg = document.querySelector("svg." + cell.dataset.eye);
            updateAxe(svg, angle);
          }
        });
      });
    </script>
