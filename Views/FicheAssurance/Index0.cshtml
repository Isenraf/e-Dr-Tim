@model IEnumerable<BANA.Models.FicheAssurance>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}


<link href="/css/stock.css" rel="stylesheet">
<!-- App container starts -->
        <div class="app-container">
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Fiches Assurances
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

<!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                 <div
                class="card-header d-flex align-items-center justify-content-between"
              >
                <h5 class="card-title">
                  Fiches Assurances<br /><h7
                    style="font-size: 12px; color: #4c545e"
                    >Fiches Assurances</h7
                  >
                </h5>
                <button class="btn btn-primary ms-auto" onclick="location.href='/FicheAssurance/Create'">Nouveau</button>
              </div>
              <br />
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                       <span class="text-danger">Nombre de fiches</span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewBag.cat</span>
                      <span class="text-danger">Nombre d'assurances</span>
                    </div>
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3">
                      <div class="card">
                        <div class="card-body">
                        <form asp-controller="FicheAssurance" asp-action="Index"  method="get">
                          <input type="search" id="search" name="target" class="form-control" placeholder="Bare de Recherche"/>
                        </form>
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>
                  </div>
                </div>
                @{
                  int i=0;
                }

                <div class="row gx-3 px-2">
                  
                  <div class="wrapper">
                    <div id="testfiltre"  class="grid">
                        @foreach (var item in ViewBag.cat)
                        {
                           
                            <div   class="item montest">
                              <a asp-action="Index" asp-route-cat="@item" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/assets/images/assurancef.png" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 texte" style="color:#0c90ac;font-weight: bold;margin-bottom: 0px;margin-bottom: 0px;">@item</h6>
                                </div>
                                    @* <span style="display: none;" class="cl_0">@item.Id</span> *@
                                </a>
                            </div>
                          i++;
                        }
                        
                    </div>
                </div> 

                </div>
              </div>
            </div>
            <!-- App body ends -->
          </div>
        </div>
