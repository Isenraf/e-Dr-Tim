@model IEnumerable<BANA.Models.FicheAssurance>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}


<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Fiche assurance
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card py-3 px-3">
              <div class="d-flex align-items-center justify-content-between mt-2">
                <h5 class="card-title">Fiche assurance</h5>

                <div class="d-flex flex-wrap gap-1">
                  
                  <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                    <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                    <span class="me-1 fw-semibold ps-1"><span class="separateur">@Model.Count()</span> fiches</span>
                    <span class="text-success">Nommbre de fiches</span>
                  </div>

                </div>
              </div>
              <br/>

              <div class="row gx-3 gy-3">
                <div class="card">
                  <div
                    style="
                      display: flex;
                      justify-content: space-between;
                      align-items: center;
                    "
                  >
                  

                    <div style="display: flex; gap: 10px">
                      
                    </div>
                  </div>
                </div>
                <div class="col-12">
                  <div class="row gx-3 gy-3">
                    <div class="card">
                      <div class="card-body">
                        <form asp-controller="FicheAssurance" asp-action="Index"  method="get">
                          <input type="search" id="search" name="target" class="form-control" placeholder="Bare de Recherche"/>
                        </form>
                      </div>
                    </div>
                  </div>

                  <div class="table-responsive mt-3">
                    <table
                      class="table truncate m-0"
                      style="width: 100%; border-collapse: collapse"
                    >
                      <thead>
                        <tr>
                          <th>Désignation</th>
                          <th>Catégorie</th>
                          <th>Création</th>
                        </tr>
                      </thead>
                      <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                            <tr class="montest ">
                              <td>
                                <div class="d-flex align-items-center">
                                  <img src="/template2/assets/images/pdf.png" style="box-shadow: 0 5px 5px #0c90ac;" class="img-2xx me-2" alt="@item.Nom"/>
                                  <div class="ml-3">
                                      <a href="#" style="color: #0c90ac;" title="afficher la facture">@item.Nom</a>
                                    <p style="max-width: 300px; overflow: hidden" class="mb-0">@item.Assurance</p>
                                  </div>
                                </div>
                                
                              </td>
                              <td>@item.Categorie</td>
                              <td>@item.Create_date</td>
                             
                              <td>
                                    <button onclick="location.href='/FicheAssurance/Delete/@item.Id';" type="button" class="btn btn-outline-secondary" title="supprimer la fiche">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                    <button onclick="location.href='/FicheAssurance/Edit/@item.Id';" type="button" class="btn btn-outline-secondary" title="modifier la fiche">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                     
                                    <button type="button"  class="btn btn-outline-secondary ficheassurance" title="afficher la fiche">
                                      <input type="hidden" value="@item.Id">
                                    <i class="fa fa-eye"></i>
                                    </button>
                              </td>
                            </tr>
                          }
                      </tbody>
                    </table>
                  </div>

                  <!-- body body end -->
                 
                </div>
              </div>
              <!-- App body ends -->
            </div>
          </div>




<style>
  /* Modale */
      .modal, .modal2{
      display: none;
      position: fixed;
      z-index: 999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
      position: relative;
      background-color: #fff;
      margin: 5% auto;
      padding: 0;
      width: 80%;
      height: 80%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      }

      .modal-header {
      padding: 10px;
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .modal-body {
      flex: 1;
      overflow: hidden;
      }

      .modal iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .modal2 iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .close-btn {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      }
</style>



<!-- Modal -->
<div id="pdfModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
    <span>📄 Détails Facture </span>
    <button class="close-btn" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
    <iframe id="target" src=""></iframe> <!-- Remplace par ton PDF -->
    </div>
  </div>
</div>



<script>
    const modal = document.getElementById('pdfModal');
    function closeModal() {
      modal.style.display = 'none';
      document.getElementById("target").setAttribute("src", "");
    }

    // Fermer si on clique en dehors du contenu
    window.onclick = event => {
      if (event.target === modal) {
        closeModal();
      }
    };
</script>
