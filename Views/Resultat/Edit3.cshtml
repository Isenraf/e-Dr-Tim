@model BANA.Models.Resultat

@{
    ViewData["Title"] = "Edit";
}

<link rel="stylesheet" href="~/css/richtext.css">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item"> <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i> <a asp-action="Index" asp-controller="Departement">Acceuil</a> </li>
            <li class="breadcrumb-item text-primary" aria-current="page"> Examens et Imagerie </li>
        </ol> <!-- Breadcrumb ends -->
    </div> <!-- App Hero header ends -->
   
    <!-- app body start -->
    <div class="app-body">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mt-2 mx-3 mb-4">
                    <h5 class="card-title">@Model.Nom</h5>
                    <div class="d-flex flex-wrap gap-1">
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">@Model.NomPatient</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">@Model.Genre</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">@((int)((DateTime.Now-Model.Date_de_naissance).TotalDays/365)) ans  @((int)(((DateTime.Now-Model.Date_de_naissance).TotalDays%365)/30)) mois @((((int)(DateTime.Now-Model.Date_de_naissance).TotalDays)%365)%30) jours</span></div>
                    </div>
                </div>
                <input asp-for="Id" type="hidden" id="identifiant"  />
                <div class="card">
                  <iframe style="min-height: 30cm;" src="/Resultat/edit2/@Model.Id" frameborder="0"></iframe>

                </div>
                @Model.Contenu
            </div>
        </div>
    </div> <!-- app body end-->

    <a  style="position: fixed;right: 50px;bottom: 45px;" id="saveresultat2" href="#" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-save"></i></a>
     <a  style="position: fixed;right: 100px;bottom: 45px;" onclick="history.back()" href="javascript:void(0)" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-close"></i></a>
    


<style>
/* content editable */

*[contenteditable] { border-radius: 0.25em; min-width: 1em; outline: 0; }

*[contenteditable] { cursor: pointer; }

*[contenteditable]:hover, *[contenteditable]:focus, td:hover *[contenteditable], td:focus *[contenteditable], img.hover { background: #DEF; box-shadow: 0 0 1em 0.5em #DEF; }

span[contenteditable] { display: inline-block; }
table { width: 100%; }
th, td { border-width: 1px; padding: 0.5em; position: relative; text-align: left; }




/* table items */

table.inventory { clear: both; width: 98%; margin-left: 20px;}
table.inventory th { font-weight: bold; text-align: center; }

table.inventory td:nth-child(1) { width: 50%; }
table.inventory td:nth-child(2) { width: 50%; }








/* javascript */

.add
{
	display: block;
	font-size: .8rem;
	padding: 0.25em 0.5em;	
	float: left;
	text-align: center;
}
.cut{
    width: 25px;
}


.add { margin: -2.5em 0 0; }

.add:hover { background: #89e114; }

.cut { opacity: 0; position: absolute; top: 0; left: -1.9em; color: #FFF; }
.cut { -webkit-transition: opacity 100ms ease-in; }
tr:hover .cut { opacity: 1; }


</style>

<script type="text/javascript">
function addRows(){ 
	var table = document.getElementById('emptbl');
	var rowCount = table.rows.length;
	var cellCount = table.rows[0].cells.length; 
	var row = table.insertRow(rowCount);
	for(var i =0; i < cellCount; i++){
		var cell = 'cell'+i;
		cell = row.insertCell(i);
		var copycel = document.getElementById('col'+i).innerHTML;
		cell.innerHTML=copycel;
		
	}
}
function deleteRows(){
	var table = document.getElementById('emptbl');
	var rowCount = table.rows.length;
	if(rowCount > '2'){
		var row = table.deleteRow(rowCount-1);
		rowCount--;
	}
	else{
		
	}
}

