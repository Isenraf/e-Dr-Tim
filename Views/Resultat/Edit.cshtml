@model BANA.Models.Resultat

@{
    ViewData["Title"] = "Edit";
}

<link rel="stylesheet" href="~/css/richtext.css">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item"> <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i> <a asp-action="Index" asp-controller="Departement">Acceuil</a> </li>
            <li class="breadcrumb-item text-primary" aria-current="page"> Examens et Imagerie </li>
        </ol> <!-- Breadcrumb ends -->
    </div> <!-- App Hero header ends -->
   
    <!-- app body start -->
    <div class="app-body">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mt-2 mx-3 mb-4">
                    <h5 class="card-title">@Model.Nom</h5>
                    <div class="d-flex flex-wrap gap-1">
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">@Model.NomPatient</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">@Model.Genre</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">@((int)((DateTime.Now-Model.Date_de_naissance).TotalDays/365)) ans  @((int)(((DateTime.Now-Model.Date_de_naissance).TotalDays%365)/30)) mois @((((int)(DateTime.Now-Model.Date_de_naissance).TotalDays)%365)%30) jours</span></div>
                    </div>
                </div>
                
                @if(ViewBag.user.nom=="DR NGOUNGOURE"){
                  <div id="summernote"> @Html.Raw(Model.Contenu.Replace("false","True").Replace("False","True").Replace("FALSE","True")) </div>
                }else{
                  <div id="summernote"> @Html.Raw(Model.Contenu) </div>
                }
                
                      <div class="card">
                        <div class="body">
                            <input asp-for="Id" type="hidden" id="identifiant"  />
                                <br>
                                @if(ViewBag.Lignes1.Count>0){
                                  <input id="t1" style="border-color: #116aef;" value="@ViewBag.Lignes1[0]" contenteditable class="form-control"> 
                                  <table id="emptbl" class="table table-hover table-striped inventory1">
                                      <thead>
                                            <tr>
                                              <th style="text-align: center;">#Antibiotique </th>
                                              <th style="text-align: center;">Taux</th>
                                          </tr>
                                      </thead>
                                      <tbody>
                                        <tr style="display: none;">
                                              <td id="col0"><input style="border-color: #116aef;" contenteditable class="form-control" list="antibiotique" autocomplete="off"></td>
                                              <td id="col1" style="text-align: center;">
                                                <select  style="border-color: #116aef;" class="form-control show-tick ref">
                                                  <option  value="">Aucune sélection</option>
                                                  <option  value="Sensible">Sensible</option>
                                                  <option  value="Intermédiaire">Intermédiaire</option>
                                                  <option  value="Résistant">Résistant</option>
                                                </select>
                                              </td>
                                          </tr>
                                          @for (int i = 1; i < ViewBag.Lignes1.Count-1; i+=2)
                                          {
                                            <tr>
                                                <td id="col0"><input value="@ViewBag.Lignes1[i]" style="border-color: #116aef;" contenteditable class="form-control" list="antibiotique" autocomplete="off"></td>
                                                <td id="col1" style="text-align: center;">
                                                  <select  style="border-color: #116aef;" class="form-control show-tick ref">
                                                    @if(ViewBag.Lignes1[i+1]=="Sensible"){
                                                      <option  value="Sensible" selected>Sensible</option>
                                                    }else{
                                                      <option  value="Sensible">Sensible</option>
                                                    }
                                                    @if(ViewBag.Lignes1[i+1]=="Intermédiaire"){
                                                      <option  value="Intermédiaire" selected>Intermédiaire</option>
                                                    }else{
                                                      <option  value="Intermédiaire">Intermédiaire</option>
                                                    }
                                                    @if(ViewBag.Lignes1[i+1]=="Résistant"){
                                                      <option  value="Résistant" selected>Résistant</option>
                                                    }else{
                                                      <option  value="Résistant">Résistant</option>
                                                    }
                                                  </select>
                                                </td>
                                            </tr>
                                          }
                                          

                                      </tbody>
                                  </table>
                                }else{
                                  <input id="t1" style="border-color: #116aef;" value="ANTIBIOGRAMME" contenteditable class="form-control"> 
                                  <table id="emptbl" class="table table-hover table-striped  inventory1">
                                      <thead>
                                            <tr>
                                              <th style="text-align: center;">#Antibiotique </th>
                                              <th style="text-align: center;">Taux</th>
                                          </tr>
                                      </thead>
                                      <tbody>
                                          <tr>
                                              <td id="col0"><input style="border-color: #116aef;" contenteditable class="form-control" list="antibiotique" autocomplete="off"></td>
