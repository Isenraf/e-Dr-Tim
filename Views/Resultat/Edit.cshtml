                                                <td id="coll1" style="text-align: center;">
                                                  <select  style="border-color: #116aef;" class="form-control show-tick ref">
                                                    <option  value="">Aucune sélection</option>
                                                    <option  value="Sensible">Sensible</option>
                                                    <option  value="Intermédiaire">Intermédiaire</option>
                                                    <option  value="Résistant">Résistant</option>
                                                  </select>
                                                </td>
                                            </tr>
                                          @for (int i = 1; i < ViewBag.Lignes2.Count-1; i+=2)
                                          {
                                            
                                            <tr>
                                                <td id="coll0"><input style="border-color: #116aef;" value="@ViewBag.Lignes2[i]" contenteditable class="form-control" list="antibiotique2" autocomplete="off"></td>
                                                <td id="coll1" style="text-align: center;">
                                                  <select  style="border-color: #116aef;" class="form-control show-tick ref">
                                                    @if(ViewBag.Lignes2[i+1]=="Sensible"){
                                                    <option  value="Sensible" selected>Sensible</option>
                                                    }else{
                                                      <option  value="Sensible">Sensible</option>
                                                    }
                                                    @if(ViewBag.Lignes2[i+1]=="Intermédiaire"){
                                                      <option  value="Intermédiaire" selected>Intermédiaire</option>
                                                    }else{
                                                      <option  value="Intermédiaire">Intermédiaire</option>
                                                    }
                                                    @if(ViewBag.Lignes2[i+1]=="Résistant"){
                                                      <option  value="Résistant" selected>Résistant</option>
                                                    }else{
                                                      <option  value="Résistant">Résistant</option>
                                                    }
                                                  </select>
                                                </td>
                                            </tr>
                                          }
                                        </tbody>
                                    </table>
                                  }else{
                                    <input id="t2" style="border-color: #116aef;" value="ANTIFONGIGRAMME" contenteditable class="form-control">
                                    <table id="emptbl2" class="table table-hover table-striped inventory2">
                                        <thead>
                                              <tr>
                                                <th style="text-align: center;">#Antifungique (µg) </th>
                                                <th style="text-align: center;">Taux</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td id="coll0"><input style="border-color: #116aef;" contenteditable class="form-control" list="antibiotique2" autocomplete="off"></td>
                                                <td id="coll1" style="text-align: center;">
                                                  <select  style="border-color: #116aef;" class="form-control show-tick ref">
                                                    <option  value="">Aucune sélection</option>
                                                    <option  value="Sensible">Sensible</option>
                                                    <option  value="Intermédiaire">Intermédiaire</option>
                                                    <option  value="Résistant">Résistant</option>
                                                  </select>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                  }
                                  
                                <a class="btn btn-primary gradient" onclick="addRows2()" style="color: #FFF;">+ Ajouter</a>
                                <a class="btn btn-danger  gradient" onclick="deleteRows2()" style="color: #FFF;">- Supprimer</a>
                        </div>
                      </div>

                
            </div>
        </div>
    </div> <!-- app body end-->

    <a  style="position: fixed;right: 50px;bottom: 45px;" id="saveresultat" href="#" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-save"></i></a>
     <a  style="position: fixed;right: 100px;bottom: 45px;" onclick="history.back()" href="javascript:void(0)" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-close"></i></a>
    

