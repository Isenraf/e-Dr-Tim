                                                  <option  value="Résistant">Résistant</option>
                                                </select>
                                              </td>
                                          </tr>
                                      </tbody>
                                  </table>
                                }
                                  
                                <a class="btn btn-primary gradient" onclick="addRows()" style="color: #FFF;">+ Ajouter</a>
                                <a class="btn btn-danger gradient" onclick="deleteRows()" style="color: #FFF;">- Supprimer</a>
                                  <br><br>
                                  @if(ViewBag.Lignes2.Count>0){
