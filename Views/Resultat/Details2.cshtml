<style>
   .button-group {
  text-align: left; /* optional, ensures alignment */
}

.button-group button {
  margin-right: 8px; /* spacing between buttons */
}

   .btn1 {
    position: fixed;
    bottom: 50px;
    right: 50px;
  border: none;
  height: 2.5em;
  border-radius: 0.5em;
  justify-content: center;
  align-items: center;
  gap: 12px;
  background: #0B8FAC;
  cursor: pointer;
  transition: all 450ms ease-in-out;
}

.sparkle {
  fill: #fff;
  transition: all 800ms ease;
}

.text1 {
  font-weight: 600;
  color: #fff;
  font-size: medium;
}

.btn1:hover {
  background: linear-gradient(0deg,#0B8FAC,#0B8FAC);
  box-shadow: inset 0px 1px 0px 0px rgba(255, 255, 255, 0.4),
  inset 0px -4px 0px 0px rgba(0, 0, 0, 0.2),
  0px 0px 0px 4px rgba(255, 255, 255, 0.2),
  0px 0px 180px 0px #0B8FAC;
  transform: translateY(-2px);
}

.btn1:hover .text {
  color: white;
}

.btn1:hover .sparkle {
  fill: white;
  transform: scale(1.2);
} 
  </style>

<button id="interactionmedoclabo" class="btn1"><span class="text1">Dr Tim IA</span>
    <svg height="24" width="24" fill="#FFFFFF" viewBox="0 0 24 24" data-name="Layer 1" id="Layer_1" class="sparkle">
        <path d="M10,21.236,6.755,14.745.264,11.5,6.755,8.255,10,1.764l3.245,6.491L19.736,11.5l-6.491,3.245ZM18,21l1.5,3L21,21l3-1.5L21,18l-1.5-3L18,18l-3,1.5ZM19.333,4.667,20.5,7l1.167-2.333L24,3.5,21.667,2.333,20.5,0,19.333,2.333,17,3.5Z"></path>
    </svg>
</button>
   



<style>
  /* Modale */
      .modal, .modal2{
      display: none;
      position: fixed;
      z-index: 999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
      position: relative;
      background-color: #fff;
      margin: 5% auto;
      padding: 0;
      width: 80%;
      height: 80%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      }

      .modal-header {
      padding: 10px;
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .modal-body {
      flex: 1;
      overflow: hidden;
      }

      .modal iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .modal2 iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .close-btn {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      }
</style>

@if (Model.Categorie=="Imagerie Médicale")
  {
      <!-- Modal -->
        <div id="pdfModal" class="modal">
          <div class="modal-content">
            <div class="modal-header">
            <span>📄 Détails Résultat @Model.NomPatient </span>
            <button class="close-btn" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
            <iframe id="target" src=""></iframe> <!-- Remplace par ton PDF -->
            </div>
          </div>
        </div>
  }else{
    @if(Model.valide_par!=null || Model.Nom=="HP AG" ){
      <!-- Modal -->
      <div id="pdfModal" class="modal">
        <div class="modal-content">
          <div class="modal-header">
          <span>📄 Détails Résultat @Model.NomPatient </span>
          <button class="close-btn" onclick="closeModal()">&times;</button>
          </div>
          <div class="modal-body">
          <iframe id="target" src=""></iframe> <!-- Remplace par ton PDF -->
          </div>
        </div>
      </div>
    }
   
  }




<script>
    const modal = document.getElementById('pdfModal');

    function closeModal() {
      modal.style.display = 'none';
      document.getElementById("target").setAttribute("src", "");
    }

    // Fermer si on clique en dehors du contenu
    window.onclick = event => {
      if (event.target === modal) {
        closeModal();
      }
    };
</script>
