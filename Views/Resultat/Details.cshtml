                        <i class="fa fa-previous"></i>Viewer</button>
                    <button class="btn btn-outline-secondary" onclick="location.href='/Resultat/Couverture/@Model.Id';">
                        <i class="fa fa-previous"></i>Couverture</button>
                    <button type="button" class="btn btn-outline-secondary" id="actualiser_resultat" title="Actualiser le patient">
