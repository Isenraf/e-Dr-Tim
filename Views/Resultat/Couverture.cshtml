@model BANA.Models.Resultat

@{
    ViewData["Title"] = "Details";
}







<style>
  .card{
    @* min-height: 40cm; *@
    @* background-image: url('/img1/trans1.png'); *@
    background-repeat: no-repeat;
		background-position-x: center;
    background-position-y: 13cm;
  }


.main {
  font-family: "Manrope", sans-serif;
  background: #ffffff;
  width: 100%;
 
  position: relative;
 
}
* {
  box-sizing: border-box;
  list-style: none;
  margin: 0;
  padding: 0;
  transition: all ease 0.2s;
}
.container {
  max-width: 840px;
  width: 100%;
  padding-right: var(--bs-gutter-x, 0.75rem);
  padding-left: var(--bs-gutter-x, 0.75rem);
  margin-right: auto;
  margin-left: auto;
  position: relative;
}
.page-hed {
  background: #00a852;
  border-radius: 8px;
  padding: 20px 30px;
}
.page-hed h4 {
  color: #bdffdd;
  font-weight: 400;
  font-size: 32px;
  line-height: 44px;
}
.page-hed h1 {
  color: #ffffff;
  font-weight: 800;
  @* font-size: 48px; *@
  @* line-height: 66px; *@
}
.patient-card {
  padding-top: 60px;
  display: inline-flex;
}
.patient-img {
  margin-right: 36px;
}
.patient-cont {
  background: #e8f0ff;
  border-radius: 8px;
  padding: 20px;
}
.patient-cont h5 {
  color: #00a852;
  font-weight: 700;
  font-size: 22px;
  line-height: 30px;
  margin-bottom: 20px;
}
.patient-cont ul {
  margin: 0px;
  padding: 0px;
  display: flex;
}
.patient-cont li {
  padding-right: 23px;
  display: flex;
}
.patient-cont li svg {
  margin-right: 10px;
}
.patient-cont li p {
  color: #000000;
  font-weight: 400;
  font-size: 16px;
  line-height: 22px;
  flex: 1;
}
.patient-cont li:last-child {
  padding-right: 0px;
}
.patient-cont li:first-child {
  max-width: 280px;
}
.step-card {
  @* padding-top: 80px; *@
}
.step-head {
  margin-bottom: 20px;
}
.step-head h5 {
  color: #00a852;
  font-weight: 700;
  font-size: 22px;
  line-height: 30px;
}
.step-head h5 span {
  width: 42px;
  height: 42px;
  background: #00a852;
  border-radius: 42px;
  color: #ffffff;
  font-weight: 700;
  font-size: 16px;
  line-height: 42px;
  display: inline-block;
  text-align: center;
  margin-right: 10px;
}
.step-in {
  display: inline-flex;
}
.step-cont {
  display: flex;
}
.step-cont-box {
  background: #e8f0ff;
  border-radius: 8px;
  padding: 10px;
  margin-right: 17px;
}
.step-cont-box:last-child {
  margin-right: 25px;
  width: 290px;
}
.step-cont-box h6 {
  color: #000000;
  font-weight: 700;
  font-size: 16px;
  line-height: 22px;
  margin-bottom: 5px;
}
.step-cont-box li {
  color: #000000;
  font-weight: 400;
  font-size: 16px;
  line-height: 30px;
  display: inline-flex;
  width: 100%;
  position: relative;
  padding-left: 20px;
}
.step-cont-box li i {
  width: 30px;
  height: 30px;
  margin-left: 10px;
}
.step-cont-box li::after {
  position: absolute;
  content: "";
  top: 13px;
  left: 6px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: #000;
}
.step-cont-box ul {
  margin-bottom: 23px;
}
.step-cont-box a {
  background: #00a852;
  border-radius: 8px;
  display: inline-block;
  padding: 10px 10px;
  color: #ffffff;
  text-decoration: none;
  font-weight: 700;
  font-size: 15px;
  line-height: 20px;
}
.step-cont-box a i {
  width: 24px;
  height: 24px;
  background: #00a852;
  border-radius: 24px;
  display: inline-block;
  text-align: center;
  line-height: 24px;
  margin-left: 9px;
}
.step-cont-box a:hover,
.step-cont-box a.toggle-fix {
  background: #ed4875;
  box-shadow: 0px 12px 24px rgb(209 50 93 / 40%);
}
.step-cont-box a i svg {
  top: 1px;
  position: relative;
}
.step-cont-box a:hover i,
.step-cont-box a.toggle-fix i {
  background: #fff;
  transition: 0.2s;
  transform: rotateZ(45deg);
}
.step-cont-box a:hover i svg path,
.step-cont-box a.toggle-fix i svg path {
  stroke: #00a852;
}
.popuo-card {
  width: 318px;
  background: #ffebf0;
  box-shadow: 0px 12px 24px rgb(208 126 148 / 40%);
  border-radius: 8px;
  padding: 12px 12px 12px 7px;
  position: absolute;
  z-index: 9;
}
.show-popup {
  display: none;
}
.popuo-card ul {
  margin-bottom: 0;
}
.popuo-card li {
  display: inline-block;
  font-weight: 400;
  font-size: 14px;
  line-height: 19px;
  color: #000000;
  margin-bottom: 7px;
}
.popuo-card li:last-child {
  margin-bottom: 0px;
}
.popuo-card li::after {
  top: 8px;
}
.step-img {
  margin-top: 10px;
}
.step1 .step-cont .step-cont-box:last-child .popuo-card {
  width: 230px;
}
.step-card.step2 {
  padding-top: 76px;
}
.step-card.step2 .step-img {
  margin-top: 0;
}
.step-card.step2 .step-head .step-cont-box {
  padding: 0;
  margin: 0;
  width: 260px;
  background: transparent;
}
.step-card.step2 .step-head {
  display: inline-flex;
  width: 100%;
  -webkit-box-pack: justify;
  -ms-flex-pack: justify;
  justify-content: space-between;
}
.popuo-card h6 {
  font-weight: 700;
  font-size: 14px;
  line-height: 19px;
  color: #000000;
}
.step-card.step2 .popuo-card {
  width: 250px;
}
.step2-cont-box {
  width: 280px;
}
.step2-cont-box .step-cont-box {
  margin-right: 0;
  width: 100%;
}
.polygon-icon {
  text-align: center;
  padding: 5px 0;
}
.title-btn {
  background: #aac7ff;
  border-radius: 6px;
  padding: 10px;
  text-align: center;
  width: 100%;
  margin-bottom: 6px;
}
.title-btn h5 {
  color: #000000;
  font-weight: 700;
  font-size: 16px;
  line-height: 22px;
}
.dived-card {
  display: flex;
  width: 100%;
}
.dived-card-in {
  flex: 1;
  text-align: center;
}
.dived-card-in p {
  color: #000000;
  font-weight: 400;
  font-size: 16px;
  line-height: 22px;
}
.dived-card-in svg {
  margin: 12px 0 5px 0;
}
.step2-in {
  margin-left: 25px;
  margin-top: 15px;
}
.step2-cont-box .step-cont-box ul {
  margin-bottom: 14px;
}
.step-card.step3 {
  padding-top: 90px;
  padding-left: 70px;
}
.step-card.step3 .step-cont {
  flex: 1;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -ms-flex-direction: column;
  flex-direction: column;
  min-width: 478px;
}
.step-card.step3 .step-cont .step-cont-box {
  margin: 0 0 13px 0;
  padding: 20px 20px 11px 20px;
}
.step-card.step3 .step-cont .step-cont-box:last-child {
  padding: 0;
  background: transparent;
  width: 100%;
}
.step-card.step3 .step-img {
  margin: 0;
  min-width: 255px;
  text-align: center;
}
.step-card.step3 .step-cont .title-btn {
  margin-bottom: 12px;
}
.step-card.step3 .popuo-card {
  width: 840px;
}
.popuo-divider {
  display: flex;
}
.popuo-card-divider {
  border-right: 1px solid #ffb3cb;
  flex: 1;
  padding-right: 10px;
  margin-right: 10px;
}
.popuo-card-divider:last-child {
  border-right: 0px;
  padding-right: 0px;
  margin-right: 0px;
}
.step-border {
  position: absolute;
  bottom: 170px;
  left: 0;
  width: 100%;
  text-align: center;
}
.step-border svg {
  width: 680px;
}

</style>



