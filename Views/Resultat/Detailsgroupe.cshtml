        <div class="modal fade" id="AddOrder" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title h4" id="myLargeModalLabel">Choisir l'ordre d'impression</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row clearfix">
                          @foreach(var item in ViewBag.resultats){
                            <div class="col-sm-12">
                                <div class="form-group">
                                <input  type="text"  list="resultats" class="form-control orderprint" placeholder="Examens">
                                </div>
                            </div>
                          }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-round btn-primary" id="enregistrer_ordre">
                              <i class="fa fa-save"></i> Enregistrer</button>
                            </button>
                        
                        <button type="button" class="btn btn-round btn-default" data-dismiss="modal">Fermer</button>
                    </div>
                    </div>
            </div>
        </div>


        <div class="modal fade" id="AddDepartments" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title h4" id="myLargeModalLabel">Valider le Résultat</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row clearfix">

                        <div class="col-sm-12">
                            <div class="form-group">
                            <select id="result"  class="form-control show-tick">
                              <option  value="">- Selectionner Resultat -</option>
                              <option  value="Positif">Positif</option>
                              <option  value="Négatif">Négatif</option>
                              <option  value="Autre">Autre</option>
                            </select>
                          </div>
                        </div>

                        </div>
                       
                    </div>
                    <div class="modal-footer">
                        <button style="display: none;" type="button" id="valider_result" class="btn  btn-primary">
                              <i class="fa fa-save"></i> Enregistrer</button>
                        <button type="button"  class="btn btn-round btn-default" data-dismiss="modal">Fermer</button>
                    </div>
                    </div>
            </div>
        </div>
        <input id="numfact" type="hidden" value="@Model.NumeroFacture">
        @if (Model.valide_par==null)
          {
        <a id="editbt" style="position: fixed;right: 50px;bottom: 45px;" asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-edit"></i></a>
          }
        <input type="hidden" asp-for="Id" id="identifiant_result" />
        @if(Model.Nom.Contains("NFS")){
          Console.WriteLine(Model.Nom);
          <input type="hidden" value="NFS" id="terg" />
        }else{
          <input type="hidden" value="###" id="terg" />
        }
        <datalist id="resultats">
          @foreach(var item in ViewBag.resultats){
            <option  value="@item.Nom"></option>
          }
      </datalist>
