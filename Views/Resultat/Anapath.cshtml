@model IEnumerable<BANA.Models.Resultat>

@{
    ViewData["Title"] = "Index";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Résultats Anapath
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                
                <div class="card-header">
                  
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      
                      <span><h6>Résultats Anapath</h6></span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-success">Total Modèles</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1"><span class="separateur">@ViewData["Anapath"]</span></span>
                      <span class="text-danger">Anapath</span>
                    </div>
                   
                    
                  </div>
                </div>

                <div class="card-body">
                  <!-- barre de recherche start-->
                  <div class="card">
                    <form asp-controller="Resultat" asp-action="Anapath"  method="get">
                      <div class="card-body">
                      <input id="search" type="search" name="SearchString" class="form-control" placeholder="Bare de Recherche" />
                    </div>
                    </form>
                  </div>
                  <!-- barre de recheche end -->

                  <div class="table-outer">
                    <div class="table-responsive">
                      <table class="table truncate m-0">
                        <thead>
                          <tr>
                            <th><strong>Nomination</strong></th>
                            <th><strong>Patient</strong></th>
                            <th><strong>Date Creation</strong></th>
                            <th><strong>Nº Facture</strong></th>
                            <th><strong>Status</strong></th>
                            <th><strong>Actions</strong></th>
                          </tr>
                        </thead>

                        <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                            <tr class="montest">
                              <td>
                                  <div class="d-flex align-items-center">
                                    @if(item.Categorie=="Imagerie Médicale"){
                                      <img src="/template2/assets/images/imageri.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="afficher le modèle"/>
                                    }else{
                                      <img src="/template2/assets/images/examen.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="afficher le modèle"/>
                                    }
                                    
                                    <div class="ml-3">
                                    <a asp-action="Details" asp-route-Id="@item.Id" title="">@item.Nom</a>
                                      
                                      <p style="max-width: 300px; overflow: hidden" class="mb-0">
                                        Numéro dossier: @item.NumeroDossier
                                      </p>
                                    </div>
                                  </div>
                                </td>
                                <td><div style="max-width: 200px;overflow: hidden;">@item.NomPatient</div></td>
                                <td>@item.Create_date.ToString("dd/MM/yyyy") @item.Create_date.ToShortTimeString()</td>
                                <td>@item.NumeroFacture</td>
                                <td>@if (item.valide_par!=null){<span class="badge border border-success text-success">Cloturé</span>}else{<span class="badge border border-warning text-warning">En cours</span>}</td>
                                <td> @if (item.valide_par==null || ViewBag.user.nom=="DR NGOUNGOURE"){
                                  <button type="button" onclick="location.href='/Resultat/Edit3/@item.Id';" class="btn btn-outline-secondary" title="Edit">
                                  <i class="fa fa-pencil"></i></button>}
                                  <button onclick="location.href='/Resultat/Details/@item.Id';" type="button" class="btn btn-outline-secondary " title="Voir">
                                    <i class="fa fa-eye"></i>
                                  </button>
                                </td>
                            </tr>
                          }

                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- app body end-->


      