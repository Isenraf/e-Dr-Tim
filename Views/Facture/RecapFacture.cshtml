@model IEnumerable<BANA.Models.Facture>
@{
  ViewData["Title"] = "Recap des factures";
  int i=1;
  int somme1=0;
  int somme2=0;
  int somme3=0;
  int somme4=0;
  int somme5=0;
  int somme6=0;
}



<link rel="stylesheet"  href="/css/select2.min.css">
<link rel="stylesheet" media="print" href="/css/print_hono.css">
<link rel="stylesheet"  href="/css/select2.css">

<style>
  table{
    border-collapse: collapse;
  }
  table tr td
  { 
    page-break-inside:avoid;
    border: 1px solid #ccc;
  }
</style>

   <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Recap des factures
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card py-3 px-3">
              <div class="d-flex align-items-center justify-content-between mt-2 gy-3">
                <h5 class="card-title">Polyclinique de Poitiers<br /><span style="font-size: 12px; color: #4c545e">Recap des factures</span>
                </h5>

                <div class="d-flex flex-wrap gap-1">
                  <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                    <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                    <span class="me-1 fw-semibold ps-1">@ViewBag.nf</span>
                    <span class="text-success">Nombre de factures</span>
                  </div>
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                    <span class="me-1 fw-semibold ps-1"><span class="separateur">@ViewBag.mt</span> FCFA</span>
                    <span class="text-danger">Montant total</span>
                  </div>
                </div>
              </div>
              <br />
             
             <form asp-action="RecapFacture" method="get" >

                      <div class="container">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="content">
                                  @{
                                    List<string> listedesassurances = new();
                                      @foreach(var item in ViewBag.select){
                                        listedesassurances.Add(item.Replace(" ",""));
                                      }

                                  }
                                  
                                    <div class="row">
                                        <div class="col-md-6"><label>Sélectionnez les médécins</label></div>
                                        <div style="text-align: right;" class="col-md-6"><label>Select All</label><input id="checkbox" type="checkbox" /></div>
                                    </div>
                                  <select name="assurances" class="js-select2-multi" multiple="multiple">
                                    @foreach(var item in ViewBag.assurance){
                                        if(listedesassurances.Contains(item.Replace(" ",""))){
                                          <option selected>@item</option>
                                        }else{
                                          <option>@item</option>
                                        }
                                    }
                                  </select>
                                </div>   
                              </div>
                            </div><br>
                            
                            <div class="body">
                              
                                <div class="row g-3">
                                  <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                      <div style="border: 1px solid #ffffff;" class="form-control">
                                        <label class="form-label" for="a2"
                                          >Date de début
                                          <span class="text-danger">*</span></label
                                        >
                                        <input
                                          type="datetime-local"
                                          class="form-control"
                                           name="datedebut"  value="@ViewData["debut"]"
                                          style="height: 50px; border: #c3dff1"
                                        />
                                      </div>
                                    </div>
                                  </div>
                                  <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                      <div style="border: 1px solid #ffffff;" class="form-control">
                                        <label class="form-label" for="a2"
                                          >Date de fin</label
                                        >
                                        <input
                                          type="datetime-local"
                                          class="form-control"
                                          name="datefin"  value="@ViewData["fin"]"
                                          style="height: 50px; border: #c3dff1"
                                        />
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              
                              <div>
                                <div style="display: flex; gap: 10px">
                                  <button type="submit" class="btn btn-info">
                                    <i class="ri-save-3-line"></i> Enregistrer
                                  </button>
                                </div>
                              </div>  
                        </form><br>

                          <div style="margin-bottom: 20px;" class="d-flex align-items-center justify-content-between  gy-3">
                            <h5 class="card-title"><br /><h7 style="font-size: 12px; color: #4c545e"></h7>
                            </h5>

                            <div class="d-flex flex-wrap gap-1">
                              
                                <button type="button" class="btn btn-success" id="printButton" onclick="window.print()">
                                  <i class="ri-printer-line"></i> Print
                                </button>
                              
                              
                                <button type="button" class="btn btn-outline-primary" id="masquerdetails">
                                    Masquer details
                                  </button>
                              
                            </div>
                          </div>

                          

                  <div>
                    
                   
                  </div>
                  <div >
                  <div class="table-responsive" >
                          <table id="printMe"  style="text-transform: uppercase;color: black; width: 100%;padding: 0rem;font-size: 9px;white-space: nowrap;">
                          <tr>
                            <td style="border: 1px solid; text-align: center;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="14"><strong class=""> <h6 style="margin: 5px;"><span>Recap des factures Du   @ViewBag.date1 au  @ViewBag.date2,</span></h6> </strong></td>
                          </tr>
                          <th style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong>Nº</strong></th>
                            <th style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong>Date</strong></th>
                              <th class="text-center" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;"><strong>Nºfacure</strong></th>
                              <th class="text-left" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: right;width: 290px;"><strong>Assureur</strong></th>
                              <th class="text-left" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;width: 290px;"><strong>Société</strong></th>
                              <th class="hidden-sm-down" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: right;"><strong>Matricule Assureur</strong></th>
                              <th class="hidden-sm-down" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;"><strong>Matricule malade</strong></th>
                              <th class="hidden-sm-down" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: right;width: 290px;"><strong>Patient</strong></th>
                              <th class="hidden-sm-down" style="color: black;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;text-align: right;width: 100px;"><strong>Montant Brut</strong></th>
                              <th style="color: black;border: 1px solid; text-align: right; padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;width: 100px;"><strong>TICKET MOD</strong></th>
                              <th style="color: black;border: 1px solid; text-align: right; padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;width: 40px;"><strong>COMPL</strong></th>
                              <th style="color: black;border: 1px solid; text-align: right; padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;width: 30px;"><strong>Réduction</strong></th>
                              <th style="color: black;border: 1px solid; text-align: right; padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;width: 40px;"><strong>Taxe IR</strong></th>
                               <th style="color: black;border: 1px solid; text-align: right; padding: 0rem 0.3rem 0rem 0.3rem;text-align: center;width: 100px;"><strong>Net à PAYER</strong></th>
                            </tr>
                              @foreach(var item in Model){
                                <tr class="table1" style="font-weight: 600;color: black;;padding: 0rem 0.3rem 0rem 0.3rem;">
                                  <td class="text-center" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><span>@i</span></td>
                                    <td style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><span>@item.Derniere_modification.ToShortDateString()</span></td>
                                    <td  class="text-center" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><span>@item.Numero_de_facture</span></td>
                                    <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;">@item.Assureur</td>
                                    <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.Societe</td>
                                    <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.MatriculeADH</td>
                                    <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.Matricule_patient</td>
                                    <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.Nom</td>
                                    <td class="text-right separateur" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.Total_ht</td>
                                    <td class="text-right separateur" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.ticketmoderateur</td>
                                    <td class="text-right separateur" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@(item.Net_a_payer_patient+item.Remise-item.ticketmoderateur)</td>
                                    <td class="text-right separateur" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@item.Remise</td>
                                    <td class="text-right separateur" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@((int)((item.Total_ht-item.Net_a_payer_patient-item.Remise)*item.Taxe1*0.01))</td>
                                    <td class="text-right separateur" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" >@((int)((item.Total_ht-item.Net_a_payer_patient-item.Remise)+(item.Total_ht-item.Net_a_payer_patient-item.Remise)*item.Taxe1*0.01))</td>
                                  </tr>
                                  i++;

                                  
                                  somme1+=item.Total_ht;
                                  somme2+=item.ticketmoderateur;
                                  somme3+=(item.Net_a_payer_patient+item.Remise-item.ticketmoderateur);
                                  somme4+=item.Remise;
                                  somme5+=(int)((item.Total_ht-item.Net_a_payer_patient-item.Remise)*item.Taxe1*0.01);
                                  somme6+=(int)((item.Total_ht-item.Net_a_payer_patient-item.Remise)+(item.Total_ht-item.Net_a_payer_patient-item.Remise)*item.Taxe1*0.01);
                              }

                              <tr class="table1" style="font-weight: 600;color: black;;padding: 0rem 0.3rem 0rem 0.3rem;">
                                <td class="text-center" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><span></span></td>
                                  <td style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><span></span></td>
                                  <td  class="text-center" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><span></span></td>
                                  <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"></td>
                                  <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ></td>
                                  <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ></td>
                                  <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ></td>
                                  <td class="text-left" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ></td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ><strong class="separateur">@somme1</strong></td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ><strong class="separateur">@somme2</strong></td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ><strong class="separateur">@somme3</strong></td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ><strong class="separateur">@somme4</strong></td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ><strong class="separateur">@somme5</strong></td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" ><strong class="separateur">@somme6</strong></td>
                                </tr>
                          </div>   
                          </tfoot>
                        </table>
                        
                        
                        
                        <br>
                        <table style="width: 100%;color: black;" >
                          <td style="font-weight: 600;text-align: left;border: 0px;"><u><strong>Signatures Sécrétariat</strong></u></td>
                          <td style="font-weight: 600;text-align: left;border: 0px;"><u><strong>Comptabilité</strong></u></td>
                        </table>
                        </div>  
                       
                        <br><br>
                    
                  </div>
                  
                </div>
                <!-- App body ends -->
              </div>
            </div>
          </div>


<a  style="color: white;position: fixed;right: 50px;bottom: 45px;" onclick="ExportToExcel('xlsx')" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-file-excel-o"></i></a>
 
 <script type="text/javascript" src="/lib/xlsx.full.min.js"></script>
<script>
  function ExportToExcel(type, fn, dl) {
       var elt = document.getElementById('printMe');
       var wb = XLSX.utils.table_to_book(elt, { sheet: "Feuille1" });
       return dl ?
         XLSX.write(wb, { bookType: type, bookSST: true, type: 'base64' }):
         XLSX.writeFile(wb, fn || ('RECAP FACTURE.' + (type || 'xlsx')));
    }
</script>
        

