                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> Exonérée </strong></td>
                            </tr>
                            @if (Model.Taxe1>0)
                            {
                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="3" class="text-right">
                                <span>Taxe @Model.Taxe1 %</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class="separateur">@(Model.Net_a_payer_assurance+Model.Net_a_payer_patient+Model.Remise-((int)((Model.Net_a_payer_assurance)/(1+Model.Taxe1*0.01))+Model.Net_a_payer_patient+Model.Remise))</strong></td>
                            </tr>

                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="3" class="text-right">
                                <span>Base Imposable:</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class="separateur">@((int)((Model.Net_a_payer_assurance)/(1+Model.Taxe1*0.01)))</strong></td>
                            </tr>
                            }
                             <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                <span>TOTAl TTC:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> <span class="separateur">@Model.Total_ht</span> FCFA</strong></td>
                            </tr>
                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                <span>Ticket Modérateur:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@Model.ticketmoderateur</span> FCFA</strong></td>
                            </tr>
                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                <span>Complément patient:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient-Model.ticketmoderateur)</span> FCFA</strong></td>
                            </tr>
                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                <span>Net à Payer Patient:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient)</span> FCFA</strong></td>
                            </tr>

                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="3" class="text-right">
                                <span>Net à Payer Assurance:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> <span class="separateur">@Model.Net_a_payer_assurance</span> FCFA</strong></td>
                            </tr>

