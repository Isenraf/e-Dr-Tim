                    <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                    <span class="me-1 fw-semibold ps-1">@Model.Net_a_payer_patient</span>
                    <span class="text-success">Montant Total</span>
                  </div>
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                    <span class="me-1 fw-semibold ps-1"><span class="separateur">@Model.Montant_recu_patient</span> FCFA</span>
                    <span class="text-success">Montant Payé</span>
                  </div>

                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                    <span class="me-1 fw-semibold ps-1"><span class="separateur">@(Model.Net_a_payer_patient-Model.Montant_recu_patient)</span> FCFA</span>
                    <span class="text-danger">Reste à Payer</span>
                  </div>
                </div>
              </div>
              <br />
             

             
            

