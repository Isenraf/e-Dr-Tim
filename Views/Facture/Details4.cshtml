@model BANA.Models.Facture

@{
    ViewData["Title"] = "Facture - "+ @Model.Nom + @Model.Prenom;
    int st=0;
    int imprimeur=0;
}

<input  type="hidden" id="target" asp-for="Type">
<input  type="hidden" id="lf1" asp-for="Ligne_facturation1">
<input  type="hidden" id="lf2" asp-for="Ligne_facturation2">
<input  type="hidden" id="lf3" asp-for="Ligne_facturation3">
<input  type="hidden" id="lf4" asp-for="Ligne_facturation4">
<link rel="stylesheet" media="print" href="/css/print.css">
<!-- App container starts -->
<div class="app-container">
  <!-- App hero header starts -->
  <div class="app-hero-header d-flex align-items-center">
    <!-- Breadcrumb starts -->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
        <a asp-action="Index" asp-controller="Departement">Acceuil</a>
      </li>
      <li class="breadcrumb-item text-primary" aria-current="page">
         Facture assurance
      </li>
    </ol>
    <!-- Breadcrumb ends -->
  </div>
  <!-- App Hero header ends -->



  <!-- App body start -->
  <div class="app-body">

    <div  style="margin-bottom: 20px;background-color: #126aef12;padding: 10px;border-radius: 10px;text-align: right;" class="">
        <div class="">
          @if(Model.Type.Contains("proforma")){
            <button class="btn btn-warning  gradient" onclick="location.href='/Facture/transform2/@Model.Id';"  >
                        <i class="fa fa-check"></i> Transformer en facture</button>
          }
            <button class="btn btn-primary theme-bg gradient" id="f1"  onclick="location.href='/Facture/Details/@Model.Id';">
                      Facture Patient</button>
            <button class="btn btn-outline-secondary" id="closeButton"  onclick="location.href='/Facture/Index2';">
              <i class="fa fa-previous"></i> Fermer</button>

           
            </button>
            @if (Model.Etat_patient!="Cloturé" && Model.Intervenant=="" && Model.Ligne_facturation2!="λ" && (Model.Type=="examens_assurance" || Model.Type=="generique_assurance" ))
            {
              <button class="btn btn-danger  gradient" id="genererexamens" >
                <i class="fa fa-check"></i> Générer les résultats</button>
            }
            
            @if (Model.Etat_patient=="Cloturé" && Model.Net_a_payer_patient==0 && ViewBag.user.Type_de_compte=="administrateur")
            {
              <button class="btn btn-warning  gradient" id="decloturer" >
                <i class="fa fa-check"></i> Décloturer</button>
            }
              <button class="btn btn-primary theme-bg gradient" id="printfact">
                      <i class="fa fa-print"></i> Print</button>

            
            <button type="button" class="btn btn-outline-secondary" title="Send Invoice">
              <i class="fa fa-envelope"></i>
            </button>

        </div>
      </div>



    <div class="col-sm-12">

          <div class="row clearfix">
            
            <div class="col-lg-12">
              <div id="tdt1" class="card card2" style="min-height: 40cm;">
               @if(!Model.Type.Contains("dentiste")){
                   <img style="float: right;" id="img1" src="/img1/pppp.jpg" width="100%" data-toggle="tooltip" data-placement="top" title="" alt="Polyclinique de Poitiers"  data-original-title="Polyclinique de Poitiers">
                }else{
                   <img style="float: right;" id="img1" src="/img1/00pppp.jpg" width="100%" data-toggle="tooltip" data-placement="top" title="" alt="Cabinet dentaite"  data-original-title="Cabinet dentaite"><br><br>
                }
                <div style="padding: 15px;margin-top: -125%;min-height: 32cm;"  id="printMe" class="body" >
                  <br> <br>
                  <div class="row clearfix">
                    <div class="col-md-12">
                      <table style="text-transform: uppercase;width: 100%;color: black;" >
                        <tr>
                          @if(Model.Type.Contains("proforma")){
                          <th style="width: 140px; border: 1px solid;color: black;" >Proforma Nº: </th>
                          }else{
                            <th style="width: 140px; border: 1px solid;color: black;" >Facture Nº: </th>
                          }
                          <td style="font-weight: 600;width: 300px; border: 1px solid;" >FA_@(Model.Numero_de_facture)</td>
                          <td style="width: 100px;"></td>
                          <td rowspan="8" style="width: 400px; border: 1px solid; color: black;padding: 0rem 0.3rem 0rem 0.3rem;" ><h4 style="margin:0;" >@Model.Assureur</h4>
                          @Model.Assur_NIU <br>@Model.Assur_Rc <br>@Model.Assur_BP <br> @Model.Assur_Tel  <br>@Model.Assur_Adresse
                          </td>
                        </tr>
                        <tr>
                          <th style=" border: 1px solid;color: black;">Assuré Prin: </th>
                          <td style="font-weight: 600;border: 1px solid;" >@Model.assure_prin</td>
                          
                          @* <td style="border-left: 1px solid;border-right: 1px solid;color: black;">@Model.Assur_NIU</td> *@
                        </tr>
                        <tr>
                          <th style=" border: 1px solid;color: black;">Bénéficiaire: </th>
                          <td style="font-weight: 600;border: 1px solid;" >@Model.Nom @Model.Prenom</td>
                          
                          @* <td style="border-left: 1px solid;border-right: 1px solid;color: black;">@Model.Assur_Rc</td> *@
                        </tr>
                        <tr>
                          <th style=" border: 1px solid;color: black;">SOCIÉTÉ: </th>
                          <td style="font-weight: 600;border: 1px solid;" >@Model.Societe</td>
                          
                          @* <td style="border-left: 1px solid;border-right: 1px solid;color: black;">@Model.Assur_BP</td> *@
                        </tr>
                        @if (Model.Date_entree!=null)
                        {
                          <tr>
                            <th style=" border: 1px solid;color: black;">DATE D'ENTRÉE: </th>
                            <td style="font-weight: 600;border: 1px solid;" >@DateTime.Parse(Model.Date_entree.ToString()).Day/@DateTime.Parse(Model.Date_entree.ToString()).Month/@DateTime.Parse(Model.Date_entree.ToString()).Year</td>
                            <td></td>
                          </tr>
                        }
                         
                        @if (Model.Date_sortie!=null)
                        {
                          <tr>
                            <th style=" border: 1px solid;color: black;">DATE DE SORTIE: </th>
                            <td style="font-weight: 600;border: 1px solid;" >@DateTime.Parse(Model.Date_sortie.ToString()).Day/@DateTime.Parse(Model.Date_sortie.ToString()).Month/@DateTime.Parse(Model.Date_sortie.ToString()).Year</td>
                            <td></td>
                          </tr> 
                        }
                        
                      </table>
                      <small style="font-weight: 600;color: black;">MAT PATIENT: @Model.Matricule_patient &emsp;&emsp;&emsp;&emsp;   MAT ADH: @Model.MatriculeADH &emsp;&emsp;&emsp; Nº DOSSIER: @Model.Numero_dossier  &emsp;&emsp;&emsp;&emsp;&emsp;&emsp; &emsp;&emsp;&emsp; Date: @Model.Create_date</small>
                    </div>
                 
                  </div>
