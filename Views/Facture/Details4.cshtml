                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.ticketmoderateur)</span> FCFA</strong></td>
                            </tr>
                            
                            }
                            @if((Model.Net_a_payer_patient+Model.Remise-Model.ticketmoderateur)>0){
                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                  <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                  <span>Complément patient:&nbsp;&nbsp;</span>
                                  </td>
                                  <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient+Model.Remise-Model.ticketmoderateur)</span> FCFA</strong></td>
                              </tr>
                            }
                            

                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                <span>Net à Payer Patient:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient+Model.Remise)</span> FCFA</strong></td>
                            </tr>

                            @if (Model.Taxe1>0 || Model.Taxe1<0)
                            {
                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="3" class="text-right">
                                <span>Base Imposable:</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class="separateur">@((int)(Model.Total_ht-Model.Net_a_payer_patient-Model.Remise))</strong></td>
                            </tr>

                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="3" class="text-right">
                                <span>Taxe @Model.Taxe1 %</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class="separateur">@((int)((Model.Total_ht-Model.Net_a_payer_patient-Model.Remise)*Model.Taxe1*0.01))</strong></td>
                            </tr>

                              
                            }
                             <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="3" class="text-right">
                                <span>TOTAl TTC:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> <span class="separateur">@(Model.Net_a_payer_assurance+Model.Net_a_payer_patient+Model.Remise)</span> FCFA</strong></td>
                            </tr>
                            
                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                               
                                <td style="font-weight: 600;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="3" class="text-right">
                                <span>Net à Payer Assurance:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> <span class="separateur">@((int)((Model.Total_ht-Model.Net_a_payer_patient-Model.Remise)+(Model.Total_ht-Model.Net_a_payer_patient-Model.Remise)*Model.Taxe1*0.01))</span> FCFA</strong></td>
                            </tr>

                          </tfoot>
                        </table>
                        <br>
                        <table style="width: 100%;color: black;" >
                          <td style="font-weight: 600;text-align: left;"><u><strong>Signature de l'assuré(e)</strong></u></td>
                          <td style="font-weight: 600;text-align: right;"><u><strong>La Direction</strong></u></td>
                        </table>
                       
                      </div>
                    </div>
                  </div>
                  <div class="row clearfix">
                    <div class="col-md-6">
                      <span>
                        <input  id="text" type="text" value="https://www.polycliniquedepoitiers.com/Resultat/Create" style="display: none;" />
                    </div>
                   
                  </div>
                </div>
              </div>
            </div>
          </div>

           <input type="hidden" asp-for="Id" id="identifiant_fact" />
          <input type="hidden" asp-for="Numero_dossier" id="numerodossier" />
          <input type="hidden" asp-for="Nom" id="nom" />
          <input type="hidden" asp-for="Prenom" id="prenom"  />
          <input type="hidden" asp-for="Numero_de_facture" id="numerofacture"  />



          
            
          </div>
        </div>
      </div>
      <!-- App body end -->


      @if(Model.Type.Contains("assurance")){
          <a style="position: fixed;right: 50px;bottom: 45px;" asp-action="Edit2" asp-route-Id="@Model.Id" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-edit"></i></a>

        }else{
           <a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-edit"></i></a>
        }


      <style>
        /* Modale */
        .modal, .modal2{
        display: none;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: rgba(0, 0, 0, 0.6);
        }

        .modal-content {
        position: relative;
        background-color: #fff;
        margin: 5% auto;
        padding: 0;
        width: 80%;
        height: 80%;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        }

        .modal-header {
        padding: 10px;
        background: #f5f5f5;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
        }

        .modal-body {
        flex: 1;
        overflow: hidden;
        }

        .modal iframe {
        width: 100%;
        height: 100%;
        border: none;
        }

        .modal2 iframe {
        width: 100%;
        height: 100%;
        border: none;
        }

        .close-btn {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        }
</style>

      <!-- Modal -->
        <div id="pdfModal" class="modal">
          <div class="modal-content">
            <div class="modal-header">
            <span>📄 Détails Facture </span>
            <button class="close-btn" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
            <iframe id="target" src="/Facture/PdfAssur/@Model.Id?target=assurance#navpanes=0"></iframe> <!-- Remplace par ton PDF -->
            </div>
          </div>
        </div>


        <script>
          const modal = document.getElementById('pdfModal');

          function closeModal() {
            modal.style.display = 'none';
            document.getElementById("target").setAttribute("src", "");
          }

          // Fermer si on clique en dehors du contenu
          window.onclick = event => {
            if (event.target === modal) {
              closeModal();
            }
          };
      </script>
   