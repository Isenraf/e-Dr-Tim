@model IEnumerable<BANA.Models.Facture>

@{
    ViewData["Title"] = "Index";
    int x=1;
}

<link rel="stylesheet" href="/template2/table/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/buttons.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/style.css" />
<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Comptabilité Factures Patient
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card mb-3 px-2">
              <div
                class="card-header d-flex align-items-center justify-content-between"
              >
                <h5 class="card-title">
                  Polyclinique de Poitiers<br /><h7
                    style="font-size: 12px; color: #4c545e"
                    >Factures Patient</h7
                  >
                </h5>
              </div>
              <br />

              <div class="row gx-3 gy-3">
                <div class="row gx-3">
                 
                 
                    <div  id="containerexample" >
                    <table id="example" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                      <thead class="">
                        <tr>
                          <th style="border: solid;white-space: nowrap;">Id</th>
                          <th style="border: solid;white-space: nowrap;">Nº Facture</th>
                          <th style="border: solid;white-space: nowrap;">Patient</th>
                          <th style="border: solid;white-space: nowrap;">Net à payer Patient</th>
                          <th style="border: solid;white-space: nowrap;">Montant Payé</th>
                          <th style="border: solid;white-space: nowrap;">Reste à Payer</th>
                          <th style="border: solid;white-space: nowrap;">Remise</th>
                          <th style="border: solid;white-space: nowrap;">Type</th>
                          <th style="border: solid;white-space: nowrap;">Observation</th>
                          <th style="border: solid;white-space: nowrap;">Status</th>
                          <th style="border: solid;white-space: nowrap;">Date</th>
                          <th style="border: solid;white-space: nowrap;">Chiffre d'affaire</th>
                        </tr>
                      </thead>
                      <tbody class="table-bordered">
                            @foreach (var item in Model)
                            {
                              <tr>
                                <td style="border: solid;white-space: nowrap;">@x</td>
                                <td style="border: solid;white-space: nowrap;">@item.Numero_de_facture</td>
                                <td style="border: solid;white-space: nowrap;">@item.Nom @item.Prenom</td>
                                <td style="border: solid;white-space: nowrap; text-align:right;">@item.Net_a_payer_patient</td>
                                <td style="border: solid;white-space: nowrap;text-align:right;">@item.Montant_recu_patient</td>
                                <td style="border: solid;white-space: nowrap;text-align:right;">@(item.Net_a_payer_patient-item.Montant_recu_patient)</td>
                                <td style="border: solid;white-space: nowrap;text-align:right;">@item.Remise</td>
                                <td style="border: solid;white-space: nowrap;text-align:right;">@item.Type</td>
                                @if(item.Net_a_payer_assurance>0){
                                  <td style="border: solid;white-space: nowrap;text-align:right;">Ticket moderareur</td>
                                }else{
                                  <td style="border: solid;white-space: nowrap;text-align:right;">Ticket moderareur</td>
                                }
                                <td style="border: solid;white-space: nowrap;text-align:right;">@item.Etat_patient</td>
                                <td style="border: solid;white-space: nowrap;">@item.Create_date.ToShortDateString()</td>
                                <td style="border: solid;white-space: nowrap;">@(item.Net_a_payer_patient+item.Net_a_payer_assurance -item.Remise)</td>
                              </tr>
                              x++;
                            }
                      </tbody>
                    </table>
                    <br />
                    <br />
                  </div>

                 
                </div>
              </div>
              <!-- App body ends -->
            </div>
          </div>

          <div id="loadercontainer">
            <div class="d-flex justify-content-center" id="loader" style="color: #126aef;">
                <div class="spinner-border" role="status">
                  <span class="sr-only">Loading...</span>
                </div>
            </div>
          </div>
        
<input id="username" type="hidden" value="@ViewBag.user.nom" />
