@model BANA.Models.Facture

@{
    ViewData["Title"] = "Edit";
}



<!-- App container starts -->
<div class="app-container">
  <!-- App hero header starts -->
  <div class="app-hero-header d-flex align-items-center">
    <!-- Breadcrumb starts -->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
        <a asp-action="Index" asp-controller="Departement">Acceuil</a>
      </li>
      <li class="breadcrumb-item text-primary" aria-current="page">
        Édition Facture
      </li>
    </ol>
    <!-- Breadcrumb ends -->
  </div>
  <!-- App Hero header ends -->

  <!-- App body start -->
  <div class="app-body">
    <div class="col-sm-12">

      

      <div class="card mb-3">
        <div class="card-header">
          <div class="d-flex flex-wrap gap-1">
            <h5 class="card-title">@ViewBag.patient.Numero_dossier - @ViewBag.patient.Nom @ViewBag.patient.Prenom<br />
            @if (Model.Type.Contains("proforma"))
              {
                <span>Edition Proforma,</span>
              }else{
                <span>Edition Facture,</span>
              }
            </h5>
            <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
              <i class="ri-pie-chart-2-fill text-primary fs-4"></i>
              <span class="me-1 fw-semibold ps-1 total_patient">0</span>
              <span class="text-primary">FCFA</span>
            </div>
            <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
              <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
              <span class="me-1 fw-semibold ps-1 total_ass">0</span>
              <span class="text-danger">FCFA</span>
            </div>
            <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
              <i class="ri-pie-chart-2-fill text-info fs-4"></i>
              <span class="me-1 fw-semibold ps-1 tot">0</span>
              <span class="text-info">FCFA</span>
            </div>
            
          </div>
        </div>

          <div class="card-body">



                <div class="col-sm-12">
              <div class="card">
                <div class="body">
                  <form>
                    <input id="identifiant" type="hidden"asp-for="Id" />
                    <input id="totalassurance" type="hidden"  />
                    <input id="net_a_payer" type="hidden"  />
                    <div class="form-group row">
        
                          <div class="col-md-6">
                            <div style="display: none;" class="form-group">
                              <input style="border-color: #126aef;" type="text" id="numero_dossier" class="form-control" asp-for=Numero_dossier autocomplete="off">
                            </div>

                            
                            <div class="col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Prescripteur</span>
                                <input style="border-color: #126aef;" type="text" asp-for="Medecin" class="form-control" list="docteur" id="prescripteur" placeholder="Prescripteur" autocomplete="off">
                              </div>
                            </div>

                            <div class="colonneassurance col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Matricule Patient</span>
                                <input style="border-color: #126aef;" asp-for=Matricule_patient  id="a1" type="text" class="form-control" placeholder="Matricule Patient" autocomplete="off">
                              </div>
                            </div>

                            <div class="colonneassurance col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Matricule ADH</span>
                                <input style="border-color: #126aef;" asp-for="MatriculeADH" id="a2" type="text" class="form-control" placeholder="Matricule ADH" autocomplete="off">
                              </div>
                            </div>

                            <div class="colonneassurance col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Date d'entrée</span>
                                <input style="border-color: #126aef;" asp-for="Date_entree" id="a3" type="date" class="form-control" placeholder="Date d'entrée" autocomplete="off">
                              </div>
                            </div>

                        </div>

                        
                        
                        <div class="col-sm-6">
                            <input  type="hidden" id="target" asp-for="Type">
                            <input  type="hidden" id="montant_lettre_assurance">
                            <input  type="hidden" id="montant_lettre_patient" >

                            <div style="display: none;" id="assur" class="col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Assureur</span>
                                <input style="border-color: #126aef;" asp-for="Assureur" type="text" class="form-control" list="assurance"  id="assureur" placeholder="Selectionner l'assureur" autocomplete="off">
                              </div>
                            </div>

                            <div  class="colonneassurance col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text"  style="width: 140px;">Assuré Principal</span>
                                <input style="border-color: #126aef;" type="text" asp-for="assure_prin" class="form-control" id="a4"   placeholder="Assuré Principal" value="@ViewBag.patient.Nom @ViewBag.patient.Prenom">
                              </div>
                            </div>

                            <div  class="colonneassurance col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Société</span>
                                <input style="border-color: #126aef;" type="text" asp-for="Societe" class="form-control" id="a5"  placeholder="Société">
                              </div>
                            </div>

                            <div  class="colonneassurance col-12">
                              <div class="input-group mb-4">
                                <span class="input-group-text" style="width: 140px;">Date de sortie</span>
                                <input style="border-color: #126aef;" type="date" asp-for="Date_sortie" class="form-control" id="a6"   placeholder="Date de sortie">
                              </div>
                            </div>

                          </div>



                    </div>
