 <datalist id="service1">
    @foreach (var item in ViewBag.consultation)
    {
         
        <option  value="@item.Nom"><span class="separateur">@((int)item.Montant)</span> FCFA</option>

    }
</datalist>

<datalist id="service2">
    @foreach (var item in ViewBag.examen)
    {
         
        <option  value="@item.Nom"><span class="separateur">@((int)item.Montant)</span> FCFA</option>

    }
</datalist>

<datalist id="service3">
    @foreach (var item in ViewBag.actes)
    {
         
        <option  value="@item.Nom"><span class="separateur">@((int)item.Montant)</span> FCFA</option>

    }
</datalist>

<datalist id="service4">
    @foreach (var item in ViewBag.Pharmacie)
    {
         
        <option  value="@item.Nom_article"><span class="separateur">@((int)item.Prix_vente)</span> FCFA, Stock: @item.Quantitee</option>

    }
</datalist>


<datalist id="assurance">
    @foreach (var item in ViewBag.assurances)
    {
        <option  value="@item.Nom">@item.Nom</option>
    }
</datalist>

<datalist id="docteur">
    @foreach (var item in ViewBag.doctors)
    {
       <option  value="@item.Nom">@item.Specialite</option>
    }
</datalist>





<style>
/* content editable */

*[contenteditable] { border-radius: 0.25em; min-width: 1em; outline: 0; }

*[contenteditable] { cursor: pointer; }

*[contenteditable]:hover, *[contenteditable]:focus, td:hover *[contenteditable], td:focus *[contenteditable], img.hover { background: #DEF; box-shadow: 0 0 1em 0.5em #DEF; }

span[contenteditable] { display: inline-block; }
table { width: 100%; }
