                                    <a class="add2 btn btn-info gradient" style="color: #FFF;">+ Analyse & Imagerie</a>
                                     <br/>
                                  </div>
                                  <div class="table3">
                                   <input style="font-weight: bold;color: #126aef;text-align: center;" id="titre3" class="form-control" type="text"  asp-for="Titre3">
                                    <table class="table table-hover table-striped mb-5 inventory3">
                                        <thead>
                                             <tr>
                                                <th style="text-align: left;">#REF - DÉSIGNATION</th>
