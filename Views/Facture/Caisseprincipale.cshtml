@model IEnumerable<BANA.Models.Facture>

@{
    ViewData["Title"] = "Caisse principale";
}
 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Caisse Principale
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                
                <div class="card-header">
                  
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      
                      <span><h6>Caisse Principale</h6></span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-success">Total facture</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1"><span class="separateur">@ViewBag.montanttotal</span> FCFA</span>
                      <span class="text-danger">Montant total</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewBag.encours</span>
                      <span class="text-info">En cours</span>
                    </div>
                    <a href="javascript:void(0);" onclick="window.location.reload(true);" class="btn btn-primary ms-auto">Actualiser</a>
                  </div>
                </div>

                <div class="card-body">
                  <!-- barre de recherche start-->
                  <div class="card">
                    <div class="card-body">
                      <input
                        id="search"
                        type="search"
                        class="form-control"
                        placeholder="Bare de Recherche"
                      />
                    </div>
                  </div>
                  <!-- barre de recheche end -->

                  <div class="table-outer">
                    <div class="table-responsive">
                      <table class="table truncate m-0">
                        <thead>
                          <tr>
                            
                            <th>Cordonnées du client</th>
                            <th>Date</th>
                            <th>Montant</th>
                            <th>Etat</th>
                            <th>Action</th>
                          </tr>
                        </thead>

                        <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                            <tr class="montest">
                              
                              <td>
                                <div class="d-flex align-items-center">
                                  <img src="/template2/assets/images/invoice.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="@item.Nom @item.Prenom"/>
                                  <div class="ml-3">
                                    @if (item.Type.Contains("caution"))
                                    {
                                      <a href="#" title="afficher">Caution Nº @item.Numero_de_facture, Dossier Nº @item.Numero_dossier</a>
                                    }else{
                                      <a href="#" title="afficher">Facture Nº @item.Numero_de_facture, Dossier Nº @item.Numero_dossier</a>
                                    }

                                    <p style="max-width: 300px; overflow: hidden" class="mb-0">
                                      @item.Nom @item.Prenom  @item.Numero_dossier
                                    </p>
                                  </div>
                                </div>
                              </td>
                              <td>@item.Create_date.ToString("dd/MM/yyyy") @item.Create_date.ToShortTimeString()</td>
                              <td><span class="separateur">@item.Net_a_payer_patient</span> FCFA</td>
                              <td>
                                @if (item.Etat_patient=="Cloturé"){<span class="badge border border-success text-success">@item.Etat_patient</span>}else if(item.Etat_patient=="Paiement partiel"){<span class=" badge border border-warning text-warning">@item.Etat_patient</span>}else{<span class="badge border border-danger text-danger">@item.Etat_patient</span>}
                               
                              </td>
                              <td>
                                @if (item.Etat_patient=="En attente Paiement" && (item.Intervenant=="" || item.Intervenant==null))
                                {
                                if (item.Type!=null && item.Type.Contains("assurance"))
                                  {
                                    <button onclick="location.href='/Facture/Edit2/@item.Id';" type="button" class="btn btn-outline-secondary" title="Edit Invoice">
                                      <i class="fa fa-edit"></i>
                                    </button>
                                  }else
                                  {
                                    <button onclick="location.href='/Facture/Edit/@item.Id';" type="button" class="btn btn-outline-secondary" title="Edit Invoice">
                                      <i class="fa fa-edit"></i>
                                    </button>
                                  }
                                }
                                <button onclick="location.href='/Facture/Matricielle/@item.Id';" type="button" class="btn btn-outline-secondary " title="Voir">
                                  <i class="fa fa-eye"></i>
                                </button>

                               
                              </td>
                            </tr>
                          }

                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- app body end-->