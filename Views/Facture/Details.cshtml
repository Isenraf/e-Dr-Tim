                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> <span class="separateur">@(Model.Total_ht)</span> FCFA</strong></td>
                            </tr>
                            @if (Model.Type!=null)
                            {
                              if (Model.Type.Contains("assurance"))
                              {
                                <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                    <td style="font-weight: 600;font-size: 15px;padding: 0rem 0.3rem 0rem 0.3rem;border: 1px solid;" colspan="2" class="text-right">
                                    <span>Net à Payer Assurance:</span>
                                    </td>
                                    <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""> <span class="separateur">@(Model.Total_ht-Model.Net_a_payer_patient-Model.Remise)</span> FCFA</strong></td>
                                </tr>
                                if (Model.ticketmoderateur>0)
                                {
                                  <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                      <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="2" class="text-right">
                                      <span>Ticket Modérateur:&nbsp;&nbsp;</span>
                                      </td>
                                      <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.ticketmoderateur)</span> FCFA</strong></td>
                                  </tr>
                                  <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                      
                                      <td style="font-weight: 600;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="2" class="text-right">
                                      <span>Complément patient:&nbsp;&nbsp;</span>
                                      </td>
                                      <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient+Model.Remise-Model.ticketmoderateur)</span> FCFA</strong></td>
                                  </tr>
                                }
                                
                              }
                              
                            }
                            @if (Model.Remise>0)
                            {
                              <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;font-size: 17px;text-transform: uppercase;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="2" class="text-right">
                                <span>Remise:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="font-size: 17px;text-transform: uppercase;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong ><span class="separateur">@(Model.Remise)</span> FCFA</strong></td>
                            </tr>
                            }
                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;font-size: 17px;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="2" class="text-right">
                                <span>Net à Payer Patient:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient)</span> FCFA</strong></td>
                            </tr>
                            
                            
                            <tr style="padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="font-weight: 600;font-size: 17px;border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="2" class="text-right">
                                <span>Montant payé:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Montant_recu_patient)</span> FCFA</strong></td>
                            </tr>
                            <tr style="font-weight: 600;font-size: 17px;padding: 0rem 0.3rem 0rem 0.3rem;">
                                
                                <td style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;" colspan="2" class="text-right">
                                <span>Reste à payé:&nbsp;&nbsp;</span>
                                </td>
                                <td class="text-right" style="border: 1px solid;padding: 0rem 0.3rem 0rem 0.3rem;"><strong class=""><span class="separateur">@(Model.Net_a_payer_patient-Model.Montant_recu_patient)</span> FCFA</strong></td>
                            </tr>
                            
                          </tfoot>
                        </table>
                     
                        <br>
                        
                       
                      </div>
                    </div>
                  </div>
                  <div class="row clearfix">
                    <div class="col-md-6">
                      <span>
                        <input  id="text" type="text" value="https://www.polycliniquedepoitiers.com/Resultat/Create" style="display: none;" />
                    </div>

                    <div class="col-md-6 text-right">
                      
                      
                          
