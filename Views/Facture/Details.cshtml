@model BANA.Models.Facture

@{
    ViewData["Title"] = "Facture - "+ @Model.Nom + @Model.Prenom;
    int st=0;
    int controla=0;
}

<input  type="hidden" id="target" asp-for="Type">
<input  type="hidden" id="lf1" asp-for="Ligne_facturation1">
<input  type="hidden" id="lf2" asp-for="Ligne_facturation2">
<input  type="hidden" id="lf3" asp-for="Ligne_facturation3">
<input  type="hidden" id="lf4" asp-for="Ligne_facturation4">

<!-- App container starts -->
<div class="app-container">
  <!-- App hero header starts -->
  <div class="app-hero-header d-flex align-items-center">
    <!-- Breadcrumb starts -->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
        <a asp-action="Index" asp-controller="Departement">Acceuil</a>
      </li>
      <li class="breadcrumb-item text-primary" aria-current="page">
         Facture assurance
      </li>
    </ol>
    <!-- Breadcrumb ends -->
  </div>
  <!-- App Hero header ends -->



  <!-- App body start -->
  <div class="app-body">

    <div  style="margin-bottom: 20px;background-color: #126aef12;padding: 10px;border-radius: 10px;text-align: right;" class="">
        <div class="">
          @if (Model.Type.Contains("assurance"))
          {
            <button class="btn btn-primary theme-bg gradient" id="f1"  onclick="location.href='/Facture/Details4/@Model.Id';">
                    Facture assurance</button>
          }
          @if(Model.Type.Contains("proforma")){
            <button class="btn btn-warning  gradient" onclick="location.href='/Facture/transform1/@Model.Id';"  >
                        <i class="fa fa-check"></i> Transformer en facture</button>
          }
            
          <button class="btn btn-outline-secondary" id="closeButton"  onclick="history.back();">
            <i class="fa fa-previous"></i> Fermer</button>

            <button class="btn btn-outline-secondary" onclick="location.href='/Facture/Matricielle/@Model.Id';">
              <i class="fa fa-previous"></i> Changer Format</button>
          @if (Model.Etat_patient=="Cloturé" && (ViewBag.user.Type_de_compte=="administrateur" || ViewBag.user.Type_de_compte=="super-Admin"))
          {
          <button type="button" class="btn btn-outline-secondary" title="Manual Generate" id="manualgenerate">
            <i class="fa fa-envelope"></i>
          </button>
          <button type="button" data-bs-toggle="modal" data-bs-target="#AddDepartments" class="btn btn-outline-secondary" title="Manual Honoraire" >
            <i class="fa fa-file"></i>
          </button>
          }
          
          @if (Model.Etat_patient!="Cloturé" && Model.Net_a_payer_patient-Model.Montant_recu_patient==0)
          {
              <button class="btn btn-warning  gradient" id="Cloturebt" >
              <i class="fa fa-check"></i> Valider la Cloture</button>
          }
          @if (Model.Etat_patient=="Cloturé" && Model.Net_a_payer_patient==0 && (ViewBag.user.Type_de_compte=="administrateur" || ViewBag.user.Type_de_compte=="super-Admin") )
          {
            <button class="btn btn-warning  gradient" id="decloturer" >
              <i class="fa fa-check"></i> Décloturer</button>
          }
          

          @if (Model.Etat_patient!="Cloturé" && Model.Intervenant=="" && Model.Ligne_facturation2!="λ" && (Model.Type=="examens_assurance" || Model.Type=="generique_assurance" ))
          {
            <button class="btn btn-danger  gradient" id="genererexamens" >
              <i class="fa fa-check"></i> Générer les résultats</button>
          }
          @if (Model.Etat_patient=="Cloturé"){
                <button class="btn btn-primary theme-bg gradient" id="printfact">
                    <i class="fa fa-print"></i> Print</button>
              }

        </div>
      </div>

   

    <div class="col-sm-12">

          <div class="row clearfix">
            
            <div class="col-lg-12">
              <div id="tdt1" style="min-height: 40cm;" class="card card2">
                @if(!Model.Type.Contains("dentiste")){
                   <img style="float: right;" id="img1" src="/img1/pppp.jpg" width="100%" data-toggle="tooltip" data-placement="top" title="" alt="Polyclinique de Poitiers"  data-original-title="Polyclinique de Poitiers">
                }else{
                   <img style="float: right;" id="img1" src="/img1/00pppp.jpg" width="100%" data-toggle="tooltip" data-placement="top" title="" alt="Cabinet dentaite"  data-original-title="Cabinet dentaite"><br><br>
                }
               
                <div style="padding: 15px;margin-top: -125%;min-height: 32cm;"  id="printMe" class="body" >
                  <br> <br>
                  <div class="row clearfix">
                    <div class="col-md-12">
                      <table style="text-transform: uppercase;width: 100%;color: black;" >
                        <tr>
                          @if (Model.Type.Contains("caution"))
                          {
                            <th style="font-size: 17px;width: 140px; border: 1px solid;color: black;" >Reçu Caution Nº: </th>
                          }else{
                            @if(Model.Type.Contains("proforma")){
                            <th style="width: 140px; border: 1px solid;color: black;" >Proforma Nº: </th>
                            }else{
                              <th style="width: 140px; border: 1px solid;color: black;" >Facture Nº: </th>
                            }
                          }
                          
