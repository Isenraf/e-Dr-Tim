@model IEnumerable<BANA.Models.Facture>

@{
    ViewData["Title"] = "Index";
    int i=1;
}


<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Proformas dentiste
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card py-3 px-3">
              <div
                class="d-flex align-items-center justify-content-between mt-2"
              >
                <h5 class="card-title">Proformas dentiste</h5>

                <div class="d-flex flex-wrap gap-1">
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                    <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                    <span class="text-danger">Total facture</span>
                  </div>
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                    <span class="me-1 fw-semibold ps-1"><span class="separateur">@ViewBag.montanttotal</span> FCFA</span>
                    <span class="text-success">Montant Total</span>
                  </div>
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                    <span class="me-1 fw-semibold ps-1">@ViewBag.encours</span>
                    <span class="text-danger">En cours</span>
                  </div>
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                    <span class="me-1 fw-semibold ps-1">@ViewBag.fini</span>
                    <span class="text-info">Terminées</span>
                  </div>
                </div>
              </div>
              <br />

              <div class="row gx-3 gy-3">
                <div class="card">
                  <div
                    style="
                      display: flex;
                      justify-content: space-between;
                      align-items: center;
                    "
                  >
                    <div>
                      <a href="javascript:void(0);" onclick="history.back();" style="margin-right: 10px" class="text-primary"
                        >Toutes les Factures</a
                      >
                      <a asp-action="Index2" asp-route-Etat="En attente Paiement" asp-route-date="@ViewData["date"]" style="margin-right: 10px">Factures en cours</a>
                      <a asp-action="Index2" asp-route-Etat="Cloturé" asp-route-date="@ViewData["date"]" style="margin-right: 10px">Factures réglées</a>
                    </div>

                    <div style="display: flex; gap: 10px">
                      
                    </div>
                  </div>
                </div>
                <div class="col-12">
                  <div class="row gx-3 gy-3">
                    <div class="card">
                      <div class="card-body">
                        <form asp-controller="Facture" asp-action="Index"  method="get">
                          <input type="search" id="search" name="SearchString" class="form-control" placeholder="Bare de Recherche"/>
                        </form>
                      </div>
                    </div>
                  </div>

                  <div class="table-responsive mt-3">
                    <table
                      class="table truncate m-0"
                      style="width: 100%; border-collapse: collapse"
                    >
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Coordonnees du client</th>
                          <th>Date</th>
                          <th>MONTANT</th>
                          <th>Etat</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                          i=(i>8)?1:i;
                          string img="avatar"+i+".jpg";

                            <tr class="montest">
                              <td>@item.Id</td>
                              <td>
                                <div class="d-flex align-items-center">
                                  <img src="/template2/assets/images/invoice.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="@item.Nom @item.Prenom"/>
                                  <div class="ml-3">
                                    @if (item.Type.Contains("medicament"))
                                    {
                                      <a href="#" style="color: #126aef;" title="afficher la facture">Facture Nº @(item.Numero_de_facture), Dossier Nº @item.Numero_dossier</a>
                                    }else{
                                      <a href="#" style="color: #126aef;" title="afficher la facture">Facture Nº @(item.Numero_de_facture), Dossier Nº @item.Numero_dossier</a>
                                    }
                                    <p style="max-width: 300px; overflow: hidden" class="mb-0">@item.Nom @item.Prenom</p>
                                  </div>
                                </div>
                                
                              </td>
                              <td>@item.Create_date.ToString("dd/MM/yyyy") @item.Create_date.ToShortTimeString()</td>
                              <td><span class="separateur">@item.Net_a_payer_assurance</span> FCFA</td>
                              <td>
                                @if (item.Etat_patient=="Cloturé"){<span class="badge border border-success text-success">@item.Etat_patient</span>}else if(item.Etat_patient=="Paiement partiel"){<span class="badge border border-warning text-warning">@item.Etat_patient</span>}else{<span class="badge border border-danger text-danger">@item.Etat_patient</span>}
                              </td>
                              <td>
                                @if (item.Etat_patient=="En attente Paiement" && (item.Intervenant=="" && item.Intervenant==null))
                                    {
                                      if (item.Type!=null && item.Type.Contains("assurance"))
                                      {
                                        <button onclick="location.href='/Facture/Edit2/@item.Id?nd=@item.Numero_dossier'+'&target=@item.Type';" type="button" class="btn btn-outline-secondary" title="modifier la facturee">
                                          <i class="fa fa-edit"></i>
                                        </button>
                                      }else
                                      {
                                        <button onclick="location.href='/Facture/Edit/@item.Id?nd=@item.Numero_dossier'+'&target=@item.Type';" type="button" class="btn btn-outline-secondary" title="modifier la facturee">
                                          <i class="fa fa-edit"></i>
                                        </button>
                                      }
                                      
                                    }else if((item.Intervenant!="" && item.Intervenant!=null) && (item.Type=="medicament_assurance") && item.Etat_patient=="En attente Paiement"){
                                      <button onclick="location.href='/Facture/Edit2/@item.Id?nd=@item.Numero_dossier'+'&target=@item.Type';" type="button" class="btn btn-outline-secondary" title="modifier la facture">
                                          <i class="fa fa-edit"></i>
                                        </button>
                                    }
                                    @if (item.Type.Contains("medicament"))
                                    {
                                      <button onclick="location.href='/Facture/Details3/@item.Id';" type="button" style="background-color: #e5e64782;" class="btn btn-outline-secondary " title="afficher la facture">
                                        <i class="fa fa-eye"></i>
                                      </button>
                                    }else if(item.Type.Contains("assurance")){
                                      <button  type="button" style="background-color: #0ebb134f;" onclick="location.href='/Facture/Details4/@item.Id';" class="btn btn-outline-secondary" title="afficher la facture">
                                        <input type="hidden" value="assurance">
                                        <i class="fa fa-eye"></i>
                                      </button>

                                      <button  type="button" class="btn btn-outline-secondary" onclick="location.href='/Facture/Details/@item.Id';" title="afficher la facture">
                                        <input type="hidden" value="cash">
                                        <i class="fa fa-eye"></i>
                                      </button>

                                    }else{
                                      <button  type="button"  class="btn btn-outline-secondary" onclick="location.href='/Facture/Details/@item.Id';" title="afficher la facture">
                                        <input type="hidden" value="cash">
                                        <i class="fa fa-eye"></i>
                                      </button>
                                    }
                              </td>
                            </tr>
                          }

                        

                      </tbody>
                    </table>
                  </div>

                  <!-- body body end -->
                 
                </div>
              </div>
              <!-- App body ends -->
            </div>
          </div>



