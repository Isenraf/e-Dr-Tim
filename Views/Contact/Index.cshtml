@model IEnumerable<BANA.Models.Contact>

@{
    ViewData["Title"] = "Index";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Contacts
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["total"]</span>
                      <span class="text-info">Total</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["actifs"]</span>
                      <span class="text-info">Actif</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["inactifs"]</span>
                      <span class="text-info">Inactif</span>
                    </div>

                    <button type="button" onclick="location.href='/Contact/Create';"  class="btn btn-dark ms-auto">
                      Ajouter Nouveau
                    </button>
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3">
                      <div class="card">
                        <div class="card-body">
                          <input
                            type="search"
                            id="search"
                            class="form-control"
                            placeholder="Bare de Recherche"
                          />
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>
                  </div>
                </div>

                <div class="row gx-3 px-2">
                  @foreach (var item in Model)
                {
                  <div class="col-xl-3 col-sm-6 text-center">
                    <div class="card border-0 bg-primary mb-3">
                      <div class="card">
                        <div class="card-body">
                          <div>

                            @if(true){
                              <img src="/template2/assets/images/user_men.png" class="img-fluid rounded-circle mb-3" alt="e-Dr Tim Hospital Management" style=" width: 100px; max-width: auto; display: flex; justify-self: anchor-center;"/>
                            }else{
                              <img src="/template2/assets/images/user_woman.webp" class="img-fluid rounded-circle mb-3" alt="e-Dr Tim Hospital Management" style=" width: 100px; max-width: auto; display: flex; justify-self: anchor-center;"/>
                            }

                            <div class="dropdown card-btn-floating" style="position: absolute;right: 16px;top: 10px;">
                                <div class="btn-white" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                                    <i class="ri-more-2-fill"></i>
                                </div>
                                
                                <ul class="dropdown-menu" style="padding: 10px;background-color: #126aef;">
                                    
                                      <li>
                                      <a style="color: white;" asp-action="Edit" asp-route-Id="@item.Id">Modifier</a>
                                      </li>
                                      
                                      <li>
                                      <a style="color: white;" asp-action="Delete" asp-route-Id="@item.Id">Supprimer</a>
                                      </li>
                                </ul>
                            </div>
                            
                          </div>
                          <h6 class="mt-3 mb-0">@item.Nom</h6>
                          <span>
                            <a href="#" class="text-success">@item.Phone</a>
                          </span>
                          <span>
                            <p>@item.Categorie</p>
                          </span>
                          <span>
                            <p>Date de création: @item.Create_date.ToString("dd/MM/yyyy") @item.Create_date.ToShortTimeString()</p>
                          </span>
                          <ul
                            class="mt-3 list-unstyled d-flex justify-content-center"
                          >
                            <li>
                              <a class="p-3" target="_blank" href="javascript:void(0);">
                                <i class="ri-facebook-fill"></i>
                              </a>
                            </li>
                            <li>
                              <a class="p-3" target="_blank" href="javascript:void(0);">
                                <i class="ri-hashtag"></i>
                              </a>
                            </li>
                            <li>
                              <a class="p-3" target="_blank" href="javascript:void(0);">
                                <i class="ri-linkedin-fill"></i>
                              </a>
                            </li>
                          </ul>
                          <button onclick="location.href='/Contact/Details/@item.Id'" class="btn btn-outline-primary">
                            Détails
                          </button>
                          <button class="btn btn-outline-success">
                            Whatsapp
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                  }
                </div>
              </div>
            </div>
            <!-- App body ends -->
          </div>
      </div>
  <a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
