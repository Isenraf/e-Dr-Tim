@model IEnumerable<BANA.Models.Parametre>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">Liste des parametres</li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- App body starts -->
    <div class="app-body">
        <!-- body body start -->
        <div class="col-sm-12">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Liste des parametres</h5>
                    <button class="btn btn-primary ms-auto" onclick="location.href='/parametre/create0'">Nouveau parametres</button>
                </div>

                <!-- Modal ajouter parametres -->
                <div class="modal fade" id="addparametre" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Numéro du reçu patient</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="Create" method="get">
                            <div class="modal-body text-center">
                                <img style="width: 100px; height: 100px;" class="img-fluid mb-3" src="/template2/assets/images/documents.png" alt="dossier" />
                                <input class="form-control" name="nd" type="number" placeholder="N° Facture" required />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                <button type="submit" class="btn btn-primary" data-bs-dismiss="modal">Continuer</button>
                            </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- barre de recherche start-->
                    <div class="card">
                        <div class="card-body">
                            <input type="search" class="form-control" placeholder="Bare de Recherche" />
                        </div>
                    </div>
                    <!-- barre de recheche end -->

                    <!-- Table starts -->
                    <div>
                        <table id="basicExample"  class="table m-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Transfert</th>
                                    <th>No. Dossier</th>
                                    <th>Nº Facture</th>
                                    <th>Patient</th>
                                    <th>Température patient</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in Model){
                                    <tr>
                                    <td>
                                    @if(item.Numero_Facture!="" && item.Numero_Facture!=null){
                                        <div class="d-inline-flex gap-1">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-primary">Transférer</button>
                                                <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span class="visually-hidden"><option value=""></option></span>
                                                </button>
                                                <ul class="dropdown-menu" style="padding: 10px; width: 250px;">
                                                    <li><a class="dropdown-item" href="#">Transférer</a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <input type="text" 
                                                            style="margin-bottom: 10px;" 
                                                            class="form-control med" 
                                                            placeholder="Choisir un médecin..."
                                                            list="medecins">

                                                        <datalist id="medecins">
                                                            @foreach (var item2 in ViewBag.medecins)
                                                            {
                                                                <option value="@item2.Nom @item2.Prenom">@item2.Specialite</option>
                                                            }
                                                        </datalist>
                                                    </li>
                                                    <li>
                                                        <input type="hidden" class="facture" value="@item.Numero_Facture">
                                                        <button type="button" class="btn btn-primary transfert_go w-100">
                                                            Transférer
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                        
                                    </td>
                                    <td>@item.Numero_Dossier</td>
                                    <td>@item.Numero_Facture</td>
                                    <td>@item.Patient</td>
                                    <td>🌡️ @item.Temperature ºC</td>
                                    <td>@item.Create_date</td>
                                    <td>
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-outline-danger btn-sm" onclick="location.href='/Parametre/Delete/@item.Id';">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                            <a href="#" class="btn btn-outline-success btn-sm" onclick="location.href='/Parametre/edit/@item.Id';">
                                                <i class="ri-edit-2-line"></i>
                                            </a>
                                            
                                            <button class="btn btn-outline-info btn-sm viewBtn" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#exampleModal"
                                                    data-numero="@item.Numero_Dossier"
                                                    data-facture="@item.Numero_Facture"
                                                    data-patient="@item.Patient"
                                                    data-temperature="@item.Temperature"
                                                    data-date="@item.Create_date"
                                                    data-tbg="@item.Tsysbg/@item.Tdiasbg mmHg"
                                                    data-tbd="@item.Tsysbd/@item.Tdiasbd mmHg"
                                                    data-pg="@item.Pbg Bpm"
                                                    data-pd="@item.Pbd Bpm"
                                                    data-fr="@item.Rpm Cpm"
                                                    data-sat="@item.Saturation %"
                                                    data-poids="@item.Poids kg"
                                                    data-taille="@item.Taille m"
                                                    data-obs="@item.Observation"
                                                    data-pc="@item.Pc cm"
                                                    >
                                                <i class="ri-eye-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                }
                                

                            </tbody>
                        </table>
                    </div>
                    <!-- Table ends -->

                    <!-- Modal voir parametres -->
                    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">parametres</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div>
                                        <ul>
                                            <li><p>Date de prise : <span id="modalDate" style="font-weight: bold;" class="text-primary"></span></p></li>
                                            <li><p>N° dossier: <span id="modalNumero" style="font-weight: bold;" class="text-primary"></span></p></li>
                                            <li><p>Nº Facture: <span id="modalFacture" style="font-weight: bold;" class="text-primary"></span></p></li>
                                            <li><p>Patient: <span id="modalPatient" style="font-weight: bold;" class="text-primary"></span></p></li>
                                            <li><p>Température (°C): <span id="modalTemp" style="font-weight: bold;" class="text-primary"></span></p></li>
                                            <li>
                                                <p>
                                                    Tension artérielle bras gauche :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalTag"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Tension artérielle bras droit :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalTad"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Pouls bras gauche :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalpg"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Pouls bras droit :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalpd"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Fréquence respiratoire (rpm) :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalfre"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Saturation en O₂ (%) :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalSat"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Poids (kg) :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalPoi"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Taille (m) :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalTai"></span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    périmètre crânien :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalpc"></span>
                                                </p>
                                            </li>

                                            
                                            <li>
                                                <p>
                                                    Commentaire :
                                                    <span class="text-primary" style="font-weight: bold;" id="modalCom">Remarques cliniques ou anomalies observées.</span>
                                                </p>
                                            </li>
                                           
                                        </ul>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- App body ends -->

     <div class="action-container" style="position: fixed;right: 45px;bottom: 30px;">
        <!-- Première version = dropdown -->
        <div class="btn-group dropup">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                Nouveau
            </button>

            <ul class="dropdown-menu p-3" style="min-width: 300px;">
                <li>
                    <div class="d-flex flex-column gap-2">
                        <form asp-action="Create" method="get">
                        <input  name="dossier" class="form-control" style="height: 60px;" placeholder="Numéro de dossier" />
                        </form>
                        
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".viewBtn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                // On récupère les données
                document.getElementById("modalNumero").textContent = this.dataset.numero;
                document.getElementById("modalFacture").textContent = this.dataset.facture;
                document.getElementById("modalPatient").textContent = this.dataset.patient;
                document.getElementById("modalTemp").textContent = this.dataset.temperature + " ºC";
                document.getElementById("modalDate").textContent = this.dataset.date;
                document.getElementById("modalpg").textContent = this.dataset.pg;
                document.getElementById("modalpd").textContent = this.dataset.pd;
                document.getElementById("modalTag").textContent = this.dataset.tbg;
                document.getElementById("modalTad").textContent = this.dataset.tbd;
                document.getElementById("modalfre").textContent = this.dataset.fr;
                document.getElementById("modalSat").textContent = this.dataset.sat;
                document.getElementById("modalPoi").textContent = this.dataset.poids;
                document.getElementById("modalTai").textContent = this.dataset.taille;
                document.getElementById("modalpc").textContent = this.dataset.pc;
                document.getElementById("modalCom").textContent = this.dataset.obs;

               
            });
        });
    });
</script>
