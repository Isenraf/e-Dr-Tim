@model BANA.Models.Departement

@{
    ViewData["Title"] = "Details";
}

<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Département
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <div class="app-body">
        <div class="card px-3">
            <div class="d-flex align-items-center justify-content-between mt-3">
                <h5 class="card-title">
                    Polyclinique de Poitiers<br />
                    <h7 style="font-size: 12px; color: #4c545e;">@Model.Nom</h7>
                </h5>

                <div class="d-flex flex-wrap gap-1">
                    <button class="btn btn-info d-none d-md-inline-block">
                        Modifier le service
                    </button>
                    <a href="#" onclick="history.back()" class="btn btn-outline-primary d-none d-md-inline-block">Retour</a>
                </div>
            </div>

            <br />
            <div class="row">
                <div class="col-lg-4 col-sm-12">
                    <div class="card p-3 mb-4">
                        <div class="d-flex flex-column align-items-center">
                            <img src="/img1/INFIRMIER.png" class="img-fluid rounded-circle mb-3" alt="Infirmier" />

                            <h4 class="mb-1">@Model.Nom</h4>
                            <div>
                                <button class="btn btn-info">Modifier</button>
                                <a href="#" onclick="history.back()" class="btn btn-outline-primary">Retour</a>
                            </div>
                        </div>
                    </div>

                    <!-- Informations du département -->
                    <div class="card p-3 mb-4">
                        <h5>À propos du Département</h5>
                        <p><strong>Nom:</strong> @Model.Nom</p>
                        <p><strong>Description:</strong> @Model.Description.</p>
                        <p><strong>Département actif:</strong> @Model.Actif</p>
                    </div>
                </div>
                <!-- Liste des professionnels -->
                <div class="col-lg-8 col-sm-12">
                    <div class="col-sm-12">
                        <div class="card mb-3">
                            <div class="card-header">
                                <div class="row gx-3">
                                    <div class="col col-md-4 mb-3">
                                        <div class="card mb-3">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>Nombre de département</span>
                                                    <span class="text-success fw-bold">37</span>
                                                </div>
                                                <div class="progress small">
                                                    <div class="progress-bar bg-success" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col col-md-4">
                                        <div class="card mb-3">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>Nombre de département</span>
                                                    <span class="text-info fw-bold">FCFA</span>
                                                </div>
                                                <div class="progress small">
                                                    <div class="progress-bar bg-danger" role="progressbar" style="width: 35%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col col-md-4">
                                        <div class="card mb-3">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>Nombre de département</span>
                                                    <span class="text-info fw-bold">FCFA</span>
                                                </div>
                                                <div class="progress small">
                                                    <div class="progress-bar bg-info" role="progressbar" style="width: 15%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="custom-tabs-container">
                                    <ul class="nav nav-tabs" id="customTab3" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <a class="nav-link active" id="tab-oneAA" data-bs-toggle="tab" href="#oneAA" role="tab" aria-controls="oneAA" aria-selected="true"><i class="ri-shake-hands-line me-2"></i>Service medical</a>
                                        </li>
                                    </ul>
                                    <div class="tab-content" id="customTabContent3">
                                        <div class="tab-pane fade show active" id="oneAA" role="tabpanel" aria-labelledby="tab-oneAA">
                                            <h5>Liste des professionnels</h5>
                                            <div class="row">
                                             @foreach (var item in ViewBag.doctors)
                                              {  
                                                <div class="col-xl-3 col-sm-6 text-center my-2">
                                                    <div class="card border-0 bg-primary mb-3">
                                                        <div class="card">
                                                            <div class="card-body">
                                                                @if (item.Genre=="Masculin")
                                                                {
                                                                  <img src="/template2/assets/images/medecin_homme.png" class="img-fluid rounded-circle mb-3" alt="afficher le profil" style="width: 100px; max-width: auto; display: flex; justify-self: anchor-center;" />
                                                                }else{
                                                                  <img src="/template2/assets/images/medecin_femme.png" class="img-fluid rounded-circle mb-3" alt="afficher le profil" style="width: 100px; max-width: auto; display: flex; justify-self: anchor-center;" />
                                                                }
                                                                <h6 class="mt-2">@item.Prenom @item.Nom</h6>
                                                                <p class="text-muted">@item.Telephone</p>
                                                                <p>@item.Specialite</p>
                                                                <div class="d-flex justify-content-center gap-2">
                                                                    <i class="ri-facebook-box-fill text-primary"></i>
                                                                    <i class="ri-settings-3-fill text-warning"></i>
                                                                    <i class="ri-linkedin-box-fill text-info"></i>
                                                                </div>
                                                                <button onclick="location.href='/Doctor/Details/@item.Id';" class="btn btn-outline-primary btn-sm mt-2">
                                                                    Profile
                                                                </button>
                                                                <button class="btn btn-outline-success btn-sm mt-2">
                                                                    Whatsapp
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                }
                                                
                                               
                                                
                                                
                                              

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- App body ends -->
</div>
