@model IEnumerable<BANA.Models.Departement> 

@{
    ViewData["Title"] = "Index";
}
<link rel="stylesheet" href="/template/assets/vendor/dropify/css/dropify.min.css">
 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Tous les departements
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <div class="app-body">
            <div class="card px-3" style="padding: 10px;">
              <div
                class="d-flex align-items-center justify-content-between mt-3"
              >
                <h5 class="card-title">Liste des départements</h5>
                <button
                  class="btn btn-primary ms-auto"
                  data-bs-toggle="modal"
                  data-bs-target="#reg-modal"
                >
                  Ajouter Département
                </button>
              </div>
              <br />
              <div id="testfiltre" class="row gx-3 gy-3">
                <div>
                  <div>
                    <input
                      type="search"
                      id="search"
                      class="form-control"
                      placeholder="Bare de Recherche"
                    />
                  </div>
                </div>
                
                @foreach (var item in Model)
                {
                <div class="montest col-xl-3 col-sm-6">
                  <div class="card">
                    <div class="card-body">
                      <div class="card-img">
                        <img
                          src="/img1/@item.Image"
                          class="img-fluid rounded-3 mb-3"
                          alt="e-Dr Tim Hospital Management"
                          style="
                            width: 100px;
                            max-width: auto;
                            display: flex;
                            justify-self: anchor-center;
                          "
                        />
                      </div>
                      <p class="mb-1 text-center">@item.Nom</p>
                      <div class="text-center">
                        <div class="ml-2 mr-2">
                          <i class="ri-star-s-line"></i>
                          <i class="ri-star-s-line"></i>
                          <i class="ri-star-s-line"></i>
                          <i class="ri-star-s-line"></i>
                        </div>
                      </div>
                      <a
                        asp-action="Details" asp-route-Id="@item.Id"
                        class="btn btn-outline-primary"
                        >Afficher</a
                      >
                    </div>
                  </div>
                </div>
                }
               
                


              </div>
            </div>
          </div>
          <!-- App body ends -->
        </div>
      
      



       <!-- modal itself -->
      <div
        class="modal fade"
        id="reg-modal"
        tabindex="-1"
        aria-labelledby="modal-title"
        aria-hidden="true"
      >
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modal-title">
                Ajout d'un Département
              </h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>

            <div class="modal-body">
              <div class="mb-3">
                <input
                  type="text"
                  id="nom_departement"
                  class="form-control"
                  placeholder="Nom du département"
                />
              </div>

              <div class="mb-3">
                <input id="FileUpload1" type="file"  class="dropify">
              </div>

              <div class="col-sm-12 mb-3">
                <div class="form-group mt-3">
                  <textarea
                    style="resize: none"
                    rows="6"
                    id="description_departement"
                    class="form-control"
                    placeholder="Description du département..."
                    name="Description"
                  ></textarea>
                </div>
              </div>

              <div class="form-check">
                <input
                   id="actif" style="accent-color: #116aef;"
                  class="form-check-input"
                  type="checkbox"
                  
                  
                />
                <label class="form-check-label" for="flexCheckDefault"
                  >Activer</label
                >
              </div>
            </div>

            <div class="modal-footer">
              <button type="button" id="enregistrer_departement" class="btn btn-primary">Enregistrer</button>
              <button class="btn btn-danger" data-bs-dismiss="modal">
                Fermer
              </button>
            </div>
          </div>
        </div>
      </div>
    
