@model IEnumerable<BANA.Models.Doctor>

@{
    ViewData["Title"] = "Index";
}
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Personnel soignant
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- App body start -->
    <div class="app-body">
        <div class="col-sm-12">
            <div class="card mb-3 px-2">
                <div class="card-header">
                    <div class="d-flex flex-wrap gap-1">
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                            <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                            <span class="me-1 fw-semibold ps-1">@ViewData["Interne"]</span>
                            <span class="text-info">Internes</span>
                        </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                            <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                            <span class="me-1 fw-semibold ps-1">@ViewData["Externe"]</span>
                            <span class="text-info">Externes</span>
                        </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                            <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                            <span class="me-1 fw-semibold ps-1">@ViewData["total"]</span>
                            <span class="text-info">Total</span>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div id="customButtons_filter" class="dataTables_filter" style="text-align: right; margin-bottom: 5px">
                        <!-- Barre de recherche start -->
                        <div class="row gx-3 gy-3">
                            <div class="card">
                                <form asp-controller="Doctor" asp-action="Index"  method="get">
                                    <div class="card-body">
                                        <input type="search" id="search" name="target" class="form-control" placeholder="Barre de Recherche" />
                                    </div>
                                </form>
                            </div>
                            <!-- Barre de recherche end -->
                        </div>
                    </div>
                </div>

                <div id="testfiltre" class="row gx-3 mx-1">
                  @foreach (var item in Model)
                  {
                    <div class="col-xl-3 col-sm-6 text-center montest">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5 class="card-title"></h5>
                            </div>
                            <div class="card-body position-relative">

                              @if (item.Genre=="Masculin")
                              {
                                <img src="/template2/assets/images/medecin_homme.png" 
                                      class="img-fluid rounded-circle mb-3" 
                                      alt="afficher le profil" 
                                      style="width: 100px; max-width: auto; display: flex; justify-self: anchor-center;" />
                                  
                              }else{
                                <img src="/template2/assets/images/medecin_femme.png" 
                                      class="img-fluid rounded-circle mb-3" 
                                      alt="afficher le profil" 
                                      style="width: 100px; max-width: auto; display: flex; justify-self: anchor-center;" />
                              }

                                <div class="dropdown card-btn-floating">
                                    <div class="btn-white" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                                        <i class="ri-more-2-fill"></i>
                                    </div>
                                    
                                    <ul class="dropdown-menu" style="padding: 10px;background-color: #126aef;">
                                        <li>
                                          <a  style="color: white;" asp-action="Details" asp-route-Id="@item.Id">Détails</a>
                                          </li>
                                          <li>
                                          <a style="color: white;" asp-action="Edit" asp-route-Id="@item.Id">Modifier</a>
                                          </li>
                                          <li>
                                          @if(item.Actif==true){
                                              <a style="color: white;" asp-action="Disable" asp-route-Id="@item.Id">désactiver</a>
                                          }else{
                                              <a style="color: white;" asp-action="Disable" asp-route-Id="@item.Id">Activer</a>
                                          }
                                          </li>
                                          <li>
                                          <a style="color: white;" asp-action="Delete" asp-route-Id="@item.Id">Supprimer</a>
                                          </li>
                                    </ul>
                                </div>

                                <h6 class="mt-3 mb-0">@item.Prenom @item.Nom</h6>
                                <span>
                                    <a href="#" class="text-success">@item.Telephone</a>
                                </span>
                                <span>
                                    <p>@item.Specialite</p>
                                </span>
                                <ul class="mt-3 list-unstyled d-flex justify-content-center">
                                    <li>
                                        <a class="p-3" target="_blank" href="#">
                                            <i class="ri-facebook-fill"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="p-3" target="_blank" href="#">
                                            <i class="ri-hashtag"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="p-3" target="_blank" href="#">
                                            <i class="ri-linkedin-fill"></i>
                                        </a>
                                    </li>
                                </ul>
                                <a asp-action="Details" asp-route-Id="@item.Id" class="btn btn-outline-primary">Profile</a>
                                <a class="btn btn-outline-success">Whatsapp</a>
                            </div>
                        </div>
                    </div>
                  }
                </div>
            </div>
        </div>
        <!-- App body ends -->
    </div>
</div>

   <a  style="position: fixed;right: 50px;bottom: 45px;" href="/Doctor/Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
   <a  style="position: fixed;right: 110px;bottom: 45px;" href="/Doctor/liste" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-list"></i></a>
