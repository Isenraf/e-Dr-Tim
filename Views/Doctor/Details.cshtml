                            <i class="ri-contract-line fs-1 text-danger"></i>
                          </div>

                          <h6>Type de contrat</h6>
                          <span class="badge bg-danger">@Model.contrat</span>
                        </div>
                      </div>
                      <!-- Card details end -->
                    </div>
                  </div>
                </div>
                <div class="col-xxl-2 col-sm-4">
                  <div class="card mb-3">
