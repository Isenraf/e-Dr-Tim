                        </div>

                        <a href="book-appointment.html" class="btn btn-primary">
                          Prendre rendez-vous
                        </a> *@
                      </div>
                    </div>
                  </div>
                  
                </div>
                 
                </div>
              </div>
              <!-- Row ends -->
            </div>
