@model IEnumerable<BANA.Models.Doctor>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">Liste des parametres</li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- App body starts -->
    <div class="app-body">
        <!-- body body start -->
        <div class="col-sm-12">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Liste des parametres</h5>
                    <button class="btn btn-primary ms-auto" data-bs-toggle="modal" data-bs-target="#addparametre">Nouveau parametres</button>
                </div>

                <!-- Modal ajouter parametres -->
                <div class="modal fade" id="addparametre" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Nouveau Paramètres</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="Create2" method="get">
                            <div class="modal-body text-center">
                                <img style="width: 100px; height: 100px;" class="img-fluid mb-3" src="/template2/assets/images/folder3.png" alt="dossier" />
                                <input class="form-control" name="nd" type="number" placeholder="N° dossier" required />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                <button type="submit" class="btn btn-primary" data-bs-dismiss="modal">Continuer</button>
                            </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- barre de recherche start-->
                    <div class="card">
                        <div class="card-body">
                            <input type="search" class="form-control" placeholder="Bare de Recherche" />
                        </div>
                    </div>
                    <!-- barre de recheche end -->

                    <!-- Table starts -->
                    <div class="table-responsive">
                        <table id="basicExample" class="table truncate m-0 align-middle">
                            <thead>
                                <tr>
                                    <th>No. Dossier</th>
                                    <th>Nom et prenom</th>
                                    <th>Service</th>
                                    <th>Date</th>
                                    <th>Statut du patient</th>
                                    <th>Medecin responsable</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>10208</td>
                                    <td>Allan Stuart</td>
                                    <td>Urgence</td>
                                    <td>12/05/2025</td>
                                    <td>Ambulatoire</td>
                                    <td>Dr. Maelys</td>
                                    <td>
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Supprimer les parametres">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                            <a href="#" class="btn btn-outline-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Modifier les parametres">
                                                <i class="ri-edit-2-line"></i>
                                            </a>
                                            <button href="#" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td>10209</td>
                                    <td>Jhon Garret</td>
                                    <td>Urgence</td>
                                    <td>12/05/2025</td>
                                    <td>Hospitalisé</td>
                                    <td>Dr. Maelys</td>
                                    <td>
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Supprimer les parametres">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                            <a href="#" class="btn btn-outline-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Modifier les parametres">
                                                <i class="ri-edit-2-line"></i>
                                            </a>
                                            <button href="#" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td>10220</td>
                                    <td>Elvis Briam</td>
                                    <td>Urgence</td>
                                    <td>12/05/2025</td>
                                    <td>Sorti</td>
                                    <td>Dr. Maelys</td>
                                    <td>
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Supprimer les parametres">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                            <a href="#" class="btn btn-outline-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Modifier les parametres">
                                                <i class="ri-edit-2-line"></i>
                                            </a>
                                            <button href="#" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Table ends -->

                    <!-- Modal voir parametres -->
                    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">Tous les parametres</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div>
                                        <ul>
                                            <li>
                                                <p>
                                                    N° dossier:
                                                    <span class="text-info">10208</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Nom & Prénom :
                                                    <span class="text-info">Allan Stuart</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Âge :
                                                    <span class="text-info">58</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Sexe :
                                                    <span class="text-info">feminin</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Date de prise :
                                                    <span class="text-info">12/05/2025</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Température (°C) :
                                                    <span class="text-info">Normale entre 36,5 et 37,5°C.</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Tension artérielle (mmHg) :
                                                    <span class="text-info">Format standard "120/80".</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Fréquence cardiaque (bpm) :
                                                    <span class="text-info">Moyenne normale adulte : 60-100.</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Fréquence respiratoire (rpm) :
                                                    <span class="text-info">12-20 chez l’adulte.</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Saturation en O₂ (%) :
                                                    <span class="text-info">Normale ≥ 95 %.</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Poids (kg) :
                                                    <span class="text-info">100.0</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Taille (m) :
                                                    <span class="text-info">1.70</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Commentaire :
                                                    <span class="text-info">Remarques cliniques ou anomalies observées.</span>
                                                </p>
                                            </li>
                                            <li>
                                                <p>
                                                    Sexe :
                                                    <span class="text-info">1000</span>
                                                </p>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- App body ends -->

   
