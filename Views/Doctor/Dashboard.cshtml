@model BANA.Models.Doctor

@{
    ViewData["Title"] = "Details";
    int i=1;
    Layout="_Layout3";
}
 
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Tableau de bord du Médecin
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <!-- Row starts -->
        @if(ViewBag.user.Genre=="Homme"){
             <div class="row gx-3">
                <div class="card mb-3 bg-3">
                    <div class="card-body">
                        <div class="mh-230">
                            <div class="py-4 px-3 text-white">
                                <h6>Bonjour,</h6>
                                <h2>Dr @ViewBag.user.nom</h2>
                                <h5>Votre emploi du temps aujourd'hui.</h5>
                                <div class="mt-4 d-flex gap-3">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-arctic rounded-2 me-3">
                                            <i class="ri-surgical-mask-line fs-4"></i>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <h2 class="m-0 lh-1">0</h2>
                                            <p class="m-0">end attente</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-lime rounded-2 me-3">
                                            <i class="ri-lungs-line fs-4"></i>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <h2 class="m-0 lh-1">0</h2>
                                            <p class="m-0">Terminées</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }else{
             <div class="row gx-3">
                <div class="card mb-3 bg-33">
                    <div class="card-body">
                        <div class="mh-230">
                            <div class="py-4 px-3 text-white">
                                <h6>Bonjour,</h6>
                                <h2>Dr @ViewBag.user.nom</h2>
                                <h5>Votre emploi du temps aujourd'hui.</h5>
                                <div class="mt-4 d-flex gap-3">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-arctic rounded-2 me-3">
                                            <i class="ri-surgical-mask-line fs-4"></i>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <h2 class="m-0 lh-1">0</h2>
                                            <p class="m-0">Rendez-vous</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-lime rounded-2 me-3">
                                            <i class="ri-lungs-line fs-4"></i>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <h2 class="m-0 lh-1">0</h2>
                                            <p class="m-0">Rendez-vous cloturé</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
       
        <!-- Row ends -->

 <!-- Calendar CSS -->
    <link rel="stylesheet" href="/template2/assets/vendor/calendar/css/main.min.css">
    <link rel="stylesheet" href="/template2/assets/vendor/calendar/css/custom2.css">
        <!-- Row starts -->
            <div class="row gx-3">
              <div class="col-sm-12 col-12">
                <div class="card">
                  <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Rendez-vous</h5>
                    <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary ms-auto">ajoutez un Rendez-vous</a>
                  </div>
                  <div class="card-body">

                    <div id="appointmentsCal"></div>

                  </div>
                </div>
              </div>
            </div>
            <!-- Row ends -->
             <!-- Calendar JS -->
    <script src="/template2/assets/vendor/calendar/js/main.min.js"></script>
    <script src="/template2/assets/vendor/calendar/custom/appointments-calendar.js"></script>

@* <!-- Row starts -->
<div class="row gx-3">
    <div class="col-sm-12">
        <div class="card mb-3">
