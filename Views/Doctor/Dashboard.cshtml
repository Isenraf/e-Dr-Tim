                                            <img src="/template2/assets/images/patient1.jpg" class="img-shadow img-2x rounded-5 me-1" alt="Hospital Admin Template" />
                                        }
                                        

                                        @item.Nom @item.Prenom
                                    </td>
                                    <td>@((int)(DateTime.Now-item.DateNaissance).TotalDays/365) ans</td>
                                    
                                    <td>@item.Create_date</td>
                                    <td>
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Accepted">
                                                <i class="ri-checkbox-circle-line"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Reject" disabled>
                                                <i class="ri-close-circle-line"></i>
                                            </button>
                                            <a asp-controller="Patient" asp-action="Details2" asp-route-dossier="@item.Numero_dossier" class="btn btn-outline-info btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Commencer la consultation">
                                                <i class="ri-edit-box-line"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                               
                                
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Table ends -->
            </div>
        </div>
    </div>
   
</div>
<!-- Row ends --> *@

        
                         
                              
  
</div>