@model IEnumerable<BANA.Models.Doctor>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Personnel soignant
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- App body start -->
    <div class="app-body">
        <div class="col-sm-12">
            <div class="card mb-3 px-2">
                <div class="card-header">
                    <div class="d-flex flex-wrap gap-1">
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                            <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                            <span class="me-1 fw-semibold ps-1">@ViewData["Interne"]</span>
                            <span class="text-info">En cours</span>
                        </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                            <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                            <span class="me-1 fw-semibold ps-1">@ViewData["Externe"]</span>
                            <span class="text-info">Terminées</span>
                        </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                            <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                            <span class="me-1 fw-semibold ps-1">@ViewData["total"]</span>
                            <span class="text-info">Total</span>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div id="customButtons_filter" class="dataTables_filter" style="text-align: right; margin-bottom: 5px">
                        <!-- Barre de recherche start -->
                        <div class="row gx-3 gy-3">
                            <div class="card">
                                <form asp-controller="Doctor" asp-action="Index"  method="get">
                                    <div class="card-body">
                                        <input type="search" id="search" name="target" class="form-control" placeholder="Barre de Recherche" />
                                    </div>
                                </form>
                            </div>
                            <!-- Barre de recherche end -->
                        </div>
                    </div>
                </div>




                <!-- Row starts -->
<div class="row gx-3">
    <div class="col-sm-12">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="card-title">Liste des patients</h5>
            </div>
            <div class="card-body">
                <!-- Table starts -->
                <div class="table-outer">
                    <div>
                        <table class="table m-0 align-middle">
                            <thead>
                                <tr>
                                     <th>Actions</th>
                                    <th>#Dossier</th>
                                    <th>Nom du patient</th>
                                    <th style="width: 70px;">Âge</th>
                                    <th>Date</th>
                                   
                                </tr>
                            </thead>

                            <tbody>
                            @foreach(var item in ViewBag.factures){
                                 <tr>
                                    <td>
                                    <button type="button" onclick="location.href='/Patient/Details2?fact=@item.Numero_de_facture'" class="btn btn-primary">Commencer la consultation</button>
                                        <div class="d-inline-flex gap-1">
                                            <div class="btn-group">
                                                <button type="button"  class="btn btn-warning" data-bs-toggle="dropdown" aria-expanded="false">Transférer le patient</button>
                                                <button type="button" class="btn btn-warning dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span class="visually-hidden"><option value=""></option></span>
                                                </button>
                                                <ul class="dropdown-menu" style="padding: 10px; width: 250px;">
                                                    <li><a class="dropdown-item" href="#">Transférer</a></li>
                                                    <li><hr class="dropdown-divider"></li>

                                                    <li>
                                                        <input type="text" 
                                                            style="margin-bottom: 10px;" 
                                                            class="form-control med" 
                                                            placeholder="Choisir un médecin..."
                                                            list="medecins">

                                                        <datalist id="medecins">
                                                            @foreach (var item2 in ViewBag.medecins)
                                                            {
                                                                <option value="@item2.Nom @item2.Prenom">@item2.Specialite</option>
                                                            }
                                                        </datalist>
                                                    </li>

                                                    <li>
                                                        <input type="hidden" class="facture" value="@item.Numero_de_facture">
                                                        <button type="button" class="btn btn-primary transfert_go w-100">
                                                            Transférer
                                                        </button>
                                                    </li>
                                                </ul>

                                            </div>
                                            
                                            
                                        </div>
                                    </td>
                                    <td>@item.Numero_dossier</td>
                                    <td>
                                        @if(item.Genre=="M"){
                                            <img src="/template2/assets/images/patient2.png" class="img-shadow img-2x rounded-5 me-1" alt="Hospital Admin Template" />
                                        }else{
                                            <img src="/template2/assets/images/patient1.jpg" class="img-shadow img-2x rounded-5 me-1" alt="Hospital Admin Template" />
                                        }
                                        

                                        @item.Nom @item.Prenom
                                    </td>
                                    <td>@((int)(DateTime.Now-item.DateNaissance).TotalDays/365) ans</td>
                                    
                                    <td>@item.Create_date</td>
                                    
                                </tr>
                            }
                               
                                
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Table ends -->
            </div>
        </div>
    </div>
   
</div>
<!-- Row ends -->


                
                
        </div>
        <!-- App body ends -->
    </div>
</div>

  