@model IEnumerable<BANA.Models.Service>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="/css/services.css">
 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-controller="Departement" asp-action="Index">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Actes medicaux
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["total"]</span>
                      <span class="text-info">Nombre total de services</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["min"] FCFA</span>
                      <span class="text-info">Montant minimum de service</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["max"] FCFA</span>
                      <span class="text-info">Montant maximal du service</span>
                    </div>
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!-- barre de recherche start-->
                    <div class="card">
                        <div class="card-body">
                          <input
                            type="search"
                            id="search"
                            class="form-control"
                            placeholder="Bare de Recherche"
                          />
                        </div>
                      </div>
                      <!-- barre de recheche end -->
                  </div>
                </div>
             

              <div id="testfiltre" class="row gx-3 px-2">

                @foreach (var item in Model)
                  {
                          <div class="montest col-xl-2 col-sm-6">
                            <div class="card border-0 bg-primary mb-3 mx-2">
                              <div class="card">
                                <div class="card-body">
                                  <h6 class="mt-3 mb-0">@item.Nom</h6>

                                  <div>
                                    <h6><span class="separateur">@((int)item.Montant)</span> FCFA</h6>
                                  </div>

                                  <p style="font-size: small">@item.Departement</p>

                                  <div
                                    class="d-flex align-items-center justify-content-between mt-3"
                                  >
                                    <a class="btn btn-outline-primary" asp-action="Details" asp-route-Id="@item.Id">Afficher</a>
                                    <div class="">
                                      <img width="40px" class="sm" src="/template/assets/images/xs/d1.png" data-toggle="tooltip" title="" data-original-title="Avatar"/>
                                    </div>

                                     <div class="dropdown card-btn-floating" style="position: absolute;right: 16px;top: 10px;">
                                        <div class="btn-white" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                                            <i class="ri-more-2-fill"></i>
                                        </div>
                                        
                                        <ul class="dropdown-menu" style="padding: 10px;background-color: #126aef;">
                                            
                                              <li>
                                              <a style="color: white;" asp-action="Edit" asp-route-Id="@item.Id">Modifier</a>
                                              </li>
                                              
                                              <li>
                                              <a style="color: white;" asp-action="Delete" asp-route-Id="@item.Id">Supprimer</a>
                                              </li>
                                        </ul>
                                    </div>
                                    
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>

                  }
                

               
               

              </div>
            </div>
            </div>
          </div>
            <!-- App body ends -->
          </div>

<a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
