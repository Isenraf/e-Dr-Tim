@model BANA.Models.Service

@{
    ViewData["Title"] = "Delete";
}



 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Actes medicaux
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <h5 class="card-title">
                    Polyclinique de Poitiers<br /><h7
                      style="font-size: 12px; color: #4c545e"
                      >Supprimer un Acte Médical,</h7
                    >
                  </h5>
                </div>

                <div class="card-body">
                    <div id="ident_medecin"  class="alert bg-danger text-white alert-dismissible  align-items-center fade show" role="alert">
                    <i class="ri-checkbox-circle-line fs-3 me-2 lh-1"></i>Attention: Cette action est Irréversible.
                </div>

                  <form asp-action="Delete">
                    <div class="row gap-3">
                      @if (ViewData["error"]!=null)
                      {
                        <div class="alert alert-danger" role="alert">
                          Cette élément existe déjà !
                        </div>
                      }
                      <div class="row">
                        <div class="card-header">
                            Informations Générales
                        </div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Nom" />
                        <div class="col-sm-4 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2"
                                >Nom de service
                                <span class="text-danger">*</span>
                              </label>
                              <input asp-for="Nom" class="form-control" style="height: 50px; border: #c3dff1" class="form-control" disabled>
                               <span asp-validation-for="Nom" class="text-danger"></span>
                              
                            </div>
                          </div>
                        </div>
                        <div class="col-sm-4 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2"
                                >cote
                                <span class="text-danger">*</span>
                              </label>
                              <input asp-for="Cote" class="form-control"  style="height: 50px; border: #c3dff1" disabled>
                              <span asp-validation-for="Cote" class="text-danger"></span>
                            </div>
                          </div>
                        </div>
                        <div class="col-sm-4 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2">Catégorie <span class="text-danger">*</span></label>
                              <input list="departement" asp-for="Departement" style="height: 50px; border: #c3dff1" class="form-control" autocomplete="off" disabled>
                              
                              
                            </div>
                          </div>
                        </div>
                        <div class="col-lg-12 mb-3">
                            <textarea style="height: 100px;"   class=" form-control" name="" id=""placeholder="Description du service" disabled></textarea>
                        </div>
                        <div class="card-header">
                            Informations de Paiement
                        </div>
                        <div class="col-md-6 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2">Montant<span class="text-danger">*</span></label>
                              <input asp-for="Montant" class="form-control" style="height: 50px; border: #c3dff1"  placeholder="Entrer le montant" disabled>
                              <span asp-validation-for="Montant" class="text-danger"></span>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2" >Catégorie<span class="text-danger">*</span></label>
                              <div class="input-group">
                                <select asp-for="Categorie" class="form-control" style="height: 50px; border: #c3dff1" disabled>
                                  <option asp-for="Categorie" value="">- Selectionner -</option>
                                  <option asp-for="Categorie" value="Consultation">Consultation</option>
                                  <option asp-for="Categorie" value="Actes">Actes</option>
                                </select>
                              </div>
                               <span asp-validation-for="Categorie" class="text-danger"></span>
                            </div>
                          </div>
                        </div>
                       
                      </div>
                    </div>
                    <div class="form-check">
                      
                      <input
                        class="form-check-input"
                        type="checkbox"
                        asp-for="Actif"
                        id="flexCheckDefault" disabled
                      />
                      <label class="form-check-label" for="flexCheckDefault"
                        >Activer le service</label
                      >
                    </div>
                    

                    <div style="display: flex; justify-content: end; gap: 10px">
                      <button type="submit" class="btn btn-danger">
                        <i class="ri-save-3-line"></i>Confirmer la Suppression définitive
                      </button>
                      <div class="d-flex flex-wrap gap-2">
                        <button type="reset" class="btn btn-outline-secondary">
                          Annuler
                        </button>
                      </div>
                    </div>

                    
                  </form>
                </div>
              </div>
            </div>
            <!-- app body end-->
          </div>
