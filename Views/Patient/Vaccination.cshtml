@model BANA.Models.Patient

@{
    ViewData["Title"] = "Details";
     Layout="_Layout3";
}


<style>
    

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        bottom: 100%; /* place le menu au-dessus */
        left: -20px; /* décale un peu vers la gauche */
        background-color: #fff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
        z-index: 1;
      }

      .dropdown-content button {
        display: block;
        margin: 5px 0;
        text-align: left;
        padding: 8px;
        border: none;
        background-color: #eee;
        cursor: pointer;
        border-radius: 4px;
      }

      .dropdown-content button:hover {
        background-color: #ddd;
      }

      .dropdown.show .dropdown-content {
        display: block;
      }

      button.main-btn {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>
<link href="/css/stock2.css" rel="stylesheet">
<input type="hidden" id="dossier" value="@Model.Numero_dossier">
<!-- App container starts -->
        <div class="app-container">
            <!-- App hero header starts -->
            <div class="app-hero-header d-flex align-items-center">
                <!-- Breadcrumb starts -->
                
                
                <!-- Breadcrumb ends -->

                <!-- Sales stats starts -->
                <div class="d-lg-flex d-none flex-row">
                    <div class="d-flex flex-row gap-1 day-sorting">
                        
                        <div class="d-flex align-items-center">
                            <div class="icon-box lg bg-primary rounded-5 me-2">
                                <i class="ri-account-circle-line fs-3"></i>
                            </div>
                                <div>
                                    <p class="m-0">Nom du patient</p>
                                    <h5 class="mb-1">@Model.Nom @Model.Prenom</h5>
                                    
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-box lg bg-primary rounded-5 me-2">
                                    @if(Model.Genre=="M"){<i class="ri-men-line fs-3"></i>}else{<i class="ri-women-line fs-3"></i>}
                                </div>
                                <div>
                                    <p class="m-0">Genre</p>
                                    <h5 class="mb-1">@Model.Genre</h5>
                                    
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-box lg bg-primary rounded-5 me-2">
                                    <i class="ri-arrow-right-up-line fs-3"></i>
                                </div>
                                <div>
                                    <p class="m-0">Âge du patient</p>
                                    <h5 class="mb-1">@((int)(DateTime.Now-Model.DateNaissance).TotalDays/365) ans</h5>
                                    
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-box lg bg-primary rounded-5 me-2">
                                    <i class="ri-contrast-drop-2-line fs-3"></i>
                                </div>
                                <div>
                                    <p class="m-0">Groupe sanguin</p>
                                    <h5 class="mb-1">@Model.GroupeSanguin</h5>
                                    
                                </div>
                            </div>
                            @if(Model.Genre=="M"){
                                <img style="width: 60px;height: 60px;" src="/template2/assets/images/patient2.png" class="ms-auto" alt="@Model.Nom @Model.Prenom" />
                            }else{
                                <img style="width: 60px;height: 60px;" src="/template2/assets/images/patient1.jpg" class="ms-auto" alt="@Model.Nom @Model.Prenom" />
                            }
                                       
                    </div>
                </div>
                <!-- Sales stats ends -->
            </div>
            <!-- App Hero header ends -->



