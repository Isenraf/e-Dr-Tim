@model BANA.Models.Patient

@{
    ViewData["Title"] = "Details";
}


<style>
    

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        bottom: 100%; /* place le menu au-dessus */
        left: -20px; /* décale un peu vers la gauche */
        background-color: #fff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
        z-index: 1;
      }

      .dropdown-content button {
        display: block;
        margin: 5px 0;
        text-align: left;
        padding: 8px;
        border: none;
        background-color: #eee;
        cursor: pointer;
        border-radius: 4px;
      }

      .dropdown-content button:hover {
        background-color: #ddd;
      }

      .dropdown.show .dropdown-content {
        display: block;
      }

      button.main-btn {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>

<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Profil du Patient
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <div class="card px-3 py-3">
            <!-- Row starts -->
            <div class="row gx-3">
                <div class="col-sm-12">
                     <div class="d-flex justify-content-end gap-2 my-2">
                        <a class="btn btn-primary me-2" asp-action="Edit" asp-route-Id="@Model.Id">Modifier le patient</a>
                        <a class="btn btn-light" onclick="history.back()" href="#">Retour</a>
                    </div> 

                    <div class="card mb-3">
                        <div class="card-body">

                          <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle" style="width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Pharmacie
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=medicament_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=medicament_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle btn" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Examen
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=examens_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=examens_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Génerique
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=generique_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=generique_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Consultation
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=consultation_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=consultation_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle"  style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Actes médicaux
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=actes_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=actes_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                             <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Hospitalisation
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=hospi_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=generique_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div>
                                    <button class="btn btn-primary" onclick="location.href='/Facture/Create3?nd=@Model.Numero_dossier&target=caution';" style="width: 280px;padding: 10px;" type="button"
                                    aria-expanded="false">
                                    Créer Facture Caution
                                    </button>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary  dropdown-toggle" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Proforma
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=proforma_assurance">Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=proforma_0">non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary  dropdown-toggle" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Facture Dentiste
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=dentiste_assurance">Facture Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=dentiste_0">Factcture non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                             <!-- Example Dropdown Button -->
                            <div class="btn-group">
                                <div class="dropdown">
                                    <button class="btn btn-primary  dropdown-toggle" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    Créer Proforma Dentiste
                                    </button>
                                    <ul style="width: 280px;" class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Facture/Create2?nd=@Model.Numero_dossier&target=proforma_dentiste_assurance">Proforma Assuré</a></li>
                                    <li><a class="dropdown-item" href="/Facture/Create?nd=@Model.Numero_dossier&target=proforma_dentiste_0">Proforma non Assuré</a></li>
                                    </ul>
                                </div>
                            </div>

                            
                            
                            <button type="button" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;"  onclick="location.href='/Resultat/Index?target=@Model.Numero_dossier';" class="btn btn-primary">
                                Resultats Examens
                            </button>
                           
                            <button type="button" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" onclick="location.href='/Patient/Fusion/@Model.Id';" class="btn btn-primary">
                                Fusionner Details factures
                            </button>
                            <button type="button" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" onclick="location.href='/facture/Caution?target=@Model.Numero_dossier';" class="btn btn-primary">
                                Proformas
                            </button>
                            <button type="button" style="margin-top: 2px;margin-bottom: 2px;width: 280px;padding: 10px;" onclick="location.href='/facture/index5?target=@Model.Numero_dossier';"  class="btn btn-primary">
                                Cautions. 
                            </button>
                            
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex">
                                <!-- Stats starts -->
                                <div class="d-flex align-items-center flex-wrap gap-4">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-account-circle-line fs-3"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-1">@Model.Nom</h4>
                                            <p class="m-0">Nom du patient</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-women-line fs-3"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-1">@Model.Genre</h4>
                                            <p class="m-0">Genre</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-arrow-right-up-line fs-3"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-1">@((int)((DateTime.Now-Model.DateNaissance).TotalDays/365)) ans  @((int)(((DateTime.Now-Model.DateNaissance).TotalDays%365)/30)) mois @((((int)(DateTime.Now-Model.DateNaissance).TotalDays)%365)%30) jours</h4>
                                            <p class="m-0">Âge du patient</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-contrast-drop-2-line fs-3"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-1">@Model.GroupeSanguin</h4>
                                            <p class="m-0">Groupe sanguin</p>
                                        </div>
                                    </div>
                                </div>
                                <!-- Stats ends -->
                                 @if(Model.Genre=="M"){
                                      <img style="width: 100px;height: 100px;" src="/template2/assets/images/patient2.png" class="ms-auto" alt="@Model.Nom @Model.Prenom" />
                                    }else{
                                      <img style="width: 100px;height: 100px;" src="/template2/assets/images/patient1.jpg" class="ms-auto" alt="@Model.Nom @Model.Prenom" />
                                    }
                               
                                     
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row ends -->
            <!-- Row starts -->
            <div class="row gx-3">
                <div class="col-xxl-6 col-sm-6 col-12">
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="text-center">
                                <div class="mt-3">
                                    <h5>GENERALE</h5>
                                </div>
                            </div>

                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>Solde</div>
                                    <div>@ViewData["solde"] FCFA</div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>Telephone</div>
                                    <div>@Model.Phone</div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>Date de naissance</div>
                                    <div>@Model.DateNaissance.ToShortDateString()</div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xxl-6 col-sm-6 col-12">
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="text-center">
                                <div class="mt-3">
                                    <h5>Autres Informations</h5>
                                </div>
                            </div>

                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>Adresse Mail</div>
                                    <div>@Model.Email</div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>Profession</div>
                                    <div>@Model.Profession</div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>Autres contacts</div>
                                    <div>@Model.AutresContact</div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row ends -->
            <div class="row gx-3">
                <div class="col-lg-6 col-sm-12">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="card-title">Factures patient</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-outer">
                                <div class="table-responsive">
                                    <table class="table align-middle truncate m-0">
                                        <thead>
                                            <tr>
                                                <th>Statut</th>
                                                <th>Facture</th>
                                                <th>Montant</th>
                                                <th>Docteur</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in ViewBag.factures)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (item.Etat_patient=="En attente Paiement" && (item.Intervenant=="" || item.Intervenant==null))
                                                            {
                                                            if (item.Type!=null && item.Type.Contains("assurance"))
                                                            {
                                                                <button onclick="location.href='/Facture/Edit2/@item.Id?nd=@item.Numero_dossier'+'&target=@item.Type';" type="button" class="btn btn-outline-secondary" title="modifier la facturee">
                                                                <i class="fa fa-edit"></i>
                                                                </button>
                                                            }else
                                                            {
                                                                <button onclick="location.href='/Facture/Edit/@item.Id?nd=@item.Numero_dossier'+'&target=@item.Type';" type="button" class="btn btn-outline-secondary" title="modifier la facturee">
                                                                <i class="fa fa-edit"></i>
                                                                </button>
                                                            }
                                                            
                                                            }else if((item.Intervenant!="" || item.Intervenant!=null) && (item.Type=="medicament_assurance")){
                                                            <button onclick="location.href='/Facture/Edit2/@item.Id?nd=@item.Numero_dossier'+'&target=@item.Type';" type="button" class="btn btn-outline-secondary" title="modifier la facture">
                                                                <i class="fa fa-edit"></i>
                                                                </button>
                                                            }
                                                            @if (item.Type.Contains("medicament"))
                                                            {
                                                            <button onclick="location.href='/Facture/Details3/@item.Id';" type="button" style="background-color: #e5e64782;" class="btn btn-outline-secondary " title="afficher la facture">
                                                                <i class="fa fa-eye"></i>
                                                            </button>
                                                            }else if(item.Type.Contains("assurance")){
                                                            <button  type="button" style="background-color: #0ebb134f;" onclick="location.href='/Facture/Details4/@item.Id';" class="btn btn-outline-secondary" title="afficher la facture">
                                                                <input type="hidden" value="assurance">
                                                                <i class="fa fa-eye"></i>
                                                            </button>

                                                            <button  type="button" class="btn btn-outline-secondary" onclick="location.href='/Facture/Details/@item.Id';" title="afficher la facture">
                                                                <input type="hidden" value="cash">
                                                                <i class="fa fa-eye"></i>
                                                            </button>

                                                            }else{
                                                            <button  type="button"  class="btn btn-outline-secondary" onclick="location.href='/Facture/Details/@item.Id';" title="afficher la facture">
                                                                <input type="hidden" value="cash">
                                                                <i class="fa fa-eye"></i>
                                                            </button>
                                                            }
                                                    </td>
                                                    <td>@item.Numero_de_facture</td>
                                                    <td>@item.Net_a_payer_patient FCFA</td>
                                                    <td>@item.Medecin</td>
                                                    <td>@item.Create_date.ToString("dd/MM/yyyy")</td>
                                                </tr>
                                            }
                                            
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-12">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="card-title">Resultats d'examens</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-outer">
                                <div class="table-responsive">
                                    <table class="table align-middle truncate m-0">
                                        <thead>
                                            <tr>
                                                <th>Nommination</th>
                                                <th>Resultat</th>
                                                <th>Statuts</th>
                                                <th>Date</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in ViewBag.Resultat)
                                            {
                                            <tr>
                                                <td>
                                                    <div class="ml-3">
                                                        <a asp-controller="Resultat" asp-action="Details" asp-route-Id="@item.Id" title="">@item.Nom</a>
                                                        <p class="mb-0">@item.Categorie</p>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (@item.resultat_final=="Positif"){<span style="color: red;font-weight: bold;">@item.resultat_final</span>}else{<span style="color: green;font-weight: bold;">@item.resultat_final</span>}
                                                </td>
                                                <td>
                                                    @if (item.valide_par!=null){<span class="badge border border-success text-success">Cloturé</span>}else{<span class="badge border border-warning text-warning">En cours</span>}
                                                </td>
                                                <td>@item.Create_date.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <div class="d-inline-flex gap-1">
                                                        <button onclick="location.href='/Resultat/Edit/@item.Id';" class="btn btn-info btn-sm">
                                                            <i class="ri-eye-fill"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                           }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row starts -->
            <!-- modal itself -->
            <form class="myForm" action="">
                <div class="modal fade" id="reg-modal" tabindex="-1" aria-labelledby="modal-title" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modal-title">
                                    Selectionnez le type de facture
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body text-center">
                                <button type="" class="btn btn-primary my-2"><i class="ri-first-aid-kit-line"></i>Avec prise en compte assurance</button>
                                <button type="" class="btn btn-success my-2 mb-4"><i class="ri-cash-line"></i>Sans prise en compte asurance</button>
                                <div class="modal-footer"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <!-- Row ends -->
        </div>
        <!-- App body ends -->
    </div>
</div>

