<style>
      .a4-container {
        position: relative;
        width: 633px;
        height: 792px;
        border: 1px solid #ccc;
        margin: 0px auto;

        background-image: url("/template2/fiche5/pc1.jpg");
        background-position: center;
        background-repeat: no-repeat;
        background-size: contain;
      }

      .data-point {
        position: absolute;
        width: 5px;
        height: 5px;
        background-color: #364fc7;
        border-radius: 50%;
        transform: translate(-50%, -50%);
      }

      .table {
        width: 254px;
        height: 125px;
        table-layout: fixed;
        font-size: 9px;
        position: absolute;
        left: 67px;
        bottom: 576px;
        /* left: 230px;
        bottom: 18px; */
      }
      table{
        background-color: #fff;
       }

      th,
      td {
        border: 1px solid black;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      table,
      th,
      td {
        border: 1px solid #b93a73 !important;
      }

      thead th {
        background-color: #b93a73 !important;
        color: #fff !important;
      }

      td[contenteditable]:focus {
        border: none !important;
        outline: none !important;
      }

      td {
        padding: 0 !important;
      }

      @@media print {
        body * {
          visibility: hidden;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .card,
        .card * {
          visibility: visible;
        }

        .card {
          position: absolute;
          left: 0;
          top: 0;
          box-shadow: none;
        }

        /* Hide buttons */
        .card button,
        .custom-daterange {
          visibility: hidden !important;
        }

        /* Force hide the last column header & cells */
        .card table th:last-child,
        .card table td:last-child {
          display: none !important;
          visibility: hidden !important;
        }
      }
    </style>

