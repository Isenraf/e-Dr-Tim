<!-- hidden table -->
                  <table id="hidden-data" style="display: none">
                    <thead>
                      <tr>
                        <th>Date</th>
                        <th>Age</th>
                        <th>Poids</th>
                        <th>Taille</th>
                        <th>Périmètre crânien</th>
                        <th>Observations</th>
                      </tr>
                    </thead>
                    <tbody>
                      @foreach(var item in ViewBag.parametres){
                        <tr>
                          <td>@item.Create_date.ToShortDateString()</td>
                          <td>@(((item.Create_date.Year - Model.DateNaissance.Year) * 12) + item.Create_date.Month - Model.DateNaissance.Month)</td>
                          <td>@item.Poids</td>
                          <td>@item.Taille</td>
                          <td>@item.Pc</td>
                          <td>RAS</td>
                        </tr>
                      }
                    </tbody>
                  </table>
<!-- My script -->
  
  
  <script>
      const hiddenTable = document.querySelector("#hidden-data");
      const visibleTable = document.querySelector("table");
      const rows = visibleTable.querySelectorAll("tbody tr");
      const a4Container = document.querySelector(".a4-container");
      const state = [];

      // 1. Extract data from hidden table into state
      function loadHiddenData() {
        const hiddenRows = hiddenTable.querySelectorAll("tbody tr");
        hiddenRows.forEach((row) => {
          const cells = row.querySelectorAll("td");
          if (cells.length >= 4) {
            state.push({
              age: parseFloat(cells[1].textContent) || "",
              poids: parseFloat(cells[2].textContent) || "",
              taille: parseFloat(cells[3].textContent) || "",
            });
          }
        });
      }

      // 2. Fill visible table with the 7 most recent entries
      function fillVisibleTable() {
        const latestData = state.slice(-7).reverse();
        latestData.forEach((entry, i) => {
          if (rows[i]) {
            const cells = rows[i].querySelectorAll("td");
            cells[0].textContent = new Date().toLocaleDateString();
            cells[1].textContent = ⁠ ${entry.age} ans ⁠;
            cells[2].textContent = ⁠ ${entry.poids} kg ⁠;
            cells[3].textContent = ⁠ ${entry.taille} cm ⁠;
            cells[4].textContent = "—";
          }
        });
      }

      function calculate(data) {
        totalCm =
          data.taille && (((data.taille - 80) / 110) * 0.5593 + 0.2828) * 100;

        totalMonths =
          data.age && (((data.age - 2) / 18) * 0.6098 + 0.1864) * 100;

        totalKg =
          data.poids && (((data.poids - 10) / 95) * 0.4823 + 0.1048) * 100;

        return { totalCm, totalMonths, totalKg };
      }

      function render() {
        state.forEach((data) => {
          const { totalCm, totalMonths, totalKg } = calculate(data);

          // taille
          if (totalCm && totalMonths) {
            a4Container.insertAdjacentHTML(
              "beforeend",
              ⁠ <div class="data-point" style="left: ${totalMonths}%; bottom: ${totalCm}%"></div> ⁠
            );
          }

          // poids
          if (totalKg && totalMonths) {
            a4Container.insertAdjacentHTML(
              "beforeend",
              ⁠ <div class="data-point" style="left: ${totalMonths}%; bottom: ${totalKg}%"></div> ⁠
            );
          }
        });
      }

      // === On page load ===
      window.addEventListener("DOMContentLoaded", () => {
        loadHiddenData();
        console.log(state);

        render();
        fillVisibleTable();
      });
    </script>