@model BANA.Models.Patient

@{
    ViewData["Title"] = "Details";
     Layout="_Layout3";
}


<style>
    

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        bottom: 100%; /* place le menu au-dessus */
        left: -20px; /* décale un peu vers la gauche */
        background-color: #fff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
        z-index: 1;
      }

      .dropdown-content button {
        display: block;
        margin: 5px 0;
        text-align: left;
        padding: 8px;
        border: none;
        background-color: #eee;
        cursor: pointer;
        border-radius: 4px;
      }

      .dropdown-content button:hover {
        background-color: #ddd;
      }

      .dropdown.show .dropdown-content {
        display: block;
      }

      button.main-btn {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>
<link href="/css/stock2.css" rel="stylesheet">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Vaccination
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <div class="card px-3 py-3">
            <!-- Row starts -->
            <div class="row gx-3">
                <div class="col-sm-12">
                     <div class="d-flex justify-content-end gap-2 my-2">
                        <a class="btn btn-light" onclick="history.back()" href="#">Retour</a>
                    </div> 

                     <!-- Example Dropdown Button -->
                            


                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex">
                                <!-- Stats starts -->
                                <div class="d-flex align-items-center flex-wrap gap-4">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-account-circle-line fs-3"></i>
                                        </div>
                                        <div>
                                            <p class="m-0">Nom du patient</p>
                                            <h4 class="mb-1">@Model.Nom</h4>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-women-line fs-3"></i>
                                        </div>
                                        <div>
                                            <p class="m-0">Genre</p>
                                            <h4 class="mb-1">@Model.Genre</h4>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-arrow-right-up-line fs-3"></i>
                                        </div>
                                        <div>
                                            <p class="m-0">Âge du patient</p>
                                            <h4 class="mb-1">@((int)((DateTime.Now-Model.DateNaissance).TotalDays/365)) ans  @((int)(((DateTime.Now-Model.DateNaissance).TotalDays%365)/30)) mois @((((int)(DateTime.Now-Model.DateNaissance).TotalDays)%365)%30) jours</h4>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box lg bg-primary rounded-5 me-2">
                                            <i class="ri-contrast-drop-2-line fs-3"></i>
                                        </div>
                                        <div>
                                            <p class="m-0">Groupe sanguin</p>
                                            <h4 class="mb-1">@Model.GroupeSanguin</h4>
                                        </div>
                                    </div>
                                </div>
                                <!-- Stats ends -->
                                 @if(Model.Genre=="M"){
                                      <img style="width: 100px;height: 100px;" src="/template2/assets/images/patient2.png" class="ms-auto" alt="@Model.Nom @Model.Prenom" />
                                    }else{
                                      <img style="width: 100px;height: 100px;" src="/template2/assets/images/patient1.jpg" class="ms-auto" alt="@Model.Nom @Model.Prenom" />
                                    }
                               
                                     
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Row ends -->

         
               <div class="row gx-3 px-2">
                  <div class="wrapper">
                    <div id="testfiltre"  class="grid">
                        
                         @if(Model.Genre=="M"){
                            <div   class="item montest">
