                                  <div>
                                      <img  width="100px" height="100px" src="/template2/fiche5/bebecr.webp" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">Fiche de croissance de <br> l'enfant de 0 à 2 ans</h6>
                                </div>
                                </a>
                            </div>

                            <div   class="item montest">
                              <a asp-action="Fichev6" asp-route-Id="@Model.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/fiche5/bebecr.webp" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">Fiche de croissance <br> adolesent de 2 à 20 ans</h6>
                                </div>
                                </a>
                            </div>

                            <div   class="item montest">
                              <a asp-action="Fichev7" asp-route-Id="@Model.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/fiche5/bebecr.webp" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">périmètre crânien <br>  de 0 à 2 ans</h6>
                                </div>
                                </a>
                            </div>

                         }else{
                            <div   class="item montest">
                              <a asp-action="Fichev55" asp-route-Id="@Model.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/fiche5/bebecr.webp" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">Fiche de croissance de <br> l'enfant de 0 à 2 ans</h6>
                                </div>
                                </a>
                            </div>

                            <div   class="item montest">
                              <a asp-action="Fichev66" asp-route-Id="@Model.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/fiche5/bebecr.webp" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">Fiche de croissance <br> adolesent de 2 à 20 ans</h6>
                                </div>
                                </a>
                            </div>

                            <div   class="item montest">
                              <a asp-action="Fichev77" asp-route-Id="@Model.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/fiche5/bebecr.webp" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">périmètre crânien <br>  de 0 à 2 ans</h6>
                                </div>
                                </a>
                            </div>
                         }
                            

                    </div>
                </div> 
            </div>
            <!-- Row starts -->
        </div>
        <!-- App body ends -->
    </div>
</div>


<style>
  /* Modale */
      .modal, .modal2{
      display: none;
      position: fixed;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
      position: relative;
      background-color: #fff;
      margin: 5% auto;
      padding: 0;
      width: 80%;
      height: 80%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      }

      .modal-header {
      padding: 10px;
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .modal-body {
      flex: 1;
      overflow: hidden;
      }

      .modal iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .modal2 iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .close-btn {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      }
</style>

<!-- Modal -->
<div id="pdfModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
    <div style="margin-left: 20px;" class="btn-group">
      <button type="button" class="btn btn-primary">Enregistrer</button>
        <button type="button" class="btn btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="visually-hidden">Enregistrer</span>
        </button>
        <ul class="dropdown-menu" style="">
        <li><a class="dropdown-item" href="#">Signez le document</a></li>
        <li><a class="dropdown-item" href="#">Signez et envoyer</a></li>
        </ul>
    </div>
    
    <button class="close-btn" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
    <iframe id="target" src=""></iframe> <!-- Remplace par ton PDF -->
    </div>
  </div>
</div>



<script>
    const modal = document.getElementById('pdfModal');

    function closeModal() {
      modal.style.display = 'none';
      document.getElementById("target").setAttribute("src", "");
    }

    // Fermer si on clique en dehors du contenu
    window.onclick = event => {
      if (event.target === modal) {
        closeModal();
      }
    };
</script>
