@model BANA.Models.Patient

@{
    ViewData["Title"] = "Details";
     Layout="_Layout3";
}


<style>
    

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        bottom: 100%; /* place le menu au-dessus */
        left: -20px; /* décale un peu vers la gauche */
        background-color: #fff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
        z-index: 1;
      }

      .dropdown-content button {
        display: block;
        margin: 5px 0;
        text-align: left;
        padding: 8px;
        border: none;
        background-color: #eee;
        cursor: pointer;
        border-radius: 4px;
      }

      .dropdown-content button:hover {
        background-color: #ddd;
      }

      .dropdown.show .dropdown-content {
        display: block;
      }

      button.main-btn {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>
<link href="/css/stock2.css" rel="stylesheet">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Vaccination
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

   <!-- App body starts -->
          <div class="app-body">
            <div class="col-sm-12">
               <div class="d-flex justify-content-end gap-2 my-2">
                        <a class="btn btn-light" onclick="history.back()" href="#">Retour</a>
                    </div> 
              <div class="card">
                <div
                  class="card-header d-flex justify-content-between align-items-center"
                >
                  <h5 class="card-title mb-0">
                    CALENDRIER DE VACCINATION DE ADOLESCENT(E)
                  </h5>
                </div>

                <div class="card-body">
                  <div class="">
                    <div class="table-responsive mb-3">
                      <table
                        class="table table-bordered truncate m-0 text-center"
                        style="vertical-align: middle"
                      >
                        <caption>
                          *dose unique (un seul contact) pour le vaccin contre
                          le HPV
                        </caption>
                        <thead>
                          <tr>
                            <th>Contact</th>
                            <th>Age</th>
                            <th>Vaccin</th>
                            <th>Voie d'administration</th>
                            <th>Maladies evitables</th>
                            <th>Statut</th>
                          </tr>
                        </thead>

                        <tbody>
                          <!-- 01 -->
                          <tr>
                            <th>Contact unique</th>
                            <td>9 ans*</td>
                            <td>
                              Vaccin anti HPV contre les types 6, 11, 16, 18
                            </td>
                            <td>Intramusculaire</td>
                            <td>
                              <ul
                                style="
                                  list-style-position: outside;
                                  margin: 0;
                                  text-align: left;
                                "
                              >
                                <li>
                                  Cancers du col de l'uterus, de l'anus, de la
                                  gorge, du penis
                                </li>
                                <li>Condylomes ou verrues ano-genitales</li>
                              </ul>
                            </td>
                            <td>
                              <input type="checkbox" class="form-check-input" />
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- App body ends -->
</div>







