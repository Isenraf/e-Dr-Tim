          // Vérifie si la dent est déjà sélectionnée
          if (selectedTeeth.includes(id)) {
            // Si déjà sélectionnée, on la désélectionne
            selectedTeeth = selectedTeeth.filter((toothId) => toothId !== id);
            $(".child-tooth-" + id + "-parent").css("fill", "white");
            $(".tooth-" + id + "-parent").css("fill", "white");
          } else {
