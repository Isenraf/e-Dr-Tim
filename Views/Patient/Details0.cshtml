    <!-- CSS pour tags -->
    <style>
      .bootstrap-tagsinput {
        display: flex;
        flex-wrap: wrap; /* permet d’aller à la ligne */
        align-items: flex-start;
      }

      .bootstrap-tagsinput .tag {
        white-space: nowrap; /* empêche la coupure des mots */
        display: inline-flex; /* garde les boutons sur la même ligne que le texte */
        align-items: center;
        margin: 2px;
        padding: 2px 45px 2px 8px; /* espace pour les boutons */
        border-radius: 5px;
        background: #0d6efd;
        color: #fff;
        position: relative;
      }

      /* Bouton Supprimer */
      .bootstrap-tagsinput .tag [data-role="remove"] {
        position: absolute;
        right: 0px;
        top: 5;
        cursor: pointer;
        color: #fff;
        font-weight: bold;
      }
      .bootstrap-tagsinput .tag [data-role="remove"]:after {
        content: "❌";
      }

      /* Bouton Valider */
      .bootstrap-tagsinput .tag [data-role="validate"] {
        position: absolute;
        right: 25px;
        top: 5;
        cursor: pointer;
        color: #fff;
        font-weight: bold;
      }
      .bootstrap-tagsinput .tag [data-role="validate"]:after {
        content: "✅";
      }

      /* Style une fois validé */
      .bootstrap-tagsinput .tag.validated {
        background: #198754 !important; /* vert Bootstrap */
      }
    </style>

