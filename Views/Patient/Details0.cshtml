            selectedTeeth.push(id);
            $(".child-tooth-" + id + "-parent").css("fill", "#25db9e");
            $(".tooth-" + id + "-parent").css("fill", "#25db9e");
          }
    
          $("#number").html(selectedTeeth.join(", "));
          console.log(selectedTeeth);
        });
      });
