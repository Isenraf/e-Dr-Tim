            <div id="diagnostique-hypotheses" class="text">
              <div class="card-body">
                <div class="mb-3" id="diagoshypoContainer">
                  <label class="form-label" for="inpdiagnostic-hypothese">DIAGNOSTIQUE D'HYPOTHESES</label>
                  <input class="form-control mb-3" type="text" name="" list="diagnostic-hypothese" id="inpdiagnostic-hypothese" autocomplete="off" />
                  <datalist id="diagnostic-hypothese">
                  @foreach(var item in ViewBag.cim){
                     <option value="@item.Code - @item.Nom">@item.Code @item.Nom</option>
                  }
                  </datalist>
                  <textarea class="form-control mb-3" id="descriphypo" rows="3" placeholder="Description..."></textarea>
                </div>

                <div class="mb-3">
                  <button type="button" class="btn btn-primary" onclick="ajouterdiagnostiquehypothese()">
                    <i class="ri-add-large-line"></i>
                    + Ajouter
                  </button>
                </div>
              </div>
            </div>

            <div id="complications" class="text">
              <div class="col-12">
                <div class="card mb-3">
                  <div class="card-body">
                    <div class="m-0">
                      <label class="form-label" for="icicomplications">COMPLICATIONS</label>
                      <textarea class="form-control" id="icicomplications" rows="12"></textarea>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="examens-complementaires" class="text">
              <div class="modal-body">
                <div class="row">
                  <div class="col-lg-12">
                    <div class="mb-3" id="examensLaboContainer">
                      <div class="mb-3 row">
                        <div class="col-lg-6">
                          <label class="form-label fw-bold" for="idexamdelabo">Examens biologiques</label>
                          <input class="form-control" list="examdelabo" id="idexamdelabo" name="examdelabo" />
                          <datalist id="examdelabo">
                            @foreach(var item in ViewBag.Labo){
                              <option value="@item.Nom">@item.Categorie</option>
                            }
                          </datalist>
                        </div>
                        <div class="col-lg-6">
                          <label class="form-label" for="indicationsexamlabo">Indications</label>
                          <input class="form-control" id="indicationsexamlabo" type="text" />
                        </div>
                      </div>
                    </div>

                    <div class="mb-3">
                      <button type="button" class="btn btn-primary" onclick="ajouterExamenLabo()">
                        <i class="ri-add-large-line"></i>
                        + Ajouter
                      </button>
                    </div>
                  </div>

                  <div class="col-lg-12">
                    <div class="mb-3" id="explorationFonctionnelleContainer">
                      <div class="row mb-2">
                        <div class="col-lg-6">
                          <label class="form-label fw-bold" for="idexplofonctionnel">Explorations fonctionnelles</label>
                          <input class="form-control" list="explofonctionnel" id="idexplofonctionnel" name="explofonctionnel" />
                          <datalist id="explofonctionnel">
                            @foreach(var item in ViewBag.Exploration){
                              <option value="@item.Nom">@item.Categorie</option>
                            }
                            
                          </datalist>
                        </div>

                        <div class="col-lg-6">
                          <label class="form-label" for="indicationsexp">Indications</label>
                          <input class="form-control" id="indicationsexp" />
                        </div>
                      </div>
                    </div>
                    <div class="mb-3">
                      <button type="button" class="btn btn-primary" onclick="ajouterExplorationFonctionnelle()">
                        <i class="ri-add-large-line"></i>
                        + Ajouter
                      </button>
                    </div>
                  </div>

                  <div class="col-lg-12">
                    <div class="mb-3" id="immagerieContainer">
                      <div class="row mb-2">
                        <div class="col-lg-6">
                          <label class="form-label fw-bold" for="inpimmagerie">Imagerie médicale</label>
                          <input class="form-control" id="inpimmagerie" list="immagerie" name="scanner" />
                          <datalist id="immagerie">
