<script>
  (function () {
    function init() {
      const svg = document.querySelector(".human-body svg");
      if (!svg) return console.warn("SVG introuvable");

      // Liste des parties sélectionnées
      let selectedParts = [];

      // Style d'activation injecté en JS
      const style = document.createElement("style");
      style.textContent = `
        .human-body svg path.active {
          fill: #a80000 !important;
        }
      `;
      document.head.appendChild(style);

      // Gestion des clics sur les parties du corps
      svg.addEventListener(
        "click",
        function (e) {
          const path = e.target.closest("path");
          if (!path) return;

          const id = path.getAttribute("id") || path.getAttribute("data-id");
          if (!id) return;

          // Vérifie si la partie est déjà sélectionnée
          if (selectedParts.includes(id)) {
            // Si déjà sélectionnée, on la désélectionne
            selectedParts = selectedParts.filter((partId) => partId !== id);
            path.classList.remove("active");
          } else {
            // Sinon, on la sélectionne
            selectedParts.push(id);
            path.classList.add("active");
          }

          updateSelectedParts();
        },
        true
      ); // capture = true

      // Fonction pour mettre à jour l'affichage des parties sélectionnées
      function updateSelectedParts() {
        const selectedPartsContainer = document.getElementById("bodypart");
        if (selectedPartsContainer) {
          selectedPartsContainer.textContent = selectedParts.join(", ");
        }
        console.log("Parties sélectionnées :", selectedParts);
      }
    }

    // S'assure que le DOM est prêt
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

