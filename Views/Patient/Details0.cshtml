    <!-- JS pour badges -->
    <script>
      function setupBadge(formId, badgeId) {
        const form = document.getElementById(formId);
        const badge = document.getElementById(badgeId);

        function updateBadge() {
          let count = 0;

          if (formId === "examen-physique") {
            // Pour examen-physique : compter uniquement les tags validés (verts)
            const inputs = form.querySelectorAll("input, textarea, select");
            count = Array.from(inputs).reduce((acc, el) => {
              if ($(el).hasClass("examphy")) {
                // Récupérer tous les tags associés
                const $tags = $(el).siblings(".bootstrap-tagsinput").find(".tag.validated");
                return acc + $tags.length;
              }
              // Pour autres champs classiques
              if (el.type === "checkbox" || el.type === "radio") {
                return acc + (el.checked ? 1 : 0);
              } else if (el.value.trim() !== "") {
                return acc + 1;
              }
              return acc;
            }, 0);
          } else {
            // Pour les autres formulaires
            form.querySelectorAll("input, textarea, select").forEach((el) => {
              if ((el.type === "checkbox" || el.type === "radio") && el.checked) {
                count++;
              } else if (el.value.trim() !== "") {
                count++;
              }
            });
          }

          if (count > 0) {
            badge.textContent = count;
            badge.classList.remove("d-none");
          } else {
            badge.classList.add("d-none");
          }
        }

        // Expose updateBadge pour examen-physique afin d'appeler depuis l'extérieur
        if (formId === "examen-physique") {
          window.updateExamPhyBadge = updateBadge;

          const $form = $(form);

          // Mettre à jour à l'ajout ou suppression d'un tag
          $form.on("itemAdded itemRemoved", ".examphy", updateBadge);

          // Mettre à jour au clic sur validate (vert)
          $(document).on("click", ".bootstrap-tagsinput .tag [data-role='validate']", function () {
            // Attendre que la classe 'validated' soit appliquée
            setTimeout(updateBadge, 50);
          });
        }

        // Écouteurs pour inputs classiques
        form.querySelectorAll("input, textarea, select").forEach((el) => {
          el.addEventListener("input", updateBadge);
          el.addEventListener("change", updateBadge);
        });

        // Première mise à jour
        updateBadge();
      }

      // Activation des badges
      setupBadge("motif-consultation", "badgemotif");
      setupBadge("histoire-maladie", "badgehistoire");
      setupBadge("antecedants", "badgeantecedants");
      setupBadge("enquete-systeme", "badgeenquet");
      setupBadge("examen-physique", "badgeexamphy"); // logique tags verts
      setupBadge("diagnostique-hypotheses", "badgediagnoshyp");
      setupBadge("complications", "badgecomplications");
      setupBadge("examens-complementaires", "badgeexamcomple");
      setupBadge("diagnostique-certitude", "badgediagnoscert");
      setupBadge("traitement", "badgetraitement");
      setupBadge("conclusion", "badgeconclu");
      setupBadge("suivi-rendez-vous", "badgesuivi");
    </script>

    <!-- JS pour btn-update(vert)-->
    <script>
      // Vérifie si un champ est rempli ou coché
      function isFieldFilled(el) {
        // Checkbox ou radio
        if (el.type === "checkbox" || el.type === "radio") {
          return el.checked;
        }

        // Inputs avec tags Bootstrap (.examphy)
        if ($(el).hasClass("examphy")) {
          const $tags = $(el).siblings(".bootstrap-tagsinput").find(".tag");
          if ($tags.length === 0) return false;

          // Seuls les tags validés (vert) comptent comme remplis
          return $tags.toArray().some((tag) => $(tag).hasClass("validated"));
        }

        // Champs classiques
        return el.value && el.value.trim() !== "";
      }

      // Met à jour la classe des boutons d'accordéon
      function updateAccordionClass(root = document) {
        const accordionItems = root.querySelectorAll(".accordion-item");

        accordionItems.forEach((item) => {
          const headerBtn = item.querySelector(".accordion-button");
          if (!headerBtn) return;

          const inputs = item.querySelectorAll("input, textarea, select");
          const filledInputs = Array.from(inputs).filter(isFieldFilled);

          if (filledInputs.length > 0) {
            headerBtn.classList.add("btn-updated");
          } else {
            headerBtn.classList.remove("btn-updated");
          }
        });
      }

      // Écouteurs pour champs classiques
      document.addEventListener("input", (e) => {
        if (e.target.matches("input, textarea, select")) updateAccordionClass();
      });
      document.addEventListener("change", (e) => {
        if (e.target.matches("input, textarea, select")) updateAccordionClass();
      });

      // Mettre à jour l'accordion quand les tags changent
      $(document).on("itemAdded itemRemoved", ".examphy", function () {
        updateAccordionClass();
      });

      // Mettre à jour l'accordion quand un tag est validé (vert)
      $(document).on("click", ".bootstrap-tagsinput .tag [data-role='validate']", function () {
        const $tag = $(this).closest(".tag");
        updateAccordionClass();
      });
    </script>

    <!-- Speech to text -->
    <script>
      var result = document.getElementById("result");
      var activeElement = null;

      // Track the last focused input/textarea
      document.addEventListener("focusin", (e) => {
        if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") {
          activeElement = e.target;
        }
      });

      function startConverting() {
        if ("webkitSpeechRecognition" in window) {
          var speechRecognizer = new webkitSpeechRecognition();
          speechRecognizer.continuous = true;
          speechRecognizer.interimResults = true;
          speechRecognizer.lang = "fr-FR";
          speechRecognizer.start();

          var finalTranscripts = "";

          speechRecognizer.onresult = function (event) {
            var interimTranscripts = "";
            for (var i = event.resultIndex; i < event.results.length; i++) {
              var transcript = event.results[i][0].transcript;
              transcript.replace("\n", "<br>");
              if (event.results[i].isFinal) {
                finalTranscripts += transcript;
                // Insert into active field if available
                if (activeElement) {
                  activeElement.value += transcript;
                }
              } else {
                interimTranscripts += transcript;
              }
            }

            // Show live transcript (if the div exists)
            if (result) {
              result.innerHTML = finalTranscripts + '<span style="color:#999">' + interimTranscripts + "</span>";
            }
          };

          speechRecognizer.onerror = function (event) {
            console.error("Speech recognition error:", event.error);
          };
        } else {
          if (result) {
            result.innerHTML = "Votre navigateur n’est pas supporté. Veuillez utiliser Google Chrome.";
          }
        }
      }
    </script>

    <!-- JS pour rapport recap -->
    <script>
      // Fonction générique pour lier un champ à son span dans le rapport
      function bindToReport(inputId, dataKey) {
        const input = document.getElementById(inputId);
        const target = document.querySelector(`span[data-key="${dataKey}"]`);
        if (input && target) {
          input.addEventListener("input", () => {
            target.textContent = input.value;
          });
        }
      }

      // Liaison des champs simple
      bindToReport("motifconsul", "motifconsul");
      bindToReport("histoiremaladie", "histoiremaladie");
      bindToReport("icicomplications", "icicomplications");
      bindToReport("conclu", "conclu");
      bindToReport("inpdiagnostic-certitude", "inpdiagnostic-certitude");
      bindToReport("descripcerti", "descripcerti");
      bindToReport("rdv", "rdv");
      bindToReport("recommandation", "recommandation");

      // Antécédents
      function bindAntecedent(inputId, dataKey, column) {
        const input = document.getElementById(inputId);
        const tbody = document.getElementById("antecedents-body");
        if (!input || !tbody) return;

        const labelText = document.querySelector(`span[for="${inputId}"]`)?.textContent || "";

        input.addEventListener("input", () => {
          const val = input.value.trim();

          // On cherche la ligne existante pour ce "dataKey"
          let row = tbody.querySelector(`tr[data-key="${dataKey}"]`);

          if (val) {
            // Crée la ligne si elle n'existe pas
            if (!row) {
              row = document.createElement("tr");
              row.setAttribute("data-key", dataKey);

              // deux colonnes vides par défaut
              row.innerHTML = "<td></td><td></td>";
              tbody.appendChild(row);
            }

            // Remplit la bonne cellule
            if (column === "personnels") {
              row.cells[0].textContent = labelText ? `${labelText}: ${val}` : val;
            } else {
              row.cells[1].textContent = labelText ? `${labelText}: ${val}` : val;
            }
          } else {
            // Si vide → efface la cellule
            if (row) {
              if (column === "personnels") {
                row.cells[0].textContent = "";
              } else {
                row.cells[1].textContent = "";
              }

              // Supprime la ligne si les deux colonnes sont vides
              if (!row.cells[0].textContent && !row.cells[1].textContent) {
                row.remove();
              }
            }
          }
        });
      }
      // Antécédents
      bindAntecedent("medicaux", "medicaux", "personnels");
      bindAntecedent("chirigucaux", "chirigucaux", "personnels");
      bindAntecedent("immunoallergie", "immunoallergie", "personnels");
      bindAntecedent("environnementaux", "environnementaux", "personnels");
      bindAntecedent("toxicologique", "toxicologique", "personnels");
      bindAntecedent("gynecologiqueobstetricaux", "gynecologiqueobstetricaux", "personnels");
      bindAntecedent("psychosociaux", "psychosociaux", "personnels");
      bindAntecedent("ascendants", "ascendants", "familiaux");
      bindAntecedent("descendants", "descendants", "familiaux");
      bindAntecedent("collateraux", "collateraux", "familiaux");

      // Diagnostique d'hypothese
      const diagContainer = document.getElementById("diagoshypoContainer");
      const diagTableBody = document.getElementById("diagTableBody");

      // Examens complementaires
      const laboContainer = document.getElementById("examensLaboContainer");
      const fonctionnelContainer = document.getElementById("explorationFonctionnelleContainer");
      const imagerieContainer = document.getElementById("immagerieContainer");
      const anapatheContainer = document.getElementById("anapatheContainer");
      const examensTableBody = document.getElementById("examcombody");

      // Traitement
      const traitementContainer = document.getElementById("traitementcontainer");
      const traitementTableBody = document.getElementById("traitementbody");

      // Fonction pour mettre à jour le tableau diagnostique hypothese
      function updateDiagTable() {
        diagTableBody.innerHTML = "";

        const inputs = diagContainer.querySelectorAll('input[id^="inpdiagnostic-hypothese"]');
        const textareas = diagContainer.querySelectorAll('textarea[id^="descriphypo"]');

        inputs.forEach((input, index) => {
          const hypo = input.value.trim();
          const desc = textareas[index] ? textareas[index].value.trim() : "";

          if (hypo || desc) {
            const tr = document.createElement("tr");
            tr.innerHTML = `<td><span data-key="inpdiagnostic-hypothese">${hypo}</span></td>
                      <td><span data-key="descriphypo">${desc}</span></td>`;
            diagTableBody.appendChild(tr);
          }
        });
      }

      // Binder les inputs et textarea existants pour mise à jour en temps réel pour diagnostique hypothese
      function bindDiagInputs() {
        diagContainer.querySelectorAll('input[id^="inpdiagnostic-hypothese"], textarea[id^="descriphypo"]').forEach((el) => {
          el.addEventListener("input", updateDiagTable);
        });
      }

      // Appel initial pour binder les champs existants pour diagnostique hypothese
      bindDiagInputs();
      updateDiagTable();

      // Meme chose pour Examen complementaire
      function updateExamensTable() {
        examensTableBody.innerHTML = "";

        function addRows(title, container, inputId, indicationId) {
          const inputs = container.querySelectorAll(`input[id^="${inputId}"]`);
          const indications = container.querySelectorAll(`input[id^="${indicationId}"]`);
          if (inputs.length === 0) return;

          inputs.forEach((input, index) => {
            const nom = input.value.trim();
            const ind = indications[index] ? indications[index].value.trim() : "";

            if (nom || ind) {
              const tr = document.createElement("tr");
              // On ajoute le titre seulement sur la première ligne
              tr.innerHTML = `<td class="fw-bold align-middle">${index === 0 ? title : ""}</td>
                        <td><span data-key="${inputId}">${nom}</span></td>
                        <td><span data-key="${indicationId}">${ind}</span></td>`;
              examensTableBody.appendChild(tr);
            }
          });
        }

        addRows("Examens biologiques", laboContainer, "idexamdelabo", "indicationsexamlabo");
        addRows("Explorations fonctionnelles", fonctionnelContainer, "idexplofonctionnel", "indicationsexp");
        addRows("Imagerie medical", imagerieContainer, "inpimmagerie", "indicationsimg");
        addRows("ANAPATHE", anapatheContainer, "inpanapathe", "indicationsana");
      }

      function bindExamInputs() {
        [laboContainer, fonctionnelContainer, imagerieContainer, anapatheContainer].forEach((container) => {
          container.querySelectorAll("input").forEach((input) => {
            input.addEventListener("input", updateExamensTable);
          });

          container.querySelectorAll(".btn-supprimer").forEach((btn) => {
            btn.addEventListener("click", () => {
              const row = btn.closest(".row");
              if (row) row.remove();
              updateExamensTable();
            });
          });
        });
      }

      bindExamInputs();
      updateExamensTable();

      // Meme chose pour traitement
      function updateTraitementTable() {
      traitementTableBody.innerHTML = "";

      const lignes = traitementContainer.querySelectorAll(".ligne-traitement2");

      lignes.forEach((ligne) => {
        const prescription = ligne.querySelector("input[id^='traitprescription']")?.value.trim() || "";
        const posologie = ligne.querySelector("input[id^='traitobservation']")?.value.trim() || "";

        if (prescription || posologie) {
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td><span data-key="traitprescription">${prescription}</span></td>
            <td><span data-key="traitobservation">${posologie}</span></td>
          `;
          traitementTableBody.appendChild(tr);
        }
      });

      if (traitementTableBody.children.length > 0) {
        rappTraitement.classList.remove("d-none");
      } else {
        rappTraitement.classList.add("d-none");
      }
    }


      function bindTraitementInputs() {
        traitementContainer.querySelectorAll("input, textarea").forEach((el) => {
          el.removeEventListener("input", updateTraitementTable);
          el.addEventListener("input", updateTraitementTable);
        });

        traitementContainer.querySelectorAll(".btn-supprimer").forEach((btn) => {
          btn.removeEventListener("click", handleDelete);
          btn.addEventListener("click", handleDelete);
        });
      }

      function handleDelete(e) {
        const row = e.target.closest(".row");
        if (row) row.remove();
        updateTraitementTable();
      }

      // --- Initialisation ---
      bindTraitementInputs();
      updateTraitementTable();




      const enqueteContainer = document.getElementById("enquete-systeme");
      const rapportBody = document.getElementById("rapportEnqueteSysteme");

      function updateEnqueteSystemeRapport() {
        rapportBody.innerHTML = `<div class="bg-info bg-opacity-25 p-2 fw-bold">ENQUETE DES SYSTEMES</div>`;

        enqueteContainer.querySelectorAll(".accordion-item").forEach((accordion) => {
          const titreSection = accordion.querySelector(".accordion-button h5")?.textContent.trim() || "Section";
          const resultats = [];

          // Checkboxes
          accordion.querySelectorAll(".form-check-input[type='checkbox']").forEach((chk) => {
            if (chk.checked) {
              const label = accordion.querySelector(`label[for='${chk.id}']`)?.textContent.trim() || chk.id;
              const obsInput = accordion.querySelector(`#Observation${chk.id}`);
              const observation = obsInput?.value.trim() || "";
              resultats.push(observation ? `${label} : ${observation}` : label);
            }
          });

          // Champs "Autre" (y compris dynamiques)
          // Champs "Autre" et lignes dynamiques
          accordion.querySelectorAll("input[id^='autre']").forEach((autreInput) => {
            if (autreInput.value.trim() === "") return;

            // Cherche d'abord observation correspondant à l'id exact (pour dynamiques)
            let obsInput = accordion.querySelector(`#observation${autreInput.id}`);

            // Si pas trouvé, cherche un input dans la même row qui contient 'Observation'
            if (!obsInput) {
              const parentRow = autreInput.closest(".row");
              obsInput = parentRow?.querySelector("input[id*='Observation'], textarea[id*='Observation']");
            }

            const observation = obsInput?.value.trim() || "";
            resultats.push(observation ? `${autreInput.value} : ${observation}` : autreInput.value);
          });

          // Ajoute la section au rapport
          if (resultats.length > 0) {
            const section = document.createElement("div");
            section.classList.add("mb-2");
            section.innerHTML = `
        <h6 class="fw-bold">${titreSection}</h6>
        <ul class="mb-0">
          ${resultats.map((r) => `<li>${r}</li>`).join("")}
        </ul>
      `;
            rapportBody.appendChild(section);
          }
        });
      }

      //  Event delegation pour prendre en compte tous les inputs (y compris dynamiques)
      enqueteContainer.addEventListener("input", updateEnqueteSystemeRapport);
      enqueteContainer.addEventListener("change", updateEnqueteSystemeRapport);

      //  Initialisation
      updateEnqueteSystemeRapport();
    </script>

    <script>
      const examContainer = document.getElementById("examen-physique");
      const rapportExamphy = document.getElementById("rapportExamphy");

      function updateExamphyRapport() {
        rapportExamphy.innerHTML = `<div class="bg-info bg-opacity-25 p-2 fw-bold">EXAMEN PHYSIQUE</div>`;

        //  État général
        const etatGeneral = document.getElementById("etatgeneral")?.value.trim();
        if (etatGeneral) {
          rapportExamphy.innerHTML += `
      <div class="mb-2 ms-3">
        <h6 class="fw-bold">État général</h6>
        <p>${etatGeneral}</p>
      </div>`;
        }

        // Parcourir chaque accordéon (système)
        examContainer.querySelectorAll(".accordion-item").forEach((accordion) => {
          const titreSection = accordion.querySelector(".accordion-button h5")?.textContent.trim() || "Section";
          const sectionContent = [];

          //  Champs tags
          accordion.querySelectorAll(".form-control.examphy").forEach((input) => {
            const labelEl = accordion.querySelector(`label[for='${input.id}']`);
            const label = labelEl ? labelEl.textContent.trim() : input.id;

            // Tags validés
            const tagsContainer = input.parentElement.querySelectorAll(".tag.validated, .tag[data-role='remove']");
            const tagsValides = Array.from(tagsContainer)
              .map((tag) => tag.firstChild?.textContent.trim() || "")
              .filter((t) => t !== "");

            if (tagsValides.length > 0) {
              sectionContent.push(`
  <div class="mb-1 ms-3">
    <strong>${label} :</strong> 
    ${tagsValides.join(", ")}
  </div>
`);
            }
          });

          //  Checkbox et observations
          accordion.querySelectorAll(".form-check-input[type='checkbox']").forEach((checkbox) => {
            if (checkbox.checked) {
              const label = accordion.querySelector(`label[for='${checkbox.id}']`)?.textContent.trim() || checkbox.value;
              // Chercher l'input observation dans la même row
              const row = checkbox.closest(".row");
              let observation = "";
              if (row) {
                const obsInput = row.querySelector("input.form-control");
                if (obsInput) observation = obsInput.value.trim();
              }
              sectionContent.push(`
          <div class="mb-1 ms-3">
            <strong>${label}</strong>: ${observation}
          </div>
        `);
            }
          });

          //  Inputs classiques remplis (texte, nombre, date)
          accordion.querySelectorAll("input:not(.examphy):not([type='checkbox']), textarea").forEach((input) => {
            const val = input.value.trim();
            if (val !== "") {
              const label = input.closest(".mb-3")?.querySelector("label")?.textContent.trim() || input.name || input.id;
              sectionContent.push(`
          <div class="mb-1 ms-3">
            <strong>${label}</strong>: ${val}
          </div>
        `);
            }
          });

          //  Si cette section a du contenu, on l’ajoute
          if (sectionContent.length > 0) {
            rapportExamphy.innerHTML += `
        <div class="mb-2">
          <h6 class="fw-bold">${titreSection}</h6>
          ${sectionContent.join("")}
        </div>
      `;
          }
        });
      }

      //  Observer tous les changements de tags
      examContainer.querySelectorAll(".form-control.examphy").forEach((input) => {
        const observer = new MutationObserver(() => updateExamphyRapport());
        observer.observe(input.parentElement, { childList: true, subtree: true });
      });

      //  Mise à jour lors de validation/suppression
      examContainer.addEventListener("click", (e) => {
        if (e.target.matches("[data-role='validate'], [data-role='remove']")) {
          setTimeout(updateExamphyRapport, 50);
        }
      });

      //  Mise à jour quand on tape dans État général ou tout input classique
      examContainer.addEventListener("input", updateExamphyRapport);

      //  Initialisation
      updateExamphyRapport();
    </script>
  </body>
