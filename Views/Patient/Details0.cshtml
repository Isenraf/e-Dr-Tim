    <!-- JS pour affichage titre rapport -->
    <script>
      function toggleSection(sectionId) {
        const section = document.getElementById(sectionId);
        if (!section) return;

        let visible = false;

        // Vérifier tous les spans
        section.querySelectorAll("span").forEach((el) => {
          if (el.textContent.trim() !== "") visible = true;
        });

        // Vérifier toutes les cellules de tableau
        section.querySelectorAll("td").forEach((el) => {
          if (el.textContent.trim() !== "") visible = true;
        });

        // Vérifier tous les divs qui contiennent du texte (pas les titres)
        section.querySelectorAll("div").forEach((el) => {
          if (!el.classList.contains("bg-info") && el.textContent.trim() !== "") visible = true;
        });

        // Afficher ou cacher la section
        section.classList.toggle("d-none", !visible);
      }

      function updateAllSections() {
        document.querySelectorAll(".rapport-section").forEach((sec) => {
          toggleSection(sec.id);
        });
      }

      document.addEventListener("DOMContentLoaded", updateAllSections);

      // Mise à jour à chaque saisie ou changement
      document.addEventListener("input", updateAllSections);
      document.addEventListener("change", updateAllSections);

      // Observer les changements dynamiques
      const observer = new MutationObserver(updateAllSections);
      document.querySelectorAll(".rapport-section").forEach((sec) => {
        observer.observe(sec, { childList: true, subtree: true });
      });
    </script>


    <!-- JS pour tags -->
    <script>
      function addButtonsToTags() {
        $(".bootstrap-tagsinput .tag").each(function () {
          let $tag = $(this);
          if ($tag.find("[data-role='validate']").length === 0) {
            $tag.append("<span data-role='validate'></span>");
          }
          if ($tag.find("[data-role='remove']").length === 0) {
            $tag.append("<span data-role='remove'></span>");
          }
        });
      }

      // Ajouter boutons aux tags par défaut (bleus)
      $(document).ready(function () {
        addButtonsToTags();
      });

      // Quand un nouveau tag est ajouté sur n'importe quel input .examphy
      $(".examphy").on("itemAdded", function (event) {
        let $input = $(this); // l'input courant
        let $tags = $input.siblings(".bootstrap-tagsinput").find(".tag");
        let $lastTag = $tags.last(); // le nouveau tag ajouté

        // Ajoute automatiquement la classe validated (vert)
        $lastTag.addClass("validated");

        // Et ajoute les boutons
        addButtonsToTags($input);
      });

      // Supprimer un tag (délégué global)
      $(document).on("click", ".bootstrap-tagsinput .tag [data-role='remove']", function () {
        let $tag = $(this).closest(".tag");
        let text = $tag.clone().children().remove().end().text().trim();

        // Trouver l'input correspondant
        let $input = $tag.closest(".bootstrap-tagsinput").prev("input.examphy");

        if ($input.length) {
          $input.tagsinput("remove", text);
        }
      });

      // Toggle validation manuelle (délégué global)
      $(document).on("click", ".bootstrap-tagsinput .tag [data-role='validate']", function () {
        let $tag = $(this).closest(".tag");
        $tag.toggleClass("validated");
      });
    </script>

    <!-- JS pour affichage de contenu -->
    <script>
      document.querySelectorAll(".list button").forEach((button) => {
        button.addEventListener("click", function () {
          // Désactiver tous les boutons et contenus
          document.querySelectorAll(".list button").forEach((btn) => {
            btn.classList.remove("btn-primary", "active");
            btn.classList.add("btn-outline-primary");
          });
          document.querySelectorAll(".text").forEach((textDiv) => {
            textDiv.classList.remove("active");
          });

          // Activer le bouton cliqué et le contenu correspondant
