@model IEnumerable<BANA.Models.Patient>

@{
    ViewData["Title"] = "Liste des patients";
    int i=1;
    Layout="_Layout3";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Tableau de bord
              </li>
            </ol>
            <!-- Breadcrumb ends -->

            <!-- Sales stats starts -->
            <div class="ms-auto d-lg-flex d-none flex-row">
              <div class="d-flex flex-row gap-1 day-sorting">
                <button class="btn btn-sm btn-primary">Aujourd'hui</button>
                <button class="btn btn-sm">7j</button>
                <button class="btn btn-sm">2s</button>
                <button class="btn btn-sm">1m</button>
                <button class="btn btn-sm">3m</button>
                <button class="btn btn-sm">6m</button>
                <button class="btn btn-sm">1A</button>
              </div>
            </div>
            <!-- Sales stats ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- App body starts -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <h5 class="card-title">BESOINS DU MALADE</h5>
                </div>

                <div class="card-body">
                  <form class="table-responsive">
                    <table class="table table-hover table-bordered table-sm">
                      <thead>
                        <tr>
                          <th scope="col">Date</th>
                          <th scope="col">Besoins perturbes</th>
                          <th scope="col">Diagnostic Infirmier</th>
                          <th scope="col">Objectif</th>
                          <th scope="col">Intervention</th>
                          <th scope="col">Horaires/Planification</th>
                          <th scope="col">Evaluation</th>
                          <th scope="col">Emargement</th>
                        </tr>
                      </thead>

                      <tbody></tbody>
                    </table>

                    <button
                      id="addRowBtn"
                      type="button"
                      class="btn btn-outline-info mb-3"
                    >
                      + Ajouter soins
                    </button>

                    <div class="row clearfix">
                      <!-- <div class="col-md-12" style="text-align: right">
                  <button type="button" class="btn btn-outline-warning">
                    <i class="fa fa-close"></i> Annuler
                  </button>
                  <button type="button" class="btn btn-outline-success">
                    <i class="fa fa-save"></i> Enregistrer
                  </button>
                </div> -->
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
          <!-- App body ends -->

          <!-- App footer starts -->
          <div class="app-footer bg-white">
            <span>© Medflex admin 2024</span>
          </div>
          <!-- App footer ends -->
        </div>
        <!-- App container ends -->
