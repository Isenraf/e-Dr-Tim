@model IEnumerable<BANA.Models.Patient>

@{
    ViewData["Title"] = "Liste des patients";
    int i=1;
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Tous les patients
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["Actifs"]</span>
                      <span class="text-success">Patients actifs</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["Inactifs"]</span>
                      <span class="text-danger">Patients inactifs</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["total"]</span>
                      <span class="text-info">Nombre total de patients</span>
                    </div>

                    <a href="/Patient/Create" class="btn btn-primary ms-auto"
                      >Ajouter un patient</a
                    >
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3">
                      <div class="card">
                        <div class="card-body">
                          <form asp-controller="Patient" asp-action="SearchWord"  method="get">
                            <input type="search" name="SearchString" id="search" class="form-control" placeholder="Bare de Recherche"/>
                          </form>
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>

                    <div class="table-outer">
                      <div class="table-responsive">
                        <table class="table  m-0">
                          <thead>
                            <tr>
                              <th style="text-align: left;">Patient</th>
                              <th style="text-align: left;">Âge</th>
                              <th style="text-align: left;">Numéro de portable</th>
                              <th style="text-align: left;">Adresse</th>
                              <th style="text-align: left;">Dernière visite</th>
                              <th style="text-align: center;">Statut</th>
                            </tr>
                          </thead>

                          <tbody id="testfiltre">
                            @foreach (var item in Model)
                            {
                            <tr class="montest">
                              <td>
                                <div class="d-flex align-items-left">
                                  <a asp-action="Details" asp-route-Id="@item.Id">
                                    @if(item.Genre=="M"){
                                      <img src="/template2/assets/images/patient1.png" class="img-shadow img-2xx me-2" alt="@item.Nom @item.Prenom"/>
                                    }else{
                                      <img src="/template2/assets/images/patient2.png" class="img-shadow img-2xx me-2" alt="@item.Nom @item.Prenom"/>
                                    }
                                    
                                  </a>

                                  <div class="ml-3">
                                    <a style="color: #126aef;" title="Afficher le patient" asp-action="Details" asp-route-Id="@item.Id" 
                                      >@item.Nom @item.Prenom
                                    </a>
                                    <p class="mb-0" style="text-align: left;font-weight: 800;">📁 @item.Numero_dossier</p>
                                  </div>
                                </div>
                              </td>
                              <td style="text-align: left;">@((int)((DateTime.Now-item.DateNaissance).TotalDays/365)) ans  @((int)(((DateTime.Now-item.DateNaissance).TotalDays%365)/30)) mois @((((int)(DateTime.Now-item.DateNaissance).TotalDays)%365)%30) jours</td>
                              <td style="text-align: center;">📞 @item.Phone</td>
                              <td style="text-align: left;">@item.Quartier</td>
                              <td style="text-align: left;">@item.Derniere_visite.ToString("dd/MM/yyyy") @item.Derniere_visite.ToShortTimeString()</td>
                              <td style="text-align: center;">@if (true){<span class="badge border border-success text-success">@item.Etat</span>}else{<span class="badge border border-warning text-warning">Archivé</span>}
                                
                              </td>
                            </tr>
                            }
                            
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Row ends -->
            </div>
            <!-- App body ends -->
          </div>

 <a  style="position: fixed;right: 50px;bottom: 45px;" href="/Patient/Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
 <a  style="color: white;position: fixed;right: 100px;bottom: 45px;" onclick="return tableToExcel('testfiltre', 'Example Table');" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-file-excel-o"></i></a>