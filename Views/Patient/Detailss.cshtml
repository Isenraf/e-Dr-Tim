<style>
    

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        bottom: 100%; /* place le menu au-dessus */
        left: -20px; /* décale un peu vers la gauche */
        background-color: #fff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
        z-index: 1;
      }

      .dropdown-content button {
        display: block;
        margin: 5px 0;
        text-align: left;
        padding: 8px;
        border: none;
        background-color: #eee;
        cursor: pointer;
        border-radius: 4px;
      }

      .dropdown-content button:hover {
        background-color: #ddd;
      }

      .dropdown.show .dropdown-content {
        display: block;
      }

      button.main-btn {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>
