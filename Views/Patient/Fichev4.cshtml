@model BANA.Models.Patient

@{
    ViewData["Title"] = "Details";
     Layout="_Layout3";
}


<style>
    

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        bottom: 100%; /* place le menu au-dessus */
        left: -20px; /* décale un peu vers la gauche */
        background-color: #fff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
        z-index: 1;
      }

      .dropdown-content button {
        display: block;
        margin: 5px 0;
        text-align: left;
        padding: 8px;
        border: none;
        background-color: #eee;
        cursor: pointer;
        border-radius: 4px;
      }

      .dropdown-content button:hover {
        background-color: #ddd;
      }

      .dropdown.show .dropdown-content {
        display: block;
      }

      button.main-btn {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>
<link href="/css/stock2.css" rel="stylesheet">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Vaccination
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

   <!-- App body starts -->
          <div class="app-body">
            <div class="col-sm-12">
               <div class="d-flex justify-content-end gap-2 my-2">
                        <a class="btn btn-light" onclick="history.back()" href="#">Retour</a>
                    </div> 
              <div class="card">
                <div
                  class="card-header d-flex justify-content-between align-items-center"
                >
                  <h5 class="card-title mb-0">
                    CALENDRIER DE VACCINATION DE LA FEMME ENCEINTE VACCINEE DANS
                    L'ENFANCE
                  </h5>
                </div>

                <div class="card-body">
                  <div class="">
                    <div class="table-responsive mb-3">
                      <table
                        class="table table-bordered truncate m-0 text-center"
                        style="vertical-align: middle"
                      >
                        <caption>
                          <i
                            >NB: toute dose de Td recue ne doit pas etre reprise
                            quelle que soit la duree entre la dose recue et
                            celle a recevoir.</i
                          >
                        </caption>
                        <thead>
                          <tr>
                            <th>Doses</th>
                            <th>Periode d'administration</th>
                            <th>Voie d'administration</th>
                            <td>Duree de protection</td>
                            <th>Statut</th>
                          </tr>
                        </thead>

                        <tbody>
                          <tr>
                            <td>Td1</td>
                            <td>
                              Au premier contact ou des que possible pendant la
                              grossesse
                            </td>
                            <td rowspan="3">Intramusculaire</td>
                            <td>1 a 3 ans</td>
                            <td>
                              <input type="checkbox" class="form-check-input" />
                            </td>
                          </tr>

                          <tr>
                            <td>Td2</td>
                            <td>Au moins 4 semaines apres Td1</td>
                            <td>Au moins 5ans</td>
                            <td>
                              <input type="checkbox" class="form-check-input" />
                            </td>
                          </tr>

                          <tr>
                            <td>Td3</td>
                            <td>
                              Au moins 6 mois apres Td2 ou pendant la grossesse
                              survenue apres Td2
                            </td>
                            <td>Toute la vie feconde voire au-dela</td>
                            <td>
                              <input type="checkbox" class="form-check-input" />
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- App body ends -->
</div>







