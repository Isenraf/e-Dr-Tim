@model BANA.Models.Patient

@{
    ViewData["Title"] = "Edit";
}


<link rel="stylesheet" href="/template/assets/vendor/dropify/css/dropify.min.css">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item"> <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i> <a asp-action="Index" asp-controller="Departement">Acceuil</a> </li>
            <li class="breadcrumb-item text-primary" aria-current="page"> Ajouter un patient </li>
        </ol> <!-- Breadcrumb ends -->
    </div> <!-- App Hero header ends -->
   
    <!-- app body start -->
    <div class="app-body">
        <div class="card" >
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mt-2 mx-3 mb-4">
                    <h5 class="card-title">Ajouter un patient</h5>
                    <div class="d-flex flex-wrap gap-1">
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">Actifs: @ViewData["Actifs"]</span> </div>
                        <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">  <span class="me-1 fw-semibold ps-1">Total: @ViewData["total"]</span></div>
                    </div>
                </div>
                
                <div>
                  <div class="body">
                  <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Create_date" />
                    <input type="hidden" asp-for="Etat" />
                    <input type="hidden" asp-for="Derniere_visite" />
                    <input type="hidden" asp-for="Numero_dossier" />
                    <input type="hidden" asp-for="Taille" />
                    <div class="form-group row">
                      <label class="col-md-2 col-sm-4 col-form-label">Informations de base</label>
                      <div class="col-md-8 col-sm-8">
                        <div class="row clearfix">  

                         

                          <div class="col-md-4 col-sm-12">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Noms
                                  <span class="text-danger">*</span></label>
                                  <input asp-for="Nom" class="form-control" type="text" >
                                  <span asp-validation-for="Nom" class="text-danger"></span>
                              </div>
                            </div>
                          </div>

                          <div class="col-md-4 col-sm-12">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Prenoms
                                  <span class="text-danger">*</span></label>
                                  <input asp-for="Prenom" class="form-control" type="text">
                                  <span asp-validation-for="Prenom" class="text-danger"></span>
                              </div>
                            </div>
                          </div>

                          <div class="col-md-4 col-sm-12">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Téléphone
                                  <span class="text-danger">*</span></label>
                                  <input asp-for="Phone" class="form-control" type="text">
                                  <span asp-validation-for="Phone" class="text-danger"></span>
                              </div>
                            </div>
                          </div>
                        </div>

                        <div class="row clearfix">

                          <div class="col-md-3 col-sm-6">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Date  Naissance
                                  <span class="text-danger">*</span></label>
                                  <input asp-for="DateNaissance"  class="form-control" placeholder="Select Date">
                                  <span asp-validation-for="DateNaissance" class="text-danger"></span>
                              </div>
                            </div>
                          </div>

                           <div class="col-md-3 col-sm-6">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Profession
                                  <span class="text-danger"></span></label>
                                  <input asp-for="Profession" class="form-control"  placeholder="Enter here">
                                  <span asp-validation-for="Profession" class="text-danger"></span>
                              </div>
                            </div>
                          </div>

                          <div class="col-md-3 col-sm-6">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Genre
                                  <span class="text-danger">*</span></label>
                                   <select  asp-for="Genre" class="form-control show-tick">
                                      <option asp-for="Genre" value="">- Select -</option>
                                      <option asp-for="Genre" value="M">Homme</option>
                                      <option asp-for="Genre" value="F">Femme</option>
                                    </select>
                                    <span asp-validation-for="Genre" class="text-danger"></span>
                              </div>
                            </div>
                          </div>

                           <div class="col-md-3 col-sm-6">
                            <div class="card mb-3">
                              <div class="form-control">
                                <label class="form-label" for="a2">Adresse Email
                                  <span class="text-danger"></span></label>
                                  <input asp-for="Email" class="form-control"  placeholder="Enter here">
                                  <span asp-validation-for="Email" class="text-danger"></span>
                              </div>
                            </div>
                          </div>

                        </div>
                        <div class="row clearfix">
                          <div class="col-lg-12">
                            <input type="file" class="dropify">
                          </div>

                          <div class="col-sm-12" style="margin-top: 15px;">
                            <div class="card mb-3">
                              <div class="card-body">
                                <div class="m-0">
                                  <label class="form-label" for="abc6">Description</label>
                                   <textarea asp-for="Description" rows="6" class="form-control" placeholder="Description">
                                    </textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                              </div>
                            </div>
                          </div>


                          <div class="col-sm-12">
                            <div class="card mb-3">
                              <div class="card-body">
                                <div class="m-0">
                                  <label class="form-label" for="abc6">Notes importantes</label>
                                   <textarea asp-for="Notesimportant" rows="6" class="form-control" placeholder="Notes importantes">
                                    </textarea>
                                    <span asp-validation-for="Notesimportant" class="text-danger"></span>
                                </div>
                              </div>
                            </div>
                          </div>
                          
                         
                        </div>
                      </div>
                    </div>
                    <div class="form-group row mt-5">
                      <label class="col-md-2 col-sm-4 col-form-label">Informations d'enregistrement</label>
                      <div class="col-md-8 col-sm-10">
                        <div class="row clearfix">

                          <div class="col-sm-6">
                            <div class="card mb-3">
                              <div class="card-body">
                                <div class="m-0">
                                  <label class="form-label" >Groupe sanguin</label>
                                  <select asp-for="GroupeSanguin" class="form-select"  aria-label="Groupe sanguin">
                                    <option asp-for="GroupeSanguin" value="">- Select -</option>
                                    <option asp-for="GroupeSanguin" value="A+">A+</option>
                                    <option asp-for="GroupeSanguin" value="A-">A-</option>
                                    <option asp-for="GroupeSanguin" value="B+">B+</option>
                                    <option asp-for="GroupeSanguin" value="B-">B-</option>
                                    <option asp-for="GroupeSanguin" value="AB">AB</option>
                                    <option asp-for="GroupeSanguin" value="O+">O+</option>
                                    <option asp-for="GroupeSanguin" value="O-">O-</option>
                                  </select>
                                  <span asp-validation-for="GroupeSanguin" class="text-danger"></span>
                                </div>
                              </div>
                            </div>
                          </div>

                          

                          <div class="col-sm-6">
                            <div class="card mb-3">
                              <div class="card-body">
                                <div class="m-0">
                                  <label class="form-label" for="abc">Personne mandatée</label>
                                    <input asp-for="AutresContact" class="form-control" placeholder="Enter here">
                                    <span asp-validation-for="AutresContact" class="text-danger"></span>
                                </div>
                              </div>
                            </div>
                          </div>

                          <div class="col-sm-6">
                            <div class="card mb-3">
                              <div class="card-body">
                                <div class="m-0">
                                  <label class="form-label" for="abc">Adresse de résidence</label>
                                   <input asp-for="Quartier" class="form-control"  placeholder="Enter here">
                                    <span asp-validation-for="Quartier" class="text-danger"></span>
                                </div>
                              </div>
                            </div>
                          </div>

                          <div class="col-sm-6">
                            <div class="card mb-3">
                              <div class="card-body">
                                <div class="d-grid gap-2">
                                  
                                  <div class="form-check form-switch">
                                    <input asp-for="Acrif" checked class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" checked>
                                    <label class="form-check-label">Si ce checkbox est coché, le patient recevra les notifications</label>
                                  </div>
                                  
                                  
                                </div>
                              </div>
                            </div>
                          </div>


                          <div class="col-sm-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Enregistrer</button>
                            </button>
                            <button type="button" onclick="history.back()" class="btn btn-outline-secondary">Annuler</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </form>
                </div>
                 

                </div>
                
            </div>
        </div>
    </div> <!-- app body end-->


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


