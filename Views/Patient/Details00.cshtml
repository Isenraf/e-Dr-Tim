    <!-- JS pour affichage titre rapport -->
    <script>
      function toggleSection(sectionId) {
        const section = document.getElementById(sectionId);
        if (!section) return;

        let visible = false;

        // Vérifier tous les spans
        section.querySelectorAll("span").forEach((el) => {
          if (el.textContent.trim() !== "") visible = true;
        });

        // Vérifier toutes les cellules de tableau
        section.querySelectorAll("td").forEach((el) => {
          if (el.textContent.trim() !== "") visible = true;
        });

        // Vérifier tous les divs qui contiennent du texte (pas les titres)
        section.querySelectorAll("div").forEach((el) => {
          if (!el.classList.contains("bg-info") && el.textContent.trim() !== "") visible = true;
        });

        // Afficher ou cacher la section
        section.classList.toggle("d-none", !visible);
      }

      function updateAllSections() {
        document.querySelectorAll(".rapport-section").forEach((sec) => {
          toggleSection(sec.id);
        });
      }

      document.addEventListener("DOMContentLoaded", updateAllSections);

      // Mise à jour à chaque saisie ou changement
      document.addEventListener("input", updateAllSections);
      document.addEventListener("change", updateAllSections);

      // Observer les changements dynamiques
      const observer = new MutationObserver(updateAllSections);
      document.querySelectorAll(".rapport-section").forEach((sec) => {
        observer.observe(sec, { childList: true, subtree: true });
      });
    </script>

    <script>
      function bindToReport(inputId, dataKey) {
        const input = document.getElementById(inputId);
        const target = document.querySelector(`span[data-key="${dataKey}"]`);
        if (input && target) {
          input.addEventListener("input", () => {
            target.textContent = input.value;
          });
        }
      }

      // Liaison des champs simple
      bindToReport("motifConsult", "motifConsult");
      bindToReport("histoiremaladie", "histoiremaladie");
      bindToReport("antecedentsPerso", "antecedentsPerso");
      bindToReport("antecedentsFam", "antecedentsFam");
      bindToReport("enqueteSysteme", "enqueteSysteme");
      bindToReport("examenPhysique", "examenPhysique");
      bindToReport("diagnostiqueHypothese", "diagnostiqueHypothese");
      bindToReport("descriphypo", "descriphypo");
      bindToReport("complications", "complications");
      bindToReport("examensComplementaires", "examensComplementaires");
      bindToReport("diagnostiqueCertitude", "diagnostiqueCertitude");
      bindToReport("descripcerti", "descripcerti");
      bindToReport("prescription", "prescription");
      bindToReport("posologie", "posologie");
      bindToReport("prochainRDV", "prochainRDV");
      bindToReport("recommandations", "recommandations");
    </script>

    <script>
      function verifierAntecedents() {
        const blocAntecedent = document.getElementById("antecedent");

        const persoSpan = document.querySelector('[data-key="antecedentsPerso"]');
        const famSpan = document.querySelector('[data-key="antecedentsFam"]');

        const persoTable = document.getElementById("antecedents-personnels-body").closest("table");
        const famTable = document.getElementById("antecedents-familiaux-body").closest("table");

        const textePerso = persoSpan.textContent.trim();
        const texteFam = famSpan.textContent.trim();

        // Affiche ou masque chaque tableau
        persoTable.classList.toggle("d-none", textePerso === "");
        famTable.classList.toggle("d-none", texteFam === "");

        // Si les deux tableaux sont vides → cacher tout le bloc (titre inclus)
        const toutVide = textePerso === "" && texteFam === "";
        blocAntecedent.classList.toggle("d-none", toutVide);
      }

      // --- Observation automatique des changements sur les deux <span> ---
      function activerObservation() {
        const persoSpan = document.querySelector('[data-key="antecedentsPerso"]');
        const famSpan = document.querySelector('[data-key="antecedentsFam"]');

        const observer = new MutationObserver(verifierAntecedents);

        [persoSpan, famSpan].forEach((span) => {
          observer.observe(span, { childList: true, characterData: true, subtree: true });
        });

        verifierAntecedents(); // Vérification initiale
      }

      document.addEventListener("DOMContentLoaded", activerObservation);
    </script>
  </body>
</html>
