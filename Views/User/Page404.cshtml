@model IEnumerable<BANA.Models.Stock>

@{
    ViewData["Title"] = "Error";
   
}

<div class="container-fluid pt-4 px-4">
                <div class="row vh-100 bg-light rounded align-items-center justify-content-center mx-0">
                    <div class="col-md-6 text-center p-4">
                        <i class="bi bi-exclamation-triangle display-1 text-primary"></i>
                        <h1 class="display-1 fw-bold">404</h1>
                        <h1 class="mb-4">Page non trouvée</h1>
                        <p class="mb-4">Nous sommes désolés, la page que vous avez recherchée n'existe pas ! Allez peut-être sur la page d'accueil ou essayez d'utiliser une recherche ?</p>
                        <a class="btn btn-primary rounded-pill py-3 px-5" asp-action="Index" asp-controller="Stock">Retour à l'accueil</a>
                    </div>
                </div>
            </div>