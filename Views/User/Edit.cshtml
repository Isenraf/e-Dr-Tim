@model BANA.Models.User

@{
    ViewData["Title"] = "Edit";
}


<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Utilisateurs
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <div class="card py-3 px-3">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                   <input id="ident" type="hidden" asp-for="Id" />
                   <input type="hidden" asp-for="Create_date" />
                   <input type="hidden" asp-for="Lastconnetion" />
                   <input type="hidden" asp-for="Img" />
                   <input type="hidden" asp-for="Img" />
                <div class="row">
                    
                    <div class="col-lg-6 col-md-12 col-sm-12">

                        <div class="card-header">
                            <h5>Informations Utilisateurs</h5>
                        </div>
                        
                        <div class="col">
                            <div class="card mb-3">
                                <div class="form-control">
                                    <label class="form-label" for="a2">Nom d'utilisateur<span class="text-danger">*</span></label>
                                    <input placeholder="exemple: Adrien" asp-for="nom" class="form-control"  style="height: 50px; border: #c3dff1;" />
                                    <span asp-validation-for="nom" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card mb-3">
                                <div class="form-control">
                                    <label class="form-label" for="a2">Email </label>
                                    <input placeholder="exemple: donaldtrump@gmail.com" asp-for="Email" class="form-control" style="height: 50px; border: #c3dff1;" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card mb-3">
                                <div class="form-control">
                                    <label class="form-label" for="a2">Sexe</label>
                                    <div class="input-group">
                                        <select asp-for="Genre" class="form-select" id="a9" style="height: 50px; border: #c3dff1;">
                                           <option asp-for="Genre" value="Homme" selected>Homme</option>
                                            <option asp-for="Genre" value="Femme">Femme</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card mb-3">
                                <div class="form-control">
                                    <label class="form-label" for="a2">Mot de passe </label>
                                    <input asp-for="Password" class="form-control" style="height: 50px; border: #c3dff1;" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
