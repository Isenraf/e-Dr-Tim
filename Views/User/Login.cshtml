@model BANA.Models.User

@{
    ViewData["Title"] = "Login";
    Layout="_Layout2";
}


<body class="login-bg">
    <!-- Container starts -->
    <div class="container">
        <!-- Auth wrapper starts -->
        <div class="auth-wrapper">
            <!-- Form starts -->
            <form asp-action="Login">
            <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />
                <div class="auth-box" style="max-width: 400px;">
                    <div style="display: flex;flex-direction: column;align-items: center;justify-content: center;"> 
                      <a href="javascript:void(0);" class="auth-logo mb-0"> <img style="width: 180px" src="/template2/assets/images/hm2.jpeg" alt="Bootstrap Gallery" /> </a>
                        <h4 class="mb-4" style="text-align: center"> Connectez-vous à votre compte </h4>
                    </div>
                    <div class="mb-3"> <label class="form-label" for="user-name">Nom d'utilisateur <span class="text-danger">*</span></label> <input type="text" id="user-name" class="form-control" placeholder="Entrez votre nom d'utilisateur" asp-for="nom" /> <span asp-validation-for="nom" class="text-danger"></span> </div>
                    <div class="mb-2"> <label class="form-label" for="pwd">Votre mot de passe <span class="text-danger">*</span></label>
                        <div class="input-group"> <input type="password" id="pwd" class="form-control" placeholder="Entrez le mot de passe" asp-for="Password" /> <button class="btn btn-outline-secondary" type="button"> <i class="ri-eye-line text-primary"></i> </button> </div> <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end mb-3"><span class="text-danger">@ViewData["error"]</span></div>
                    <div class="mb-3 d-grid gap-2"> <button type="submit" class="btn btn-primary"> Se connecter </button> </div>
                </div>
            </form> <!-- Form ends -->
        </div> <!-- Auth wrapper ends -->
    </div> <!-- Container ends -->
</body>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
 


