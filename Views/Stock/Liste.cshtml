@model IEnumerable<BANA.Models.Stock>

@{
    ViewData["Title"] = "Index";
    int i=0;
}
  <div class="container-fluid pt-4 px-4">
                    <div class="bg-light rounded h-100" style="padding: 0px;">
                        <div class="d-flex align-items-center border-bottom py-3" style="padding-left: 1rem;padding-right: 1rem;">   
                            <img class="flex-shrink-0" src="/img/emplacement.png" alt="" style="width: 40px;">
                            <div class="w-100 ms-3">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-0">
                                        @foreach (var item in ViewBag.emplacement)
                                        {
                                           if (i!=0){<span>, </span>} @item.Nom 
                                            i++;
                                        }
                                     </h6>           
                                </div>
                                 <span>@{i=0;}
                                    @foreach (var item in ViewBag.emplacement)
                                    {
                                     if (i!=0){<span>, </span>}  @item.Description 
                                       i++;
                                    }
                                    </span><br/> 
                            </div>
                        </div> 
                    </div>
                </div>


<div class="container-fluid pt-4 px-4">
                <div class="bg-light text-center rounded p-4">
                    <div class="card">
                        <div class="body">
                            <form>
                            <div class="input-group">
                                <input type="search" id="search" class="form-control" placeholder="Barre de recherche...">
                                <div class="input-group-append">
                                <span class="input-group-text" id="search-mail">
                                    <i class="icon-magnifier"></i>
                                </span>
                                </div>
                            </div>
                            </form>
                        </div>
                        </div>
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h6 class="mb-0">Liste des Articles</h6>
                       
                    </div>
                    <div id="dvData" style="overflow: auto;" class="container">
                    <table id="testfiltre" class="table table-bordered" style="white-space: nowrap;">
                        <tr>
                            <th>Action</th>
                            <th>Catégorie</th>
                            <th>Article</th>
                            <th>Emplacement</th>
                            <th>Quantité en stock</th>
                            <th>Unité</th>
                            <th>Prix de vente</th>
                            <th>Stock mimimal</th>
                            <th>Coût moyen pondéré</th>
                            <th>Chiffre d'affaire</th>
                            <th>Commandes</th>
                        </tr>

                        @foreach (var item in Model)
                        {
                        <tr class="montest">
                            <td><button  type="button" onclick="location.href='/Stock/Edit/@item.Id';" class="btn btn-outline-secondary" title="Modifier"><i class="fa fa-pencil"></i> </button>
                                  <button  type="button" onclick="location.href='/Stock/Delete/@item.Id';" class="btn btn-outline-secondary" title="Supprimer"><i class="fa fa-trash"></i> </button>
                                  <button  type="button" onclick="location.href='/Stock/Details/@item.Id';" class="btn btn-outline-secondary" title="Supprimer"><i class="fa fa-eye"></i> </button>
                           </td>
                            <td>@item.Categorie</td>
                            <td>@item.Nom_article</td>
                            <td>@item.Lieu_stockage</td>
                            @if(item.Quantitee!=null){ <td>@((int)item.Quantitee)</td>}else{<td></td>}
                            <td>@item.unité</td>
                            <td>@Html.DisplayFor(modelItem => item.Prix_vente)</td>
                            <td>@Html.DisplayFor(modelItem => item.Stock_minimal)</td>
                            <td>@Html.DisplayFor(modelItem => item.Prix_achat)</td>
                            <td>@Html.DisplayFor(modelItem => item.chiffre_affaire)</td>
                            <td ><input type="text"></td>
                        </tr>
                        }
                     
                    </table>
                  
                    </div>
                   
                </div>
</div>
@if (ViewData["empl"]!=null)
{
    <a  style="position: fixed;right: 150px;bottom: 45px;" asp-action="Create" asp-route-emplacement="@ViewData["empl"]" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
}
<a  style="color: white;position: fixed;right: 100px;bottom: 45px;" onclick="return tableToExcel('testfiltre', 'Example Table');" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-file-excel-o"></i></a>
<a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Index" asp-route-emplacement="@ViewData["empl"]"  class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-square"></i></a>

