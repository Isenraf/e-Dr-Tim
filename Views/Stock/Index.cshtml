@model IEnumerable<BANA.Models.Stock>

@{
    ViewData["Title"] = "stock"+ @ViewData["empl"];
    //int i=0;
}

<link href="/css/stock.css" rel="stylesheet">
<!-- App container starts -->
        <div class="app-container">
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Stock @ViewData["empl"]
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

<!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-success">Nombre d'articles</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1 separateur">@ViewData["valeur"]</span>
                      <span class="text-danger">Valeur stock</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["qte"]</span>
                      <span class="text-info">Quantité totale</span>
                    </div>

                    <button type="button" onclick="filtrerBadge('notify-badge')" class="btn btn-success">
                      <i class="ri-filter-fill"></i>
                    </button>
                    <button type="button" onclick="filtrerBadge('notify-badge2')" class="btn btn-danger">
                      <i class="ri-filter-fill"></i>
                    </button>
                    <button type="button" onclick="filtrerBadge('notify-badge3')" class="btn btn-warning">
                      <i class="ri-filter-fill"></i>
                    </button>
                    <button type="button" onclick="filtrerBadge('all')" class="btn btn-light">
                      <i class="ri-filter-fill"></i>
                    </button>
                    
                  </div>
                </div>

 

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3">
                      <div class="card">
                        <div class="card-body">
                          <input
                            type="search" id="search"
                            class="form-control"
                            placeholder="Bare de Recherche"
                          />
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>
                  </div>
                </div>

                <div class="row gx-3 px-2">
                  
                  <div class="wrapper">
                    <div id="testfiltre"  class="grid">
                        @foreach (var item in Model)
                        {
                           
                            <div   class="item montest">
                              <a href="javascript:void(0)" data-target="#login" data-toggle="modal" class="details_stock"> 
                                  <div>
                                    <img  width="60px" height="60px" src="/uploads/img/@item.Img" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11" style="    color: #646464;margin-bottom: 0px;margin-bottom: 0px;max-height: 40px;overflow: hidden;">@item.Nom_article</h6>
                                </div>
                                @if(item.Quantitee!=null && item.Quantitee>=5){<span class="notify-badge">@((int)item.Quantitee)</span>}else if(item.Quantitee!=null && item.Quantitee<=5 && item.Quantitee>0){<span class="notify-badge3">@((int)item.Quantitee)</span>}else if(item.Quantitee!=null && item.Quantitee<=0){<span class="notify-badge2">@((int)item.Quantitee)</span>}else if(item.Quantitee==null){<span class="notify-badge2">0</span>}
                                
                                    <span style="display: none;" class="cl_0">@item.Id</span>
                                    <span style="display: none;" class="cl_00">@item.Nom_article</span>
                                    <span style="display: none;" class="cl_000">@item.Img</span>
                                    <span style="display: none;" class="cl_1">@item.Categorie</span>
                                    <span style="display: none;" class="cl_2">@item.Quantitee</span>
                                    <span style="display: none;" class="cl_3">@item.Stock_minimal</span>
                                    <span style="display: none;" class="cl_4">@item.Prix_vente</span>
                                    <span style="display: none;" class="cl_5">@item.Prix_achat</span>
                                    <span style="display: none;" class="cl_6">@item.Description</span>
                                    <small class="separateur">@((int)item.Prix_vente)CFA</small>
                                </a>
                            </div>
                           
                        }
                        
                    </div>
                </div> 

                </div>
              </div>
            </div>
            <!-- App body ends -->
          </div>
        </div>


<input id="username" type="hidden" value="@ViewBag.user.nom" />
@if (ViewData["empl"]!=null)
{
    <a  style="position: fixed;right: 100px;bottom: 45px;" asp-action="Create" asp-route-emplacement="@ViewData["empl"]" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
}
  <a  style="position: fixed;right: 150px;bottom: 45px;" asp-action="Create" asp-controller="TransactionStock" asp-route-emplacement="@ViewData["empl"]" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-exchange"></i></a>

  <a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Liste" asp-route-emplacement="@ViewData["empl"]"  class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-list"></i></a>     


<div id="login" class="modal fade" role="dialog">
  <div class="modal-dialog">
    
    <div style="background-color: #77b440b5;" class="modal-content">
      <div class="modal-body">
        <button data-dismiss="modal" style="color: #ffffff;" class="close">&times;</button>
        <h3 style="color:white ;"><span id="tt"></span> </h3>
         <img style="float: right;" width="200px" id="imag" src="/uploads/img/" alt="">
        <ul id="det">
            <li style="font-size: 1rem;font-weight: normal;color: white;">Catégorie: <span id="p1" style="font-size: 1rem;font-weight: bold;color: #b3ff8e;"></span></li>
            <li style="font-size: 1rem;font-weight: normal;color: white;">Quantité en stock: <span id="p2" style="font-size: 1rem;font-weight: bold;color: #b3ff8e;"></span></li>
            <li style="font-size: 1rem;font-weight: normal;color: white;">Stock minimal: <span id="p3"style="font-size: 1rem;font-weight: bold;color: #b3ff8e;"></span></li>
            <li style="font-size: 1rem;font-weight: normal;color: white;">Prix de vente: <span id="p4"style="font-size: 1rem;font-weight: bold;color: #b3ff8e;"></span></li>
             <li style="font-size: 1rem;font-weight: normal;color: white;">Coût unitaire pondéré: <span id="p5"style="font-size: 1rem;font-weight: bold;color: #b3ff8e;"></span></li>
            <li style="font-size: 1rem;font-weight: normal;color: white;">Description: <span id="p6"style="font-size: 1rem;font-weight: bold;color: #b3ff8e;"></span></li>
        </ul>
            <button id="detastock" onclick=""  class="btn btn-warning  gradient">Description détaillée</button>
      </div>
    </div>
  </div>  
</div>


<script>
function filtrerBadge(classeBadge) {
    // Récupérer tous les articles
    const items = document.querySelectorAll(".item");

    items.forEach(item => {
        // Cherche si l'item contient un badge de la classe demandée
        const badge = item.querySelector("." + classeBadge);

        if (classeBadge === "all") {
            item.style.display = "block"; // on affiche tout
        } else {
            if (badge) {
                item.style.display = "block"; // correspond au filtre → afficher
            } else {
                item.style.display = "none"; // sinon masquer
            }
        }
    });
}
</script>