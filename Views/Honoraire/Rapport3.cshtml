@model IEnumerable<BANA.Models.Honoraire>
@{
  ViewData["Title"] = "Honoraire des médécins";
  Layout="_Layout3";
  
}


<link rel="stylesheet"  href="/css/select2.min.css">
<link rel="stylesheet" media="print" href="/css/print_hono.css">
<link rel="stylesheet"  href="/css/select2.css">

<style>
  table{
    border-collapse: collapse;
  }
  table tr td
  { 
    page-break-inside:avoid;
    border: 1px solid #ccc;
  }
</style>

   <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Etats
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card py-3 px-3">
              <div class="d-flex align-items-center justify-content-between mt-2 gy-3">
                <h5 class="card-title">Polyclinique de Poitiers<br /><h7 style="font-size: 12px; color: #4c545e">Etat des Honoraires</h7>
                </h5>

                <div class="d-flex flex-wrap gap-1">
                  <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
                    <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                    <span class="me-1 fw-semibold ps-1">@ViewBag.nf</span>
                    <span class="text-success">Nombre de lignes</span>
                  </div>
                  <div
                    class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                  >
                    <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                    <span class="me-1 fw-semibold ps-1"><span class="separateur">@ViewBag.mt</span> FCFA</span>
                    <span class="text-danger">Montant total</span>
                  </div>
                </div>
              </div>
              <br />

              @{
                  List<string> listemedecins = new();
                    List<string> listesecretaires = new();
                    @foreach(var item in ViewBag.select){
                      listemedecins.Add(item.Replace(" ",""));
                    }
                    @foreach(var item in ViewBag.select2){
                      listesecretaires.Add(item);
                    }

            

                }


              <form asp-action="rapport3" method="get">
                            <div class="body">
                              
                                <div class="row g-3">
                                  <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                      <div style="border: 1px solid #ffffff;" class="form-control">
                                        <label class="form-label" for="a2"
                                          >Date de début
                                          <span class="text-danger">*</span></label
                                        >
                                        <input
                                          type="datetime-local"
                                          class="form-control"
                                          id="datedebut"
                                           name="datedebut"  value="@ViewData["debut"]"
                                          style="height: 50px; border: #c3dff1"
                                        />
                                      </div>
                                    </div>
                                  </div>
                                  <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                      <div style="border: 1px solid #ffffff;" class="form-control">
                                        <label class="form-label" for="a2"
                                          >Date de fin</label
                                        >
                                        <input
                                          type="datetime-local"
                                          class="form-control"
                                          id="datefin"
                                          name="datefin"  value="@ViewData["fin"]"
                                          style="height: 50px; border: #c3dff1"
                                        />
                                      </div>
                                    </div>
                                  </div>
                                </div>

                                <div class="row">
                                        <div class="col-md-6"><label>Sécrétaires</label></div>
                                        <div style="display: none;" class="col-md-6 text-right"><label>Select All</label><input id="checkbox2" type="checkbox" /></div>
                                    </div>
                                  <select name="secretaires" id="monSelect1" class="js-select3-multi" multiple="multiple">
                                    @foreach(var item in ViewBag.secretaires){
                                      
                                      if(listesecretaires.Contains(item)){
                                        <option selected>@item</option>
                                      }else{
                                        <option>@item</option>
                                      }
                                      
                                    }
                                      
                                  </select>
                              
                              <div>
                                <div style="display: flex; gap: 10px">
                                  <button type="submit" class="btn btn-info">
                                    <i class="ri-save-3-line"></i> Enregistrer
                                  </button>
                                </div>
                              </div>  
                        </form><br>
             
              

                      <div class="container">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="content">
                                  

                                  
                                  
                                    <div class="row">
                                        <div class="col-md-6"><label>Sélectionnez les médécins</label></div>
                                        <div style="text-align: right;" class="col-md-6"><label>Select All</label><input id="checkbox" type="checkbox" /></div>
                                    </div>
                                  <select name="docta" id="choices" class="js-select2-multi" multiple="multiple">
                                    @foreach(var item in ViewBag.medecins){
                                      
                                      if(listemedecins.Contains(item.Replace(" ",""))){
                                        <option selected>@item</option>
                                      }else{
                                        <option>@item</option>
                                      }
                                      
                                    }
                                  </select>
                               
                                   <div style="display: flex; justify-content: end; gap: 10px">
                                      <button type="button" id="valid_selection" class="btn btn-info await">Valider</button>
                                    </div>
                                    
                                </div>   

                               

                              </div>
                              </div>
                            </div><br>
                            

                         

                  <div class="table-responsive" id="printMe">
                    

                        
                        <br><br>
                      </div>
                    </div>
                    </table>
                    <br />
                   
                    
                  </div>
                  
                </div>
                <!-- App body ends -->
              </div>
         

<a  style="color: white;position: fixed;right: 50px;bottom: 45px;" onclick="ExportToExcel('xlsx')" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-file-excel-o"></i></a>

            <style>
  /* Modale */
      .modal1, .modal2{
      display: none;
      position: fixed;
      z-index: 999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
      position: relative;
      background-color: #fff;
      margin: 5% auto;
      padding: 0;
      width: 80%;
      height: 80%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      }

      .modal-header {
      padding: 10px;
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .modal-body {
      flex: 1;
      overflow: hidden;
      }

      .modal1 iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .modal2 iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .close-btn {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      }
</style>

        <!-- Modal -->
        <div id="pdfModal" class="modal1">
          <div class="modal-content">
            <div class="modal-header">
            <span>📄 Détails Facture </span>
            <button class="close-btn" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
              <iframe id="pdfFrame"  src=""></iframe>
            </div>
          </div>
        </div>


 
