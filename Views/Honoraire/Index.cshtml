  <script>

  // À la fin du rechargement, on restaure la position
  window.addEventListener('load', () => {
    const scrollY = localStorage.getItem('scrollY');
    if (scrollY !== null) {
      window.scrollTo(0, parseInt(scrollY));
      localStorage.removeItem('scrollY'); // Nettoyage après usage
    }
  });
</script>