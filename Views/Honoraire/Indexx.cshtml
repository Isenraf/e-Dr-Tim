@model IEnumerable<BANA.Models.Honoraire>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Honoraires
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card py-3 px-3">
              <div
                class="d-flex align-items-center justify-content-between mt-2"
              >
                <h5 class="card-title">
                  Polyclinique de Poitiers<br /><h7
                    style="font-size: 12px; color: #4c545e"
                    >Honoraires des medecins</h7
                  >
                </h5>
               
                  @* <button type="button" class="btn btn-success await" onclick="rien()" id="calculauto">Calcul automatique</button> *@
                
                

              </div>
              <br />

              <div class="row gx-3 gy-3">
                <div class="card">
                  <div
                    style="
                      display: flex;
                      justify-content: space-between;
                      align-items: center;
                    "
                  >
                    <div>
                      <a href="" style="margin-right: 10px">M.</a>
                      <a href="" style="margin-right: 10px"
                        >Honoraires des medecins</a
                      >
                      
                    </div>

                    <div style="display: flex; gap: 10px">
                      
                    </div>
                  </div>
                </div>
                <div class="col-12">
                  <div class="row gx-3 gy-3">
                  <form asp-action="Index"  method="get">
                    <div class="card">
                      <div class="card-body">
                        <input type="hidden" name="tipe" id="tippe" value="@ViewData["tipe"]">
                        <input type="hidden" name="Etat" value="@ViewData["Etat"]">
                        @{
                            int mois=ViewBag.date.Month;
                            int jour=ViewBag.date.Day;
                            int annee=ViewBag.date.Year;
                            

                            string mois_str="";
                            string jour_str="";
                            if(mois<10){mois_str="0"+mois;}else{mois_str+=mois;}
                            if(jour<10){jour_str="0"+jour;}else{jour_str+=jour;}
                            
                            string date=ViewBag.date.Year+"-"+mois_str+"-"+jour_str;
                            if(jour<=20){mois--;}
                            if(mois==0){mois=12; annee--;}
                            //if(mois==12 && jour>20){mois=12;annee}

                          }
                        <input
                          type="search" id="search" class="form-control" name="numerofacture" value="@ViewData["numerofacture"]"
                          placeholder="Numéro de facture"
                        />
                      </div>

                      <div class="card-body">
                        <div class="m-0">
                          <div class="input-group">
                            <span class="input-group-text">
                              <i class="ri-calendar-todo-line"></i>
                            </span>
                            <input
                              type="date" name="date" id="dateconcernee"  value="@date"
                              class="form-control datepicker"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  </form>
                  </div>

                  <br />
                  <br />
                  <div class="table-responsive">
                    <table
                      class="table truncate m-0"
                      style="width: 100%; border-collapse: collapse"
                    >
                      <thead>
                        <tr>
                          <th>ACTION</th>
                          <th>ACTE</th>
                          <th>N°FACTURE</th>
                          <th>MONTANT</th>
                          <th>POURCENTAGE</th>
                          <th>A PAYER</th>
                          <th>ASSURANCE</th>
                          <th>PATIENT</th>
                          <th>SECRETAIRE</th>
                        </tr>
                      </thead>
                      <tbody id="testfiltre">
                        @{

                        int i=0;
                         foreach (var item in Model)
                          {
                            if(item.Etat=="Cloturé"){
                              <tr  class="montest">
                                <td style="background-color: #8bc34a3b;">
                                  
                                  <span style="position: absolute;margin-top: 33px;color: #126aef;" class="badge badge-pill">@item.Mode_paiement</span>
                                   
                                    
                                    </td>
                                    <td  style="display: none;background-color: #8bc34a3b;" class="id">@item.Id</td>
                                    
                                    <td style="background-color: #8bc34a3b;">
                                    <a href="javascript:void(0);" title="" class="nomacte">@item.Nom</a>
                                    @if(ViewBag.interne[i]==true){<div style="color: #04952d;" class="medecin">@item.Medecin</div>}else{<div style="color: rgb(211, 5, 15);;" class="medecin">@item.Medecin</div>}
                                    

                                    </td>
                                    <td style="background-color: #8bc34a3b;">@item.Numerofacture</td>
                                    
                                    @* <td>@item.Create_date</td> *@
                                    @if(item.Montant!=null){<td style="background-color: #8bc34a3b;" class="separateur montant">@((int)item.Montant)</td>}else{<td style="background-color: #8bc34a3b;" class="separateur montant"></td>}
                                    
                                    <td style="background-color: #8bc34a3b;" class="pourcentage">@item.Pourcentage</td>
                                    <td style="background-color: #8bc34a3b;" class="montantmedecin">@item.Montant_medecin</td>
                                    <td style="background-color: #8bc34a3b;" class="montantpaye">@item.Assurance</td>
                                    <td style="background-color: #8bc34a3b;">@item.Patient</td>
                                    <td style="background-color: #8bc34a3b;">@item.Observation</td>
                                    
                                </tr>
                            }else{
                              <tr class="montest">
                                <td>
                                  <span style="position: absolute;margin-top: 33px;color: #126aef;" class="badge badge-pill">@item.Mode_paiement</span>
                                 
                                  
                                  </td>
                                  <td style="display: none;" class="id">@item.Id</td>
                                  
                                  <td>
                                  <a href="javascript:void(0);" title="" class="nomacte">@item.Nom</a>
                                  @if(ViewBag.interne[i]==true){<div style="color: #04952d;" class="medecin">@item.Medecin</div>}else{<div style="color: rgb(211, 5, 15);;" class="medecin">@item.Medecin</div>}
                                  </td>
                                  <td>@item.Numerofacture</td>
                                  
                                  @* <td>@item.Create_date</td> *@
                                  @if(item.Montant!=null){<td class="separateur montant">@((int)item.Montant)</td>}else{<td class="separateur montant"></td>}
                                  
                                  <td class="pourcentage">@item.Pourcentage</td>
                                  <td class="montantmedecin">@item.Montant_medecin</td>
                                  <td class="montantpaye">@item.Assurance</td>
                                  <td>@item.Patient</td>
                                  
                              </tr>
                            }
                            i++;
                          }
                        }
                      </tbody>
                    </table>
                  </div>

                  <!-- body body end -->
                  
                </div>
              </div>
              <!-- App body ends -->
            </div>
          
