                    List<string> listesecretaires = new();
                    @foreach(var item in ViewBag.select){
                      listemedecins.Add(item.Replace(" ",""));
                    }
                    @foreach(var item in ViewBag.select2){
                      listesecretaires.Add(item);
                    }

            

                }


