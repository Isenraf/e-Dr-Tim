            <style>
  /* Modale */
      .modal1, .modal2{
      display: none;
      position: fixed;
      z-index: 999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
      position: relative;
      background-color: #fff;
      margin: 5% auto;
      padding: 0;
      width: 80%;
      height: 80%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      }

      .modal-header {
      padding: 10px;
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .modal-body {
