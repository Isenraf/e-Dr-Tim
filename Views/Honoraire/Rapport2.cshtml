                            <div class="body">
                              
                                <div class="row g-3">
                                  <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                      <div style="border: 1px solid #ffffff;" class="form-control">
                                        <label class="form-label" for="a2"
                                          >Date de début
                                          <span class="text-danger">*</span></label
                                        >
                                        <input
                                          type="datetime-local"
                                          class="form-control"
                                          id="datedebut"
                                           name="datedebut"  value="@ViewData["debut"]"
                                          style="height: 50px; border: #c3dff1"
                                        />
                                      </div>
                                    </div>
                                  </div>
                                  <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                      <div style="border: 1px solid #ffffff;" class="form-control">
                                        <label class="form-label" for="a2"
                                          >Date de fin</label
                                        >
                                        <input
                                          type="datetime-local"
                                          class="form-control"
                                          id="datefin"
                                          name="datefin"  value="@ViewData["fin"]"
                                          style="height: 50px; border: #c3dff1"
                                        />
