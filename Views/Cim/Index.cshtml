@model IEnumerable<BANA.Models.Cim>

@{
    ViewData["Title"] = "Index";
    int x=1;
    Layout="_Layout3";
}

<link rel="stylesheet" href="/template2/table/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/buttons.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/style.css" />
<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Classification Internationale des Maladies
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card mb-3 px-2">
              <div
                class="card-header d-flex align-items-center justify-content-between"
              >
                <h5 class="card-title">
                  Classification Internationale des Maladies<br /><h7
                    style="font-size: 12px; color: #4c545e"
                    >Classification Internationale des Maladies</h7
                  >
                </h5>
              </div>
              <br />

              <div class="row gx-3 gy-3">
                <div class="row gx-3">
                 
                 
                    <div  id="containerexample" >
                    <table id="example" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                      <thead class="">
                        <tr>
                          <th style="border: solid;white-space: nowrap;">Id</th>
                           <th style="border: solid;white-space: nowrap;">Code</th>
                          <th style="border: solid;white-space: nowrap;">Nom en français</th>
                          <th style="border: solid;white-space: nowrap;">Nom en anglais</th>
                          <th style="border: solid;white-space: nowrap;">Catégorie</th>
                        </tr>
                      </thead>
                      <tbody class="table-bordered">
                            @foreach (var item in Model)
                            {
                              <tr>
                                <td style="border: solid;white-space: nowrap;">@x</td>
                                <td style="border: solid;white-space: nowrap;">@item.Code</td>
                                <td style="border: solid;white-space: nowrap;">@item.Nom</td>
                                <td style="border: solid;white-space: nowrap;">@item.Maladie_en </td>
                                <td style="border: solid;white-space: nowrap; text-align:right;">@item.Trump1</td>
                              </tr>
                              x++;
                            }
                      </tbody>
                    </table>
                    <br />
                    <br />
                  </div>

                 
                </div>
              </div>
              <!-- App body ends -->
            </div>
          </div>

          <div id="loadercontainer">
            <div class="d-flex justify-content-center" id="loader" style="color: #126aef;">
                <div class="spinner-border" role="status">
                  <span class="sr-only">Loading...</span>
                </div>
            </div>
          </div>
        
<input id="username" type="hidden" value="@ViewBag.user.nom" />
