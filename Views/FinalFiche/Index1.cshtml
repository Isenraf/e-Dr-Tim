@model IEnumerable<BANA.Models.FinalFiche>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Documents médicaux
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                
                <div class="card-header">
                  
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      
                      <span><h6>Documents médicaux</h6></span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-success">Total Documents médicaux</span>
                    </div>

                  </div>
                </div>

                <div class="card-body">
                  <!-- barre de recherche start-->
                  <div class="card">
                    <div class="card-body">
                      <input
                        id="search"
                        type="search"
                        class="form-control"
                        placeholder="Bare de Recherche"
                      />
                    </div>
                  </div>
                  <!-- barre de recheche end -->

                  <div class="table-outer">
                    <div class="table-responsive">
                      <table class="table truncate m-0">
                        <thead>
                          <tr>
                            <th><strong>Nomination</strong></th>
                            <th><strong>Patient</strong></th>
                            <th><strong>Dossier</strong></th>
                            <th><strong>date Création</strong></th>
                            <th><strong>date dernière modification</strong></th>
                            <th><strong>Actions</strong></th>
                          </tr>
                        </thead>

                        <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                            <tr class="montest">
                              <td>
                                  <div class="d-flex align-items-center">
                                    <img src="/template2/assets/images/invoice.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="@item.Nom"/>
                                    <div class="ml-3">
                                    <a asp-action="Details2" asp-route-Id="@item.Id" title="">@item.Nom</a>
                                      
                                      <p style="max-width: 300px; overflow: hidden" class="mb-0">
                                        @item.Categorie
                                      </p>
                                    </div>
                                  </div>
                                </td>
                                <td>@item.Patient</td>
                                <td>@item.Numero_dossier</td>
                                <td>@item.Create_date</td>
                                <td>@item.Dernieremodification</td>
                                
                                <td> 
                                 
                                  <button  type="button" class="btn btn-outline-secondary" onclick="location.href='/FinalFiche/Details2/@item.Id';" title="afficher la facture">
                                    <i class="fa fa-eye"></i>
                                    </button>
                                   

                              </td>
                            </tr>
                          }

                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- app body end-->
