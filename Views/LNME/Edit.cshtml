@model BANA.Models.LNME

@{
    ViewData["Title"] = "Edit";
    Layout="_Layout3";
}

<!-- App container starts -->
<div class="app-container">
  <!-- App hero header starts -->
  <div class="app-hero-header d-flex align-items-center">
    <!-- Breadcrumb starts -->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
        <a asp-action="Index" asp-controller="Departement">Acceuil</a>
      </li>
      <li class="breadcrumb-item text-primary" aria-current="page">Modifier un médicament</li>
    </ol>
    <!-- Breadcrumb ends -->
  </div>
  <!-- App Hero header ends -->

  <!-- App body starts -->
  <div class="app-body">
    <form asp-action="Edit">
         <input type="hidden" asp-for="Id" />
         <input type="hidden" asp-for="Create_date" />
      <div class="row">
        <div class="col-lg-6 mb-3">
          <div class="card">
            <div class="mb-3">
              <div class="card-body">
                <label class="form-label" for="Nom">Nom</label>
                <input class="form-control inline-block" asp-for="Nom" />
              </div>
               <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-3">
          <div class="card">
            <div class="mb-3">
              <div class="card-body">
                <label class="form-label" for="Categorie">Catégorie</label>
                <input class="form-control inline-block" asp-for="Catégorie" />
              </div>
               <span asp-validation-for="Catégorie" class="text-danger"></span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-3">
          <div class="card">
            <div class="mb-3">
              <div class="card-body">
                <label class="form-label" for="Dosage">Dosage</label>
                <input class="form-control inline-block" asp-for="Dosage" />
              </div>
              <span asp-validation-for="Dosage" class="text-danger"></span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-3">
          <div class="card">
            <div class="mb-3">
              <div class="card-body">
                <label for="Forme" class="form-label">Forme</label>
                <input class="form-control" asp-for="Forme" />
              </div>
              <span asp-validation-for="Forme" class="text-danger"></span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-3">
          <div class="card">
            <div class="mb-3">
              <div class="card-body">
                <label for="dci" class="form-label">DCI</label>
                <input class="form-control" type="text" asp-for="DCI" />
              </div>
              <span asp-validation-for="DCI" class="text-danger"></span>
            </div>
          </div>
        </div>
        <div class="col-lg-6 mb-3">
          <div class="card">
            <div class="mb-3">
              <div class="card-body">
                <div class="form-check">
                  <input class="form-check-input" asp-for="actif" />
                  <label class="form-check-label" for="actif">Activer</label>
                </div>
                <span asp-validation-for="actif" class="text-danger"></span>
              </div>
            </div>
          </div>
        </div>
        <div class="col-sm-12">
          <div class="d-flex gap-2 justify-content-end">
            <button onclick="location.href='history.back()';" class="btn btn-outline-secondary">Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
          </div>
        </div>
      </div>
    </form>
  </div>

  <!-- App body ends -->


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
