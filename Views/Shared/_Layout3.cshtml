@if(ViewData["dmip"]!=null){
   <script>
      document.addEventListener("DOMContentLoaded", function () {
        const dropdownItems = document.querySelectorAll(".dropdown-item");
        const recapContainer = document.getElementById("recapIdentification");

        // Attache les listeners de tous les modals présents (visibles ou non)
        function attachTextareaListeners(modal, button) {
          const allFields = modal.querySelectorAll("textarea, input[type='text'], input[type='number'], select, input[type='checkbox']");

          allFields.forEach((field) => {
            if (!field.classList.contains("listener-added")) {
              const eventType = field.tagName === "SELECT" || field.type === "checkbox" ? "change" : "input";

              field.addEventListener(eventType, () => {
                let shouldUpdate = false;

                // Vérifie si au moins un champ du modal a une valeur ou est coché
                const hasContent = Array.from(allFields).some((el) => {
                  if (el.type === "checkbox") return el.checked;
                  return el.value.trim() !== "";
                });

                if (hasContent) {
                  button.classList.add("btn-updated");
                } else {
                  button.classList.remove("btn-updated");
                }

                updateRecap();
              });

              field.classList.add("listener-added");
            }
          });
        }

        // Pour les boutons déclenchés depuis le menu déroulant
        dropdownItems.forEach((item) => {
          item.addEventListener("click", function (e) {
            e.preventDefault();

            const type = item.getAttribute("data-type");
            const buttonId = `btn-${type}`;
            const button = document.getElementById(buttonId);
            const modalId = button?.getAttribute("data-bs-target")?.replace("#", "");
            const modal = document.getElementById(modalId);

            if (!button || !modal) return;

            // Cacher tous les autres boutons générés par le dropdown
            /*document.querySelectorAll(".specialty-section").forEach((btn) => {
              if (btn.tagName === "BUTTON") btn.classList.add("d-none");
            });*/

            button.classList.remove("d-none");
            attachTextareaListeners(modal, button);
            updateRecap();
          });
        });

        // Pour tous les boutons visibles dès le début (hors dropdown)
        const alwaysVisibleButtons = document.querySelectorAll("button[data-bs-toggle='modal']:not(.specialty-section)");
        alwaysVisibleButtons.forEach((button) => {
          const modalId = button.getAttribute("data-bs-target")?.replace("#", "");
          const modal = document.getElementById(modalId);
          if (modal) {
            attachTextareaListeners(modal, button);
          }
        });

        // Génère le récapitulatif global
        function updateRecap() {
          recapContainer.innerHTML = ""; // Réinitialiser

          const modals = document.querySelectorAll(".modal");

          modals.forEach((modal) => {
            const title = modal.querySelector(".modal-title")?.textContent.trim();
            const contents = [];

            // === TEXTAREAS ===
            modal.querySelectorAll("textarea").forEach((textarea) => {
              const label = modal.querySelector(`label[for="${textarea.id}"]`) || textarea.closest(".mb-3")?.querySelector("label");
              const labelText = label ? label.textContent.trim() : "";
              const value = textarea.value.trim();
              if (value) {
                contents.push({ label: labelText, value });
              }
            });

            // === INPUT TEXT, NUMBER, ETC. ===
            modal.querySelectorAll('input:not([type="checkbox"]):not([type="radio"])').forEach((input) => {
              const label = modal.querySelector(`label[for="${input.id}"]`) || input.closest(".mb-3")?.querySelector("label");
              const labelText = label ? label.textContent.trim() : "";
              const value = input.value.trim();
              if (value) {
                contents.push({ label: labelText, value });
              }
            });

            // === SELECT ===
            modal.querySelectorAll("select").forEach((select) => {
              const label = modal.querySelector(`label[for="${select.id}"]`) || select.closest(".mb-3")?.querySelector("label");
              const labelText = label ? label.textContent.trim() : "";
              const value = select.value.trim();
              if (value && !select.querySelector("option:checked").disabled) {
                contents.push({ label: labelText, value });
              }
            });

            // === CHECKBOX GROUPES ===
            modal.querySelectorAll(".mb-3").forEach((group) => {
              const checkboxes = group.querySelectorAll('input[type="checkbox"]:checked');
              if (checkboxes.length > 0) {
                const groupLabel = group.querySelector("label.form-label")?.textContent.trim() || "Options sélectionnées";

                const checkedValues = Array.from(checkboxes).map((checkbox) => {
                  const label = group.querySelector(`label[for="${checkbox.id}"]`);
                  return label ? label.textContent.trim() : checkbox.value;
                });

                contents.push({
                  label: groupLabel,
                  value: checkedValues.join(", "),
                });
              }
            });

            // === AFFICHAGE ===
            if (contents.length > 0) {
              const block = document.createElement("div");
              block.className = "mb-3 border rounded p-2 bg-light";

              block.innerHTML = `
        <div class="fw-bold text-primary mb-2">${title}</div>
        ${contents
          .map(
            (item) => `
              <div class="mb-2">
                <strong>${item.label}</strong><br>
                <div class="text-muted">${item.value}</div>
              </div>
            `
          )
          .join("<hr class='my-2'>")}
      `;

              recapContainer.appendChild(block);
            }
          });
        }

        function attachRecapListeners() {
          const modals = document.querySelectorAll(".modal");

          modals.forEach((modal) => {
            // textarea
            modal.querySelectorAll("textarea").forEach((el) => {
              el.addEventListener("input", updateRecap);
            });

            // input text, number, etc.
            modal.querySelectorAll('input:not([type="checkbox"]):not([type="radio"])').forEach((el) => {
              el.addEventListener("input", updateRecap);
            });

            // checkbox
            modal.querySelectorAll('input[type="checkbox"]').forEach((el) => {
              el.addEventListener("change", updateRecap);
            });

            // select
            modal.querySelectorAll("select").forEach((el) => {
              el.addEventListener("change", updateRecap);
            });
          });
        }

        updateRecap();
      });
    </script>
}
    

<script>
    let inactivityTime = 0; 
    const maxInactivity = 60 * 60 * 1000; // 60 minutes en ms

    function resetTimer() {
        inactivityTime = 0;
    }

    // Détecte les actions utilisateur
    window.onload = resetTimer;
    document.onmousemove = resetTimer;
    document.onkeypress = resetTimer;
    document.onclick = resetTimer;
    document.onscroll = resetTimer;

    // Vérifie l'inactivité
    setInterval(function () {
        inactivityTime += 1000; // ajoute 1 sec
        if (inactivityTime >= maxInactivity) {
            window.location.href = "/User/Disconnect2"; // redirection vers ton action de déconnexion
        }
    }, 1000);
</script>

