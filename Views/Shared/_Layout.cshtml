<script>
let inputs = document.getElementsByClassName("monInput");

// getElementsByClassName renvoie une "collection", il faut boucler
for (let i = 0; i < inputs.length; i++) {
    inputs[i].addEventListener("change", function () {
        let input = this.value;
        let datalist = document.getElementById(this.getAttribute("list"));
        let options = datalist.getElementsByTagName("option");

        let found = false;
        for (let option of options) {
            if (option.value === input) {
                found = true;
                break;
            }
        }

        if (!found) {
            this.value = ""; // efface si la valeur n’existe pas
        }
    });
}
</script>



 <script>
 const buttons = document.querySelectorAll('button');
      const sideBarMenu = document.querySelectorAll('a');
const loader = document.querySelector("#loading-wrapper");

// Écouteur sur chaque lien
sideBarMenu.forEach(link => {
  link.addEventListener("click", (e) => {
    const href = link.getAttribute("href") || "";

    if (
      href.trim() !== "#" &&
      !href.trim().startsWith("javascript:void") &&
      href.trim() !== ""
      && href.trim() !== "#!"
      && !href.trim().includes("#")
    ) {
      loader.style.display = "block";
    }
  });
});


$(document).on('click', 'button', function(e) {
  if(this.className.includes("await")){
    loader.style.display = "block";
  }
});

// Cacher le loader à l'affichage de la page
window.addEventListener("pageshow", () => {
  loader.style.display = "none";
}); 


// SCROLLING
window.addEventListener("DOMContentLoaded", (e) => {
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  const activeLink = document.querySelector(".active");

  if (activeLink) {
    window.scrollTo(0, 0);

    setTimeout(() => {
      activeLink.scrollIntoView({ behavior: "smooth", block: "start" });
      activeLink.focus();
    }, 100);
  }
});

 </script>

 <script>
    let inactivityTime = 0; 
    const maxInactivity = 60 * 60 * 1000; // 5 minutes en ms

    function resetTimer() {
        inactivityTime = 0;
    }

    // Détecte les actions utilisateur
    window.onload = resetTimer;
    document.onmousemove = resetTimer;
    document.onkeypress = resetTimer;
    document.onclick = resetTimer;
    document.onscroll = resetTimer;

    // Vérifie l'inactivité
    setInterval(function () {
        inactivityTime += 1000; // ajoute 1 sec
        if (inactivityTime >= maxInactivity) {
             window.location.href = "/User/Disconnect"; // redirection vers ton action de déconnexion
        }
    }, 1000);
</script>


