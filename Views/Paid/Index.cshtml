@model IEnumerable<BANA.Models.Paid>

@{
    ViewData["Title"] = "Index";
    int x=1;
}


<link rel="stylesheet" href="/template2/table/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/buttons.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="/template2/table/style.css" />
<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Listing des paiements
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="card mb-3 px-2">
              <div
                class="card-header d-flex align-items-center justify-content-between"
              >
                <h5 class="card-title">
                  Polyclinique de Poitiers<br /><h7
                    style="font-size: 12px; color: #4c545e"
                    >Listing des paiements</h7
                  >
                </h5>

                <div class="d-flex flex-wrap gap-1">
                   <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <h6 class="text-success">@ViewData["arg1"] - @ViewData["arg2"] - @ViewData["arg3"]</h6>
                    </div>

                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1 separateur">@Model.Select(x=>x.Montant).Sum()</span>
                      <span class="text-success">Total</span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-info">Nombre de Transactions</span>
                    </div>
                  </div>

              </div>
              <br />

              <div class="row gx-3 gy-3">
                <div class="row gx-3">
                 
                 
                    <div  id="containerexample" >
                    <table id="example" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                      <thead class="">
                        <tr>
                          <th style="border: solid;white-space: nowrap;">Id</th>
                          <th style="border: solid;white-space: nowrap;" ><strong>#Numéro facture</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Date de paiement</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Patient</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Numéro dossier</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Montant</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Moyen Paiement</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Frais de retrait</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Caissier</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Caisse</strong></th>
                          <th style="border: solid;white-space: nowrap;"><strong>Observation</strong></th>
                        </tr>
                      </thead>
                      <tbody class="table-bordered">
                            @foreach (var item in Model)
                            {
                              
                              <tr class="montest">
                                <td style="border: solid;white-space: nowrap;">@x</td>
                                  @if (item.fact_type.Contains("caution"))
                                  {
                                    <td style="border: solid;white-space: nowrap;">#Caution Nº: @item.Numero_facture</td>
                                  }else{
                                    <td style="border: solid;white-space: nowrap;">#Facture Nº: @item.Numero_facture</td>
                                  }
                                  
                                  <td style="border: solid;white-space: nowrap;">@item.Create_date.ToString("dd/MM/yyyy") @item.Create_date.ToShortTimeString()</td>
                                  <td style="border: solid;white-space: nowrap;">@item.Patient</td>
                                  <td style="border: solid;white-space: nowrap;">@item.Numero_dossier</td>
                                  <td style="border: solid;white-space: nowrap;"><span class="separateur">@item.Montant</span> FCFA</td>
                                  <td style="border: solid;white-space: nowrap;">@item.Moyen_paiement</td>
                                  <td style="border: solid;white-space: nowrap;"><span class="separateur">@item.Frais_retrait</span> FCFA</td>
                                  <td style="border: solid;white-space: nowrap;">@item.Caissier</td>
                                  <td style="border: solid;white-space: nowrap;">@item.caisse</td>
                                  <td style="border: solid;white-space: nowrap;">@item.Observation</td>
                              </tr>
                              x++;
                            }
                      </tbody>
                    </table>
                    <br />
                    <br />
                  </div>

                 
                </div>
              </div>
              <!-- App body ends -->
            </div>
          </div>

          <div id="loadercontainer">
            <div class="d-flex justify-content-center" id="loader" style="color: #126aef;">
                <div class="spinner-border" role="status">
                  <span class="sr-only">Loading...</span>
                </div>
            </div>
          </div>
        
<input id="username" type="hidden" value="@ViewBag.user.nom" />


