@model BANA.Models.Hospi

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
  <style>
      @@media print {
        body * {
          visibility: hidden;
        }

        .card,
        .card * {
          visibility: visible;
        }

        .card {
          position: absolute;
          left: 0;
          top: 0;
          box-shadow: none;
        }

        /* Hide buttons */
        .card button,
        .custom-daterange {
          visibility: hidden !important;
        }

        /* Force hide the last column header & cells */
        .card table th:last-child[rowspan="2"],
        .card table td:last-child {
          display: none !important;
          visibility: hidden !important;
        }
      }
    </style>
<script src="/template2/assets/js/chart.js"></script>
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                PARAMÈTRES VITAUX
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- App body starts -->
    <div class="app-body">



        <div class="col-sm-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">PARAMÈTRES VITAUX</h5>
                    <div>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print()">
                            Imprimer
                        </button>

                        <button type="button" class="btn btn-outline-info btn-sm add-modal" onclick="location.href='/Parametre/Create?nd=@Model.Numero_facture'">
                            Ajouter un parametre
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" onclick="location.href='/Hospi/Details/@Model.Id'">
                            Dossier Hospitalisation
                        </button>
                    </div>
                </div>

                <div class="card-body">
                  <div class="">
                        <div class="d-flex mb-3 align-items-end justify-content-between">
                                    <!-- Stats starts -->
                                    <div class="d-flex align-items-center flex-wrap gap-4">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box lg bg-primary rounded-5 me-2">
                                                <i class="ri-account-circle-line fs-3"></i>
                                            </div>
                                            <div>
                                              <p class="m-0">Nom du patient</p>
                                                <h4 class="mb-1">@ViewBag.patient.Nom @ViewBag.patient.Prenom</h4>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box lg bg-primary rounded-5 me-2">
                                                @if(ViewBag.patient.Genre=="M"){<i class="ri-men-line fs-3"></i>}else{<i class="ri-women-line fs-3"></i>}
                                            </div>
                                            <div>
                                              <p class="m-0">Genre</p>
                                                <h4 class="mb-1">@ViewBag.patient.Genre</h4>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box lg bg-primary rounded-5 me-2">
                                                <i class="ri-arrow-right-up-line fs-3"></i>
                                            </div>
                                            <div>
                                              <p class="m-0">Âge du patient</p>
                                                <h4 class="mb-1">@((int)(DateTime.Now-ViewBag.patient.DateNaissance).TotalDays/365) ans</h4>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box lg bg-primary rounded-5 me-2">
                                                <i class="ri-contrast-drop-2-line fs-3"></i>
                                            </div>
                                            <div>
                                               <p class="m-0">Groupe sanguin</p>
                                                <h4 class="mb-1">@ViewBag.patient.GroupeSanguin</h4>
                                            </div>
                                        </div>
                                        
                                    </div>
                                    <!-- Stats ends -->
                                    @if(ViewBag.patient.Genre=="M"){
                                      <img style="width: 100px;height: 100px;" src="/template2/assets/images/patient2.png" class="ms-auto" alt="@ViewBag.patient.Nom @ViewBag.patient.Prenom" />
                                    }else{
                                      <img style="width: 100px;height: 100px;" src="/template2/assets/images/patient1.jpg" class="ms-auto" alt="@ViewBag.patient.Nom @ViewBag.patient.Prenom" />
                                    }           
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive mb-3">
                            <table class="table table-bordered truncate m-0 text-center">
                                <caption class="small text-center" style="caption-side: top; font-weight: bold;"></caption>
                                <thead>
                                    <tr>
                                        <th rowspan="2">Heure</th>
                                        <th rowspan="2">
                                            Température <br />
                                            Adulte
                                        </th>
                                        <th rowspan="2">
                                            Température <br />
                                            Bébé
                                        </th>
                                        <th colspan="3">Bras Gauche</th>
                                        <th colspan="3">Bras Droit</th>
                                        <th rowspan="2">Infirmier</th>
                                    </tr>

                                    <tr>
                                        <th>Systolique</th>
                                        <th>Diastolique</th>
                                        <th>Pouls</th>
                                        <th>Systolique</th>
                                        <th>Diastolique</th>
                                        <th>Pouls</th>
                                    </tr>
                                </thead>

                                @if(ViewBag.parametres!=null){
                                            <tbody>
                                                @foreach(var item in ViewBag.parametres){
                                                    <tr>
                                                        <th>@item.Create_date</th>
                                                        <th>@item.Temperature</th>
                                                        <th></th>
                                                        <th>@item.Tsysbg</th>
                                                        <th>@item.Tdiasbg</th>
                                                        <th>@item.Pbg</th>
                                                        <th>@item.Tsysbd</th>
                                                        <th>@item.Tdiasbd</th>
                                                        <th>@item.Pbd</th>
                                                        <th>@item.Infirmier</th>
                                                    </tr>
                                                }
                                             </tbody> 
                                    }
                            </table>
                        </div>
                    </div><br><br><br>

                    <!-- charts -->
                    <div style="display: flex; flex-wrap: wrap; gap: 30px; justify-content: center;">
                        <div>
                            <h6>Température (Adulte & Bébé)</h6>
                            <canvas id="tempChart" width="400" height="200"></canvas>
                        </div>

                        <div>
                            <h6>Tension Bras Gauche (Systolique & Diastolique)</h6>
                            <canvas id="tensionChartBG" width="400" height="200"></canvas>
                        </div>

                        <div>
                            <h6>Tension Bras Droit (Systolique & Diastolique)</h6>
                            <canvas id="tensionChartBD" width="400" height="200"></canvas>
                        </div>

                        <div>
                            <h6>Pouls (Gauche & Droit)</h6>
                            <canvas id="poulsChart" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- App body ends -->
</div>

<!-- My script -->
    <script>
      let state = [];

      const caption = document.querySelector("caption");
      const tableBody = document.querySelector("table tbody");
      const form = document.querySelector("#myForm");
      const cancelBtn = document.querySelector(
        '.modal-footer button[type="button"]'
      );
      const closeBtn = document.querySelector(".btn-close");
      const addButton = document.querySelector(".add-modal");
      const todaysDate = new Date().toLocaleString().split(",")[0];

      // Initialisation des graphs
      const tempCtx = document.getElementById("tempChart").getContext("2d");
      const poulsCtx = document.getElementById("poulsChart").getContext("2d");
      const tensionBGCtx = document
        .getElementById("tensionChartBG")
        .getContext("2d");
      const tensionBDCtx = document
        .getElementById("tensionChartBD")
        .getContext("2d");

      const tempChart = new Chart(tempCtx, {
        type: "line",
        data: {
          labels: [],
          datasets: [
            {
              label: "Température Adulte",
              data: [],
              borderColor: "#e74c3c",
              backgroundColor: "#e74c3c",
              fill: false,
            },
            {
              label: "Température Bébé",
              data: [],
              borderColor: "#f39c12",
              backgroundColor: "#f39c12",
              fill: false,
            },
          ],
        },
        options: {
          responsive: true,
          scales: {
            x: {
              title: { display: true, text: "Heure" },
            },
            y: {
              title: { display: true, text: "Température (°C)" },
              min: 30,
              max: 42,
            },
          },
        },
      });

      const poulsChart = new Chart(poulsCtx, {
        type: "line",
        data: {
          labels: [],
          datasets: [
            {
              label: "Pouls Gauche",
              data: [],
              borderColor: "#27ae60",
              backgroundColor: "#27ae60",
              fill: false,
            },
            {
              label: "Pouls Droit",
              data: [],
              borderColor: "#f1c40f",
              backgroundColor: "#f1c40f",
              fill: false,
            },
          ],
        },
        options: {
          responsive: true,
          scales: {
            x: {
              title: { display: true, text: "Heure" },
            },
            y: {
              title: { display: true, text: "BPM" },
              min: 30,
              max: 150,
            },
          },
        },
      });

      const tensionBGChart = new Chart(tensionBGCtx, {
        type: "line",
        data: {
          labels: [],
          datasets: [
            {
              label: "Systolique",
              data: [],
              borderColor: "#2980b9",
              backgroundColor: "#2980b9",
              fill: false,
            },
            {
              label: "Diastolique",
              data: [],
              borderColor: "#8e44ad",
              backgroundColor: "#8e44ad",
              fill: false,
            },
          ],
        },
        options: {
          responsive: true,
          scales: {
            x: {
              title: { display: true, text: "Heure" },
            },
            y: {
              title: { display: true, text: "Pression (mmHg)" },
              min: 40,
              max: 300,
            },
          },
        },
      });

      const tensionBDChart = new Chart(tensionBDCtx, {
        type: "line",
        data: {
          labels: [],
          datasets: [
            {
              label: "Systolique",
              data: [],
              borderColor: "#2980b9",
              backgroundColor: "#2980b9",
              fill: false,
            },
            {
              label: "Diastolique",
              data: [],
              borderColor: "#8e44ad",
              backgroundColor: "#8e44ad",
              fill: false,
            },
          ],
        },
        options: {
          responsive: true,
          scales: {
            x: {
              title: { display: true, text: "Heure" },
            },
            y: {
              title: { display: true, text: "Pression (mmHg)" },
              min: 40,
              max: 300,
            },
          },
        },
      });

      function clearChartData(ch) {
        ch.data.labels = [];
        ch.data.datasets.forEach((dataset) => {
          dataset.data = [];
        });
        ch.update();
      }

      function render() {
        clearChartData(tempChart);
        clearChartData(poulsChart);
        clearChartData(tensionBGChart);
        clearChartData(tensionBDChart);

        state.forEach(
          (
            {
              time,
              adultTemperature,
              babeTemperature,
              tensionSBG,
              tensionSBD,
              tensionDBG,
              tensionDBD,
              poulBD,
              poulBG,
            },
            index
          ) => {
            // temperature
            time = time.split(" ")[1];
            tempChart.data.labels.push(time);
            tempChart.data.datasets[0].data.push(parseFloat(adultTemperature));
            tempChart.data.datasets[1].data.push(parseFloat(babeTemperature));
            tempChart.update();

            tensionBGChart.data.labels.push(time);
            tensionBGChart.data.datasets[0].data.push(parseFloat(tensionSBG));
            tensionBGChart.data.datasets[1].data.push(parseFloat(tensionDBG));
            tensionBGChart.update();

            tensionBDChart.data.labels.push(time);
            tensionBDChart.data.datasets[0].data.push(parseFloat(tensionSBD));
            tensionBDChart.data.datasets[1].data.push(parseFloat(tensionDBD));
            tensionBDChart.update();

            poulsChart.data.labels.push(time);
            poulsChart.data.datasets[0].data.push(parseFloat(poulBG));
            poulsChart.data.datasets[1].data.push(parseFloat(poulBD));
            poulsChart.update();
          }
        );
      }

      function loadExistingTableData() {
        const rows = document.querySelectorAll("table tbody tr");
        rows.forEach((tr) => {
          const cells = tr.querySelectorAll("td");
          if (cells.length >= 10) {
            const rowData = {
              time: cells[0].textContent.trim(),
              adultTemperature: cells[1].textContent.trim(),
              babeTemperature: cells[2].textContent.trim(),
              tensionSBG: cells[3].textContent.trim(),
              tensionDBG: cells[4].textContent.trim(),
              poulBG: cells[5].textContent.trim(),
              tensionSBD: cells[6].textContent.trim(),
              tensionDBD: cells[7].textContent.trim(),
              poulBD: cells[8].textContent.trim(),
              infirmier: cells[9].textContent.trim(),
            };
            state.push(rowData);
          }
        });
      }

      caption.textContent = todaysDate;

      closeBtn.addEventListener("click", function () {
        form.reset();
      });
      cancelBtn.addEventListener("click", function () {
        form.reset();
      });

      window.addEventListener("DOMContentLoaded", () => {
        loadExistingTableData();
        render();
      });
    </script>