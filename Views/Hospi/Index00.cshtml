@model IEnumerable<BANA.Models.Hospi>

@{
    ViewData["Title"] = "Index";
    int x=1;
    Layout="_Layout3";
}


<script>
    window.addEventListener("pageshow", function (event) {
        if (event.persisted || (window.performance && window.performance.getEntriesByType("navigation")[0].type === "back_forward")) {
            // La page vient de l'historique (back/forward)
            location.reload(); // Force le rechargement
        }
    });
</script>


<link href="/css/stock.css" rel="stylesheet">
<div class="app-container">
@if(ViewBag.patient!=null){
  <!-- App hero header starts -->
            <div class="app-hero-header d-flex align-items-center">
                <!-- Breadcrumb starts -->
                
                
                <!-- Breadcrumb ends -->

                <!-- Sales stats starts -->
                <div class="d-lg-flex d-none flex-row">
                    <div class="d-flex flex-row gap-1 day-sorting">
                        
                        <div class="d-flex align-items-center">
                            <div class="icon-box lg bg-primary rounded-5 me-2">
                                <i class="ri-account-circle-line fs-3"></i>
                            </div>
                                <div>
                                    <p class="m-0">Nom du patient</p>
                                    <h5 class="mb-1">@ViewBag.patient.Nom @ViewBag.patient.Prenom</h5>
                                    
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-box lg bg-primary rounded-5 me-2">
                                    @if(ViewBag.patient.Genre=="M"){<i class="ri-men-line fs-3"></i>}else{<i class="ri-women-line fs-3"></i>}
                                </div>
                                <div>
                                    <p class="m-0">Genre</p>
                                    <h5 class="mb-1">@ViewBag.patient.Genre</h5>
                                    
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-box lg bg-primary rounded-5 me-2">
                                    <i class="ri-arrow-right-up-line fs-3"></i>
                                </div>
                                <div>
                                    <p class="m-0">Âge du patient</p>
                                    <h5 class="mb-1">@((int)(DateTime.Now-ViewBag.patient.DateNaissance).TotalDays/365) ans</h5>
                                    
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="icon-box lg bg-primary rounded-5 me-2">
                                    <i class="ri-contrast-drop-2-line fs-3"></i>
                                </div>
                                <div>
                                    <p class="m-0">Groupe sanguin</p>
                                    <h5 class="mb-1">@ViewBag.patient.GroupeSanguin</h5>
                                    
                                </div>
                            </div>
                            @if(ViewBag.patient.Genre=="M"){
                                <img style="width: 60px;height: 60px;" src="/template2/assets/images/patient2.png" class="ms-auto" alt="@ViewBag.patient.Nom @ViewBag.patient.Prenom" />
                            }else{
                                <img style="width: 60px;height: 60px;" src="/template2/assets/images/patient1.jpg" class="ms-auto" alt="@ViewBag.patient.Nom @ViewBag.patient.Prenom" />
                            }
                                       
                    </div>
                </div>
                <!-- Sales stats ends -->
            </div>
            <!-- App Hero header ends -->
}else{
<!-- App container starts -->
        
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Hospitalisations En cours
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->
}
<!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
               

               <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title">Hospitalisations <br><span style="font-size: 12px; color: #4c545e"><span>  
                    Liste des patients hospitalisés</h5>
                </div>

                 <!-- Modal ajouter parametres -->
                <div class="modal fade" id="addparametre" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Numéro du reçu patient</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="Create" method="get">
                            <div class="modal-body text-center">
                                <img style="width: 100px; height: 100px;" class="img-fluid mb-3" src="/template2/assets/images/documents.png" alt="dossier" />
                                <input class="form-control" name="nd" type="number" placeholder="N° Facture" required />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                <button type="submit" class="btn btn-primary" data-bs-dismiss="modal">Continuer</button>
                            </div>
                            </form>
                        </div>
                    </div>
                </div>

              <br />
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                       <span class="text-danger">patients</span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-danger">En cours</span>
                    </div>
                    
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3">
                      <div class="card">
                        <div class="card-body">
                        <form asp-controller="Cim" asp-action="Index"  method="get">
                          <input type="search" id="search" name="code" class="form-control" placeholder="Bare de Recherche"/>
                        </form>
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>
                  </div>
                </div>
                @{
                  int i=0;
                }

                <div class="row gx-3 px-2">
                  
                  <div class="wrapper">
                    <div id="testfiltre"  class="grid">
                        @foreach (var item in Model)
                        {
                           
                            <div   class="item montest">
                              <a asp-action="Details" asp-route-Id="@item.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/assets/images/patient.png" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">Chambre: @item.Chambre</h6>
                                </div>
                                </a>
                                 <span class="cl_11">@item.Nom</span> 
                            </div>
                          i++;
                        }
                        
                    </div>
                </div> 

                </div>
              </div>
            </div>
            <!-- App body ends -->
          </div>
        </div>


<script>
  document.querySelectorAll(".texte").forEach(function(p) {
    let mots = p.textContent.split(" ");
    
    if (mots.length >= 2) {
      mots[0] = `<span style="color:#0c90ac;font-weight: bold;">${mots[0]}</span>`;
      mots[1] = `<span style="color:#0c90ac;font-weight: bold;">${mots[1]}</span>`;
    }
    
    p.innerHTML = mots.join(" ");
  });
</script>