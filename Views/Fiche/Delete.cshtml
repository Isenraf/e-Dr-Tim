@model BANA.Models.Fiche

@{
    ViewData["Title"] = "Delete";
}


<style>
  .card{
  margin: auto;
  width: 21cm;
  height: 29.7cm; 
  background-image: url('/img1/pppp2.jpg');
  background-repeat: round;

  }
</style>


<link rel="stylesheet" media="print" href="/css/print.css">
<!-- App container starts -->
<div class="app-container">
  <!-- App hero header starts -->
  <div class="app-hero-header d-flex align-items-center">
    <!-- Breadcrumb starts -->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
        <a asp-action="Index" asp-controller="Departement">Acceuil</a>
      </li>
      <li class="breadcrumb-item text-primary" aria-current="page">
        Fiches editbt certificats médicaux
      </li>
    </ol>
    <!-- Breadcrumb ends -->
  </div>
  <!-- App Hero header ends -->
<input type="hidden" value="@Model.Id" id="identifiant"/>


  <!-- App body start -->
  <div class="app-body">

    <div  style="margin-bottom: 20px;background-color: #126aef12;padding: 10px;border-radius: 10px;text-align: right;" class="">
        <div class="">

        
          <button class="btn btn-outline-secondary" id="closeButton"  onclick="history.back()">
            <i class="fa fa-previous"></i> Fermer</button>

    
        <button class="btn btn-primary theme-bg gradient"  id="printFiche0">
            <i class="fa fa-print"></i> Print</button>

        </div>
      </div>



    <div class="col-sm-12">

          <div class="row clearfix">
            
            <div class="col-lg-12">
              <div id="tdt1" class="card card2">
                
                  <div style="padding: 15px;margin-top: 21%;">
                 

                  <div class="row clearfix">
                   @Html.Raw(Model.Contenu.Replace("</p><p></p><p>","<br/><br/><br/>").Replace("</p><p>","<br/>"))

                  </div> 
                  <br>
                   <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button class="btn btn-danger theme-bg gradient"><i class="fa fa-trash"></i> Confirmez la suppression</button>
                    </form>

                  <div class="row clearfix">
                    <div class="col-md-6">
                      <span>
                        <input  id="text" type="text" value="https://www.polycliniquedepoitiers.com/Fiche/Create" style="display: none;" />
                    </div>
                   
                  </div>
                </div>
              </div>
            </div>
          </div>

          </div>
        </div>

      <!-- App body end -->

