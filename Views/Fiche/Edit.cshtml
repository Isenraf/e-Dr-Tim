@model BANA.Models.Fiche

@{
    ViewData["Title"] = "Edit";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Fiche Médicale
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <h5 class="card-title">
                    Polyclinique de Poitiers<br /><h7
                      style="font-size: 12px; color: #4c545e"
                      >Création d'une Fiche Médicale,</h7
                    >
                  </h5>
                </div>

                <div class="card-body">
                  <form>
                    <input type="hidden" id="identifiant"asp-for="Id">
                    <div class="row gap-3">
                      @if (ViewData["error"]!=null)
                      {
                        <div class="alert alert-danger" role="alert">
                          Cette élément existe déjà !
                        </div>
                      }
                      <div class="row">
                       
                        <div class="card-header">
                            Informations fiche
                        </div>
                        <div class="col-md-6 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2">Nomination<span class="text-danger">*</span></label>
                              <input asp-for="Nom" id="nomfiche" class="form-control" style="height: 50px; border: #c3dff1"  placeholder="Entrer le montant">
                              <span asp-validation-for="Nom" class="text-danger"></span>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6 col-12">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="a2" >Catégorie<span class="text-danger">*</span></label>
                              <div class="input-group">
                                <select asp-for="Categorie" id="cat" class="form-control" style="height: 50px; border: #c3dff1">
                                  <option asp-for="Categorie" value="Fiche Médicale">Fiche Médicale</option>
                                  <option asp-for="Categorie" value="Certificat Médical">Certificat Médical</option>
                                  <option asp-for="Categorie" value="Fiche Administrative">Fiche Administrative</option>
                                </select>
                              </div>
                               <span asp-validation-for="Categorie" class="text-danger"></span>
                            </div>
                          </div>
                        </div>

                        <div class="col-12">
                                <iframe style="min-height: 33cm;width: 100%;" src="/Fiche/Edit00/@Model.Id" frameborder="0"></iframe>
                        </div>
                      </div>
                    </div>
                    
                    <div style="display: flex; justify-content: end; gap: 10px">
                      <button type="button" id="savefiche" class="btn btn-info">
                        <i class="ri-save-3-line"></i> Enregistrer
                      </button>
                      <div class="d-flex flex-wrap gap-2">
                        <button type="button" onclick="history.back()" class="btn btn-outline-secondary">
                          Annuler
                        </button>
                      </div>
                    </div>

                  </form>
                </div>
              </div>
            </div>
            <!-- app body end-->
          </div>
              

