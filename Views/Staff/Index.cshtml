@model IEnumerable<BANA.Models.Staff>

@{
    ViewData["Title"] = "Index";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Notre personnel
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["Actifs"]</span>
                      <span class="text-success">Actifs</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@ViewData["Inactifs"]</span>
                      <span class="text-danger">Inactifs</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-info">Total</span>
                    </div>
                    <a href="/Staff/Create" class="btn btn-primary btn-sm ms-auto">Ajouter Nouveau</a>
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3 mb-2">
                      <div class="card">
                        <div class="card-body">
                          <input
                            type="search"
                            id="search"
                            class="form-control"
                            placeholder="Bare de Recherche"
                          />
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>

                    <div class="table-outer">
                      <div class="table-responsive">
                        <table class="table truncate m-0">
                          <thead>
                            <tr>
                               <th>Action</th>
                              <th>#</th>
                              <th>Nom</th>
                              <th>Fonction</th>
                              <th>Address</th>
                              <th>Email</th>
                             
                            </tr>
                          </thead>

                          <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="montest">
                                      <td><a href="/Staff/Edit/@item.Id" class="btn btn-outline-secondary"><i class="ri-edit-2-line"></i></a>
                                          <a href="/Staff/Delete/@item.Id" class="btn btn-outline-secondary"><i class="ri-delete-bin-5-line"></i></a>
                                          <button class="btn btn-outline-success">
                                            Whatsapp
                                          </button>
                                      </td>
                                      <td><img src="/template/assets/images/xs/avatar1.jpg" class="img-shadow img-2xx me-2 rounded-circle" alt="@item.Nom"/>
                                      </td>
                                      <td style="text-align: left;">
                                        <div class="d-flex align-items-center">
                                          <div class="ml-3">
                                            <a title="" href="#" class="text-primary">@item.Nom</a>
                                            <p style="max-width: 300px; overflow: hidden" class="mb-0">@item.Phone</p>
                                          </div>
                                        </div>
                                      </td>
                                      <td style="text-align: left;">@item.Désignation</td>
                                      <td style="text-align: left;">@item.Adresse</td>
                                      <td style="text-align: left;">@item.Email</td>
                                      
                                </tr>
                                
                            } 

                            

                           

                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- App body ends -->
          </div>

<a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
<a  style="color: white;position: fixed;right: 100px;bottom: 45px;" onclick="return tableToExcel('testfiltre', 'Example Table');" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-file-excel-o"></i></a>
