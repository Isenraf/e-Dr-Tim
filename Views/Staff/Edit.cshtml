@model BANA.Models.Staff

@{
    ViewData["Title"] = "Edit";
}

<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">Contact</li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <div class="col-sm-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title">
            Polyclinique de Poitiers<br /><h7 style="font-size: 12px; color: #4c545e">Ajouter un nouvel employé</h7>
          </h5>
                </div>

                <div class="card-body">
                    <form asp-action="Edit">
                      <input type="hidden" asp-for="Id">
                      <input type="hidden" asp-for=Create_date>
                        <div class="row gap-3">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Nom et prénom
                                                <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="Nom" type="text" class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Nom" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Adresse Email </label><span class="text-danger">*</span>
                                            <input  asp-for=Email type="text" class="form-control" style="height: 50px; border: #c3dff1" />
                                            
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Fonction </label>
                                            <input list="cat" asp-for="Désignation" class="form-control" style="height: 50px; border: #c3dff1">
                                            <datalist id="cat">
                                                @foreach (var item in ViewBag.cat)
                                                {
                                                    <option asp-for="Désignation" value="@item">@item</option>
                                                }
                                            </datalist>
                                          <span asp-validation-for="Désignation" class="text-danger"></span> 
                                           
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Numéro de téléphone</label><span class="text-danger">*</span>
                                            <input asp-for="Phone" type="tel" class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Phone" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                  <div class="form-group c_form_group">
                                    <label>Addresse
                                      <span class="text-danger"></span>
                                    </label>
                                    <input asp-for="Adresse" class="form-control" style="height: 50px; border: #c3dff1">
                                    <span asp-validation-for="Adresse" class="text-danger"></span>
                                  </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Saisir un commentaire...</label>
                                            <textarea asp-for=Description style="height: 100px" class="form-control" name="" id="" placeholder="Saisir un commentaire..."></textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="form-check">
                            <input asp-for="Actif" class="form-check-input" type="checkbox"  id="flexCheckDefault" />
                            <label class="form-check-label" for="flexCheckDefault">Activer</label>
                        </div>
                        <div style="display: flex; justify-content: end; gap: 10px">
                            <button onclick="history.back()" type="button"  class="btn btn-outline-secondary">
                                Annuler
                            </button>
                            <button type="submit" class="btn btn-info">
                                <i class="ri-save-3-line"></i> Enregistrer
                            </button>
                            
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div>
        <!-- app body end-->
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
