@model IEnumerable<BANA.Models.Emplacement>

@{
    ViewData["Title"] = "Emplacements";
}

<!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Emplacements
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-info">Internes</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-info">Externes</span>
                    </div>
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-info fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-info">Total</span>
                    </div>
                  </div>
                </div>

                <div class="card-body">
                  <div
                    id="customButtons_filter"
                    class="dataTables_filter"
                    style="text-align: right; margin-bottom: 5px"
                  >
                    <!--barre de recherche start -->
                    <div class="row gx-3 gy-3">
                      <div class="card">
                        <div class="card-body">
                          <input
                            type="search"
                            class="form-control"
                            placeholder="Bare de Recherche"
                          />
                        </div>
                      </div>
                      <!-- barre de recherche end -->
                    </div>
                  </div>
                </div>

                <div class="row gx-3 px-2">
                  @foreach (var item in Model)
                            {
                                
                            <div class="col-sm-12 col-xl-6 montest" style="margin-bottom:10px ;">
                                <div class="bg-light rounded h-100 p-4">
                                    
                                    <div class="d-flex align-items-center border-bottom py-3">
                                        
                                            <img class="flex-shrink-0" src="/img/emplacement.png" alt="" style="width: 60px;margin: 10px;">
                                                <div class="w-100 ms-3">
                                                    <div class="d-flex w-100 justify-content-between">
                                                       <a asp-action="Index" asp-controller="Stock" asp-route-emplacement="@item.Nom" ><h6 class="mb-0">@item.Nom</h6></a> 
                                                        
                                                    </div>
                                            <span>@item.Description</span><br/>
                                            <small>Crée le: @item.Create_date</small><br/>
                                            <small>Dernière modification le: @item.LastModification</small>
                                    </div>
                                        

                                        @if (item.Nom!="PHARMACIE" && item.Nom!="MAGASIN GÉNÉRAL")
                                        {
                                            <a asp-action="Edit" asp-route-Id=@item.Id style="margin: 5px;" ><i class="fa fa-edit"></i></a>
                                            <a asp-action="Delete" asp-route-Id=@item.Id style="margin: 5px;"><i class="fa fa-trash"></i></a> 
                                        }else{
                                          <a href="javascript:void(0);" style="pointer-events: none;color: gray;text-decoration: none;cursor: default;margin: 5px;" ><i class="fa fa-edit"></i></a> 
                                          <a href="javascript:void(0);"  style="pointer-events: none;color: gray;text-decoration: none;cursor: default;margin: 5px;"><i class="fa fa-trash"></i></a> 
                                        }
                                        
                                </div> 
                                </div>
                            </div>
                                        
                                
                            }

                </div>
              </div>
              <!-- App body ends -->
            </div>
          </div>

<a  style="position: fixed;right: 50px;bottom: 45px;" href="/Emplacement/Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
