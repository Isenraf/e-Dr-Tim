@model BANA.Models.Emplacement

@{
    ViewData["Title"] = "Create";
}

 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Emplacements
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                <div class="card-header">
                  <h5 class="card-title">
                    Polyclinique de Poitiers<br /><h7
                      style="font-size: 12px; color: #4c545e"
                      >Créer un emplacement,</h7
                    >
                  </h5>
                </div>
                <div class="card align-items-center">
                    <img class="img-7x " src="/img/emplacement.png" alt="emplacement">
                </div>

                <div class="card-body">
                  <form asp-action="Create">
                        <div class="col">
                          <div class="card mb-3">
                            <div class="form-control">
                              <label class="form-label" for="">Nom de l'emplacement
                                <span class="text-danger">*</span>
                              </label>
                              <input asp-for="Nom" type="text" class="form-control" style="height: 50px; border: #c3dff1"/>
                              <span asp-validation-for="Nom" class="text-danger"></span>
                            </div>
                          </div>
                        </div>
                       <div class="col mb-4">
                            <textarea asp-for="Description" style="height: 100px;"   class=" form-control" name="" id=""placeholder="Description de l'emplacement"></textarea>
                        </div>
                       <div style="display: flex; justify-content: end; gap: 10px">
                      
                 
                        <button type="button" onclick="history.back()" class="btn btn-outline-secondary">
                          Annuler
                        </button>
                        <button type="submit" class="btn btn-info">
                        <i class="ri-save-3-line"></i> Enregistrer
                      </button>
                      
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
          </div>
            <!-- app body end-->



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
