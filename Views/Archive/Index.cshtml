@model IEnumerable<BANA.Models.FichierModel>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
 <!-- App container starts -->
        <div class="app-container">
          <!-- App hero header starts -->
          <div class="app-hero-header d-flex align-items-center">
            <!-- Breadcrumb starts -->
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
              </li>
              <li class="breadcrumb-item text-primary" aria-current="page">
                Archives
              </li>
            </ol>
            <!-- Breadcrumb ends -->
          </div>
          <!-- App Hero header ends -->

          <!-- app body start -->
          <div class="app-body">
            <div class="col-sm-12">
              <div class="card mb-3">
                
                <div class="card-header">
                  
                  <div class="d-flex flex-wrap gap-1">
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      
                      <span><h6>Archives médicaux</h6></span>
                    </div>
                    
                    <div
                      class="d-flex align-items-center box-shadow px-3 py-1 rounded-2"
                    >
                      <i class="ri-pie-chart-2-fill text-success fs-4"></i>
                      <span class="me-1 fw-semibold ps-1">@Model.Count()</span>
                      <span class="text-success">Total Archives</span>
                    </div>

                  </div>
                </div>

                <div class="card-body">
                  <!-- barre de recherche start-->
                  <div class="card">
                    <div class="card-body">
                      <input
                        id="search"
                        type="search"
                        class="form-control"
                        placeholder="Bare de Recherche"
                      />
                    </div>
                  </div>
                  <!-- barre de recheche end -->

                  <div class="table-outer">
                    <div class="table-responsive">
                      <table class="table truncate m-0">
                        <thead>
                          <tr>
                            <th><strong>Nomination</strong></th>
                            <th><strong>date Création</strong></th>
                            <th><strong>date dernière modif</strong></th>
                            <th><strong>Taille</strong></th>
                            <th><strong>Actions</strong></th>
                          </tr>
                        </thead>

                        <tbody id="testfiltre">
                          @foreach (var item in Model)
                          {
                            <tr class="montest">
                              <td>
                                  <div class="d-flex align-items-center">
                                    <img src="/template2/assets/images/invoice.png" style="box-shadow: 0 5px 5px rgb(18 106 239);" class="img-2xx me-2" alt="@item.Nom"/>
                                    <div class="ml-3">
                                    <a asp-action="Details2" asp-route-Id="@item.Nom" title="">@item.Nom</a>
                                      
                                      <p style="max-width: 300px; overflow: hidden" class="mb-0">
                                        
                                      </p>
                                    </div>
                                  </div>
                                </td>
                                <td>@item.DateCreation</td>
                                <td>@item.DateModification</td>
                                <td>@item.TailleKo ko</td>
                                
                                
                                <td> 
                                 
                                  <button  type="button" class="btn btn-outline-secondary fichearchive"  title="afficher la facture">
                                  <input type="hidden" value="@item.Numero_dossier"><span style="display:none">@item.Nom</span>
                                    <i class="fa fa-eye"></i>
                                    </button>
                                   
                              </td>
                            </tr>
                          }

                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- app body end-->

        <a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Create" asp-route-dossier="@ViewData["doss"]" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>



<style>
  /* Modale */
      .modal, .modal2{
      display: none;
      position: fixed;
      z-index: 999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: rgba(0, 0, 0, 0.6);
      }

      .modal-content {
      position: relative;
      background-color: #fff;
      margin: 5% auto;
      padding: 0;
      width: 80%;
      height: 80%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      }

      .modal-header {
      padding: 10px;
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .modal-body {
      flex: 1;
      overflow: hidden;
      }

      .modal iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .modal2 iframe {
      width: 100%;
      height: 100%;
      border: none;
      }

      .close-btn {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      }
</style>



<style>
   .button-group {
  text-align: left; /* optional, ensures alignment */
}

.button-group button {
  margin-right: 8px; /* spacing between buttons */
}

   .btn1 {
   
  border: none;
  height: 2.5em;
  border-radius: 0.5em;
  justify-content: center;
  align-items: center;
  gap: 12px;
  background: #0B8FAC;
  cursor: pointer;
  transition: all 450ms ease-in-out;
}

.sparkle {
  fill: #fff;
  transition: all 800ms ease;
}

.text1 {
  font-weight: 600;
  color: #fff;
  font-size: medium;
}

.btn1:hover {
  background: linear-gradient(0deg,#0B8FAC,#0B8FAC);
  box-shadow: inset 0px 1px 0px 0px rgba(255, 255, 255, 0.4),
  inset 0px -4px 0px 0px rgba(0, 0, 0, 0.2),
  0px 0px 0px 4px rgba(255, 255, 255, 0.2),
  0px 0px 180px 0px #0B8FAC;
  transform: translateY(-2px);
}

.btn1:hover .text {
  color: white;
}

.btn1:hover .sparkle {
  fill: white;
  transform: scale(1.2);
} 
  </style>

<!-- Modal -->
<div id="pdfModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
    <span>
    

<div class="action-container">
    <div class="btn-group">
        <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="text1">Interrogez Dr Tim IA</span>
            <svg height="24" width="24" fill="#FFFFFF" viewBox="0 0 24 24" class="sparkle">
                <path d="M10,21.236,6.755,14.745.264,11.5,6.755,8.255,10,1.764l3.245,6.491L19.736,11.5l-6.491,3.245ZM18,21l1.5,3L21,21l3-1.5L21,18l-1.5-3L18,18l-3,1.5ZM19.333,4.667,20.5,7l1.167-2.333L24,3.5,21.667,2.333,20.5,0,19.333,2.333,17,3.5Z"></path>
            </svg>
        </button>

        <ul class="dropdown-menu p-3" style="min-width: 800px;">
            <li>
                <div class="row">
                    <!-- Colonne gauche : question -->
                    <div class="col-md-6 border-end">
                        <div class="d-flex flex-column gap-2">
                            <textarea rows="5" class="form-control inputObs" placeholder="Demandez à Dr Tim IA"></textarea>
                            <button type="button" class="btn btn-primary d-flex align-items-center justify-content-center gap-2" id="btnValider">
                                Validez
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M9 18l6-6-6-6"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Colonne droite : résultat (invisible par défaut) -->
                    <div class="col-md-6 d-none" id="colResultat">
                        <div class="bg-light border rounded p-2" id="resultatIA" style="min-height: 150px;">
                            <em>Le résultat de l'analyse s'affichera ici...</em>
                        </div>
                    </div>
                </div>
            </li>
        </ul>
    </div>
</div>




     
    </span>
    <button class="close-btn" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
    <iframe id="target" src=""></iframe> <!-- Remplace par ton PDF -->
    </div>
   
  </div>
</div>




<script>
const textarea = document.querySelector('.inputObs');
const colResultat = document.getElementById('colResultat');
const result = document.getElementById('resultatIA');
const btnValider = document.getElementById('btnValider');

// Quand on écrit dans le textarea
textarea.addEventListener('input', () => {
    const value = textarea.value.trim();
    if(value !== "") {
        colResultat.classList.remove('d-none'); // Affiche la colonne droite
        result.innerHTML = "<p>Analyse en cours...</p>"; // Texte temporaire
    } else {
        colResultat.classList.add('d-none'); // Cache si vide
    }
});

// Quand on clique sur Validez
btnValider.addEventListener('click', () => {
  event.stopPropagation();
    const value = textarea.value.trim();
    if(value !== "") {
        // Affiche le texte final ou résultat IA
        result.innerHTML = `<p>Résultat final : ${value}</p>`;
    }
});
</script>



<script>
    const modal = document.getElementById('pdfModal');
    function closeModal() {
      modal.style.display = 'none';
      document.getElementById("target").setAttribute("src", "");
    }

    // Fermer si on clique en dehors du contenu
    window.onclick = event => {
      if (event.target === modal) {
        closeModal();
      }
    };
</script>
