@model IEnumerable<BANA.Models.Dmi>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}

<link href="/css/stock2.css" rel="stylesheet">
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Ordonnances patients
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <div class="card px-3 py-3">
            <!-- Row starts -->
            <div class="row gx-3">
                <div class="col-sm-12">
                     <div class="d-flex justify-content-end gap-2 my-2">
                        <a class="btn btn-light" onclick="history.back()" href="#">Retour</a>
                    </div> 
                </div>
            </div>
            <!-- Row ends -->

         
               <div class="row gx-3 px-2">
                  <div class="wrapper">
                    <div id="testfiltre"  class="grid">
                        
                           @foreach(var item in Model){
                            <div   class="item montest">
                              <a asp-controller="Dmi" asp-action="Details2" asp-route-Id="@item.Id" class="details_stock"> 
                                  <div>
                                      <img  width="100px" height="100px" src="/template2/assets/images/ordo.png" alt=""> 
                                  </div>
                                  
                                <div class="media-body blog-std" style="padding-top: -15px;">
                                <h6 class="cl11 badge bg-primary" style="margin-bottom: 0px;margin-bottom: 0px;">@item.Medecin</h6>
                                <p>@item.CreateDate</p>
                                </div>
                                </a>
                            </div>
                           }
                            

                            
                            



                            




                       
                        
                    </div>
                </div> 
            </div>
            <!-- Row starts -->
        </div>
        <!-- App body ends -->
    </div>
</div>

