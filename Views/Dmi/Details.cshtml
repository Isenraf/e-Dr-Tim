            <!-- JS pour affichage titre rapport -->
    <script>
      function toggleSection(sectionId) {
        const section = document.getElementById(sectionId);
        if (!section) return;

        let visible = false;

        // Vérifier tous les spans
        section.querySelectorAll("span").forEach((el) => {
          if (el.textContent.trim() !== "") visible = true;
        });

        // Vérifier toutes les cellules de tableau
        section.querySelectorAll("td").forEach((el) => {
          if (el.textContent.trim() !== "") visible = true;
        });

        // Vérifier tous les divs qui contiennent du texte (pas les titres)
        section.querySelectorAll("div").forEach((el) => {
          if (!el.classList.contains("bg-info") && el.textContent.trim() !== "") visible = true;
        });

        // Afficher ou cacher la section
        section.classList.toggle("d-none", !visible);
      }

      function updateAllSections() {
        document.querySelectorAll(".rapport-section").forEach((sec) => {
          toggleSection(sec.id);
        });
      }

      document.addEventListener("DOMContentLoaded", updateAllSections);

      // Mise à jour à chaque saisie ou changement
      document.addEventListener("input", updateAllSections);
      document.addEventListener("change", updateAllSections);

      // Observer les changements dynamiques
      const observer = new MutationObserver(updateAllSections);
      document.querySelectorAll(".rapport-section").forEach((sec) => {
        observer.observe(sec, { childList: true, subtree: true });
      });
    </script>

   
   <script>
function imprimerDiv(divId) {
    // Taille de la fenêtre
    var width = 800;
    var height = 600;

    // Calcul pour centrer la fenêtre
    var left = (window.screen.width / 2) - (width / 2);
    var top = (window.screen.height / 2) - (height / 2);

    // Ouvre la fenêtre centrée
    var fenetreImpression = window.open(
        '',
        '',
        `width=${width},height=${height},top=${top},left=${left}`
    );

    // Contenu à imprimer
    var contenu = document.getElementById(divId).innerHTML;

    // Copie le CSS de la page
    var styles = "";
    document.querySelectorAll("link[rel='stylesheet'], style").forEach((node) => {
        styles += node.outerHTML;
    });

    // Ajoute un padding pour l'impression
    styles += `<style>body { padding: 20px; }</style>`;

    // Écrit la page avec le CSS + padding
    fenetreImpression.document.write('<html><head><title>Impression</title>');
    fenetreImpression.document.write(styles);
    fenetreImpression.document.write('</head><body>');
    fenetreImpression.document.write(contenu);
    fenetreImpression.document.write('</body></html>');

    fenetreImpression.document.close();
    fenetreImpression.print();
}
</script>