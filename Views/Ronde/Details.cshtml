@model BANA.Models.Ronde

@{
    ViewData["Title"] = "Details";
    Layout="_Layout3";
}
<style>
      
      h1,
      h2 {
        font-weight: bolder;
      }

      header,
      h1,
      h2,
      section {
        padding: 16px 24px;
      }

      header {
        border-bottom: 1px solid;
        display: flex;
        justify-content: space-between;
        align-items: end;
        background-color: #0b8fac;
        color: #f8f9fa;
      }

      header h2 {
        padding: 0;
      }

      header a {
        color: #f8f9fa;
      }

      h1 {
        display: flex;
        align-items: start;
        justify-content: space-between;
        color: #0b8fac;
        font-size: 30px;
      }

      h1 img {
        width: 50px;
        height: auto;
      }

      img {
        width: 75px;
        height: auto;
      }

      section h6 {
        padding: 0px;
        /* background-color: #15aabf; */
        color: #0b8fac;
      }

      section {
        border-bottom: 1px solid #ced4da;
      }

      section:last-child {
        border-bottom: 0;
      }

      /* header h2 {
        color: #2b8a3e;
      } */

      .clinic {
        border: 1px solid #ced4da;
        border-radius: 10px;
        padding: 16px;
        background: #f9fbff;
        font-size: 0.95rem;
      }

      #wrapper {
        max-width: 960px;
        height: auto;
        margin: 16px auto !important;
        /* background-color: #15aabf; */
      }

      #report {
        /* padding: 40px; */
        background-color: white;
        /* border-top-right-radius: 10% 15%;
        border-bottom-right-radius: 10% 15%; */
        display: flex;
        flex-direction: column;
        /* row-gap: 8px; */
        outline: 1px solid #ced4da;
      }

      .right-text {
        text-align: right;
      }

      .left-text {
        display: flex;
        column-gap: 4px;
      }
    </style>
<!-- App container starts -->
<div style="padding-left: 20px;padding-right: 20px;" class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Fiche de ronde
            </li>
        </ol>
        <!-- Breadcrumb ends -->

    </div>
    <!-- App Hero header ends -->


    <!-- Card starts -->
    <div class="card mb-3">
        
        <div class="card-body">
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <button type="button" onclick="location.href='/Hospi/Fiche6/@Model.NumeroDossier'" class="btn btn-primary">
            Créer une nouvelle fiche
            </button>
            @foreach(var item in ViewBag.rondes){
            <button type="button" onclick="window.location.href='@Url.Action("Details", "Ronde", new { id = item.Id })'" class="btn btn-secondary">
               Dr @item.Medecin @item.CreateDate
            </button>
            }
        </div>
        </div>
    </div>
    <!-- Card ends -->
</div>

<!-- App body starts -->
<div class="app-body">
    <div class="row gx-3">
        <div class="col-12 col-sm-12 col-xl-6">
            <div class="card h-100 mb-3">
                <div class="card-body">
                    <!-- Contenu de la fiche médecin -->
                    <div id="wrapper mt-0 p-0">
                            <header>
                                <div class="left-text">
                                    <div>
                                        <h2>MEDECIN</h2>
                                        <h6>@Model.Medecin</h6>
                                    </div>
                                </div>
                            </header>

                            <section>
                                <h6 class="mb-2">Plainte</h6>

                                <div class="row row-gap-2">
                                    <div class="col-sm-12">
                                        <div>
                                            @Model.Plainte
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section>
                                @Html.Raw(Model.Parametres)
                            </section>

                            <section>
                                <h6 class="mb-2">Examen physique du jour</h6>

                                <div class="row row-gap-2">
                                    <div class="col-sm-12">
                                        <div>
                                           @Model.Epj
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section>
                                <h6 class="mb-2">Examens</h6>
                                <div id="examens-container">
                                    <ul class="list-group">
                                    @foreach(var item in Model.Trumps){
                                        <li class="list-group-item">
                                           @item
                                        </li>
                                    }
                                        
                                        
                                    </ul>
                                </div>
                            </section>

                            <section>
                                <h6 class="mb-2">Actes Médicaux</h6>
                                <div id="examens-container">
                                    <ul class="list-group">
                                    @foreach(var item in Model.Trumps4){
                                        <li class="list-group-item">
                                           @item
                                        </li>
                                    }
                                        
                                        
                                    </ul>
                                </div>
                            </section>


                            <section>
                                <h6 class="mb-2">Médicaments</h6>
                                <div id="medicaments-container">
                                    <ul class="list-group">
                                        @foreach(var item in Model.Trumps2){
                                            <li class="list-group-item">
                                            @item
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </section>

                            <section>
                                <h6 class="mb-2">Conclusion</h6>

                                <div class="row row-gap-2">
                                    <div class="col-sm-12">
                                        <div>
                                            @Model.Pc
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section style="border-left: 4px solid orange;">
                                <h6 class="mb-2">Conduite à tenir</h6>
                                <div id="cat-container">
                                    <ol class="list-group">
                                        @foreach(var item in Model.Trumps3){
                                            <li class="list-group-item">
                                            @item
                                            </li>
                                        }
                                       
                                    </ol>
                                </div>
                            </section>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-12 col-xl-6">
            <div class="card h-100 mb-3">
                <div class="card-body">
                    <!-- Contenu de la fiche infirmière -->
                    <div>
                            <header>
                                <div class="left-text">
                                    <div>
                                        <h4>FICHE DE RONDE INFIRMIERE</h4>
                                    </div>
                                </div>
                            </header>
                        <div id="taf">
                            
                            @if(Model.Taf==null){
                                <section>
                                <h6 class="mb-2">Examens a faire</h6>
                                <ul id="nurse-exams" class="list-group">
                            
                                @for(int i=0;i<Model.Trumps.Count();i+=2){
                                    <li class="list-group-item mb-2" id="med-7">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span><strong>@Model.Trumps[i]</strong>- @Model.Trumps[i+1]</span>

                                            <div style="min-width: 70px;">
                                                <div class="btn-group me-1">
                                                    <button type="button" class="btn btn-success btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Fait">
                                                        <i class="ri-checkbox-circle-line"></i>
                                                    </button>

                                                    <ul class="dropdown-menu p-2">
                                                        <li class="d-flex flex-column row-gap-2">
                                                            <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                            <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'fait')">
                                                                Valider
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>

                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-danger btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Non Fait">
                                                        <i class="ri-close-circle-line"></i>
                                                    </button>
                                                    <ul class="dropdown-menu p-2">
                                                        <li class="d-flex flex-column row-gap-2">
                                                            <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                            <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'Non')">
                                                                Valider
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </li>

                                        
                                    }
                                </ul>
                            </section>



                            <section>
                                <h6 class="mb-2">Actes Médicaux</h6>
                                <ul id="nurse-meds" class="list-group">
                                    @for(int i=0;i<Model.Trumps4.Count();i+=2){
                                        <li class="list-group-item mb-2" id="med-7">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span><strong>@Model.Trumps4[i]</strong>- @Model.Trumps4[i+1]</span>

                                                <div style="min-width: 70px;">
                                                    <div class="btn-group me-1">
                                                        <button type="button" class="btn btn-success btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Fait">
                                                            <i class="ri-checkbox-circle-line"></i>
                                                        </button>

                                                        <ul class="dropdown-menu p-2">
                                                            <li class="d-flex flex-column row-gap-2">
                                                                <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                                <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'fait')">
                                                                    Valider
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </div>

                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-danger btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Non Fait">
                                                            <i class="ri-close-circle-line"></i>
                                                        </button>
                                                        <ul class="dropdown-menu p-2">
                                                            <li class="d-flex flex-column row-gap-2">
                                                                <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                                <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'Non')">
                                                                    Valider
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </section>

                            <section>
                                <h6 class="mb-2">Médicaments a prendre</h6>
                                <ul id="nurse-meds" class="list-group">
                                    @for(int i=0;i<Model.Trumps2.Count();i+=2){
                                        <li class="list-group-item mb-2" id="med-7">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span><strong>@Model.Trumps2[i]</strong>- @Model.Trumps2[i+1]</span>

                                                <div style="min-width: 70px;">
                                                    <div class="btn-group me-1">
                                                        <button type="button" class="btn btn-success btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Fait">
                                                            <i class="ri-checkbox-circle-line"></i>
                                                        </button>

                                                        <ul class="dropdown-menu p-2">
                                                            <li class="d-flex flex-column row-gap-2">
                                                                <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                                <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'fait')">
                                                                    Valider
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </div>

                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-danger btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Non Fait">
                                                            <i class="ri-close-circle-line"></i>
                                                        </button>
                                                        <ul class="dropdown-menu p-2">
                                                            <li class="d-flex flex-column row-gap-2">
                                                                <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                                <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'Non')">
                                                                    Valider
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </section>



                            <section>
                                <h6 class="mb-2">Conduite a tenir</h6>
                                <ul id="nurse-conduite" class="list-group">
                                @for(int i=0;i<Model.Trumps3.Count();i++){
                                        <li class="list-group-item mb-2" id="med-7">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span><strong>@Model.Trumps3[i]</strong></span>

                                            <div style="min-width: 70px;">
                                                <div class="btn-group me-1">
                                                    <button type="button" class="btn btn-success btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Fait">
                                                        <i class="ri-checkbox-circle-line"></i>
                                                    </button>

                                                    <ul class="dropdown-menu p-2">
                                                        <li class="d-flex flex-column row-gap-2">
                                                            <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                            <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'fait')">
                                                                Valider
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>

                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-danger btn-sm" data-bs-placement="top" data-bs-toggle="dropdown" data-bs-title="Non Fait">
                                                        <i class="ri-close-circle-line"></i>
                                                    </button>
                                                    <ul class="dropdown-menu p-2">
                                                        <li class="d-flex flex-column row-gap-2">
                                                            <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                            <button type="button" class="btn btn-outline-info" onclick="validerObservation(event, 'Non')">
                                                                Valider
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    }
                                </ul>
                            </section>
                            }else{
                                @Html.Raw(Model.Taf);
                            }
                            
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- App body ends -->

<button type="button" style="position:fixed;right: 45px;bottom: 45px;" onclick="window.location.href='/Hospi/Details/@Model.NumeroDossier'" class="btn btn-primary">
  <i class="ri-corner-up-left-line"></i>
</button>

<input type="hidden" name="" id="trumpronde">
<input type="hidden" value="@Model.Id" id="identifiant">
<input type="hidden" id="uss" value="@ViewBag.user.nom">

<script src="/js/ronde.js" ></script>


