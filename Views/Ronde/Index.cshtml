@model IEnumerable<BANA.Models.Ronde>

@{
    ViewData["Title"] = "Index";
    Layout="_Layout3";
}
<style>
      

      h1,
      h2 {
        font-weight: bolder;
      }

      header,
      h1,
      h2,
      section {
        padding: 16px 24px;
      }

      header {
        border-bottom: 1px solid;
        display: flex;
        justify-content: space-between;
        align-items: end;
        background-color: #0b8fac;
        color: #f8f9fa;
      }

      header h2 {
        padding: 0;
      }

      header a {
        color: #f8f9fa;
      }

      h1 {
        display: flex;
        align-items: start;
        justify-content: space-between;
        color: #0b8fac;
        font-size: 30px;
      }

      h1 img {
        width: 50px;
        height: auto;
      }

      img {
        width: 75px;
        height: auto;
      }

      section h6 {
        padding: 0px;
        /* background-color: #15aabf; */
        color: #0b8fac;
      }

      section {
        border-bottom: 1px solid #ced4da;
      }

      section:last-child {
        border-bottom: 0;
      }

      /* header h2 {
        color: #2b8a3e;
      } */

      .clinic {
        border: 1px solid #ced4da;
        border-radius: 10px;
        padding: 16px;
        background: #f9fbff;
        font-size: 0.95rem;
      }

      #wrapper {
        max-width: 960px;
        height: auto;
        margin: 16px auto !important;
        /* background-color: #15aabf; */
      }

      #report {
        /* padding: 40px; */
        background-color: white;
        /* border-top-right-radius: 10% 15%;
        border-bottom-right-radius: 10% 15%; */
        display: flex;
        flex-direction: column;
        /* row-gap: 8px; */
        outline: 1px solid #ced4da;
      }

      .right-text {
        text-align: right;
      }

      .left-text {
        display: flex;
        column-gap: 4px;
      }
    </style>
<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Fiche de ronde
            </li>
        </ol>
        <!-- Breadcrumb ends -->

    </div>
    <!-- App Hero header ends -->


        <!-- Card starts -->
        <div class="card mb-3">
          
          <div class="card-body">
            <div class="d-flex flex-wrap gap-2 justify-content-end">
              <button type="button" onclick="location.href='/Hospi/Fiche6/@Model.First().NumeroDossier'" class="btn btn-primary">
                Créer une nouvelle fiche
              </button>
              @foreach(var item in Model){
                <button type="button" onclick="window.location.href='@Url.Action("Details", "Ronde", new { id = item.Id })'" class="btn btn-secondary">
                  @item.Medecin @item.CreateDate
                </button>
              }
            </div>
          </div>
        </div>
        <!-- Card ends -->
    </div>

<!-- App body starts -->
<div class="app-body">
    <div class="row gx-3">
        <div class="col-12 col-sm-12 col-xl-6">
            <div class="card h-100 mb-3">
                <div class="card-body">
                    <!-- Contenu de la fiche médecin -->
                    <div id="wrapper mt-0 p-0">
                        <form id="report">
                            <header>
                                <div class="left-text">
                                    <div>
                                        <h2>MEDECIN</h2>
                                        <h6>@Model.First().Medecin</h6>
                                    </div>
                                </div>
                            </header>

                            <section>
                                <h6 class="mb-2">Plainte</h6>

                                <div class="row row-gap-2">
                                    <div class="col-sm-12">
                                        <div>
                                            @Model.First().Plainte
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section>
                                @Html.Raw(Model.First().Parametres)
                            </section>

                            <section>
                                <h6 class="mb-2">Examen physique du jour</h6>

                                <div class="row row-gap-2">
                                    <div class="col-sm-12">
                                        <div>
                                           @Model.First().Epj
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section>
                                <h6 class="mb-2">Examens</h6>
                                <div id="examens-container">
                                    <ul class="list-group">
                                    @foreach(var item in Model.First().Trumps){
                                        <li class="list-group-item">
                                           @item
                                        </li>
                                    }
                                        
                                        
                                    </ul>
                                </div>
                            </section>

                            <section>
                                <h6 class="mb-2">Médicaments</h6>
                                <div id="medicaments-container">
                                    <ul class="list-group">
                                        @foreach(var item in Model.First().Trumps2){
                                            <li class="list-group-item">
                                            @item
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </section>

                            <section>
                                <h6 class="mb-2">Conclusion</h6>

                                <div class="row row-gap-2">
                                    <div class="col-sm-12">
                                        <div>
                                            @Model.First().Pc
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section style="border-left: 4px solid orange;">
                                <h6 class="mb-2">Conduite à tenir</h6>
                                <div id="cat-container">
                                    <ol class="list-group">
                                        @foreach(var item in Model.First().Trumps3){
                                            <li class="list-group-item">
                                            @item
                                            </li>
                                        }
                                       
                                    </ol>
                                </div>
                            </section>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-12 col-xl-6">
            <div class="card h-100 mb-3">
                <div class="card-body">
                    <!-- Contenu de la fiche infirmière -->
                    <div id="wrapper mt-0 p-0">
                        <form id="report">
                            <header>
                                <div class="left-text">
                                    <div>
                                        <h4>FICHE DE RONDE INFIRMIERE</h4>
                                    </div>
                                </div>
                            </header>

                            <section>
                                <h6 class="mb-2">Examens a faire</h6>
                                <ul id="nurse-exams" class="list-group"></ul>
                            </section>

                            <section>
                                <h6 class="mb-2">Médicaments a prendre</h6>
                                <ul id="nurse-meds" class="list-group">
                                    <li class="list-group-item mb-2" id="med-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span>Vitamine C — 2 fois par jour</span>

                                            <div>
                                                <div class="btn-group me-1">
                                                    <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown">
                                                        Fait
                                                    </button>

                                                    <ul class="dropdown-menu p-2">
                                                        <li class="d-flex flex-column row-gap-2">
                                                            <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                            <button type="button" class="btn btn-outline-info" onclick="validerObservation(0, 'fait', 'med', this.parentNode.querySelector('textarea'), infirmierName)">
                                                                Valider
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>

                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-outline-danger dropdown-toggle" data-bs-toggle="dropdown">
                                                        Non Fait
                                                    </button>
                                                    <ul class="dropdown-menu p-2">
                                                        <li class="d-flex flex-column row-gap-2">
                                                            <textarea class="form-control" rows="3" placeholder="Observation"></textarea>
                                                            <button type="button" class="btn btn-outline-info" onclick="validerObservation(0, 'non', 'med', this.parentNode.querySelector('textarea'), infirmierName)">
                                                                Valider
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </li>

                                    <li class="list-group-item mb-2" id="med-0" style="border-left: 4px solid rgb(40, 167, 69);">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span>Paracétamol — 2 fois par jour</span>
                                            <div></div>
                                        </div>
                                        <div class="mt-2 rounded obs-filled"><strong>Infirmier Dupont:</strong> blabla</div>
                                    </li>

                                    <li class="list-group-item mb-2" id="med-0" style="border-left: 4px solid rgb(220, 53, 69);">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span>Ibuprofène — 1 fois par jour</span>
                                            <div></div>
                                        </div>
                                        <div class="mt-2 rounded obs-filled"><strong>Infirmier Dupont:</strong> what</div>
                                    </li>
                                </ul>
                            </section>

                            <section>
                                <h6 class="mb-2">Conduite a tenir</h6>
                                <ul id="nurse-conduite" class="list-group"></ul>
                            </section>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- App body ends -->


<script>
      const infirmierName = "Infirmier Dupont";

      // --- Validation ---
      function validerObservation(index, etat, type, textarea, infirmierName) {
        const li = document.getElementById(`${type}-${index}`);
        if (!li) return;

        const observation = textarea.value.trim();

        // Supprime les boutons
        li.querySelectorAll(".btn-group").forEach((b) => b.remove());

        // Affiche l'observation avec seulement le nom de l'infirmier
        const obsDiv = document.createElement("div");
        obsDiv.classList.add("mt-2", "p-2", "rounded", "obs-filled");
        obsDiv.innerHTML = `<strong>${infirmierName}:</strong> ${observation}`;
        li.appendChild(obsDiv);

        // Bordure selon état
        li.style.borderLeft =
          etat === "fait" ? "4px solid #28a745" : "4px solid #dc3545";
      }
    </script>