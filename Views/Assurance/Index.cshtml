@model IEnumerable<BANA.Models.Assurance>

@{
    ViewData["Title"] = "Index";
}

<!-- App container starts -->
<div class="app-container">
  <!-- App hero header starts -->
  <div class="app-hero-header d-flex align-items-center">
    <!-- Breadcrumb starts -->
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
        <a asp-action="Index" asp-controller="Departement">Acceuil</a>
      </li>
      <li class="breadcrumb-item text-primary" aria-current="page">
        Toutes les assurances
      </li>
    </ol>
    <!-- Breadcrumb ends -->
  </div>
  <!-- App Hero header ends -->

  <!-- App body start -->
  <div class="app-body">
    <div class="col-sm-12">
      <div class="card mb-3">
        <div class="card-header">
          <div class="d-flex flex-wrap gap-1">
            <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
              <i class="ri-pie-chart-2-fill text-success fs-4"></i>
              <span class="me-1 fw-semibold ps-1">40</span>
              <span class="text-success">Actifs</span>
            </div>
            <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
              <i class="ri-pie-chart-2-fill text-danger fs-4"></i>
              <span class="me-1 fw-semibold ps-1">1</span>
              <span class="text-danger">Inactifs</span>
            </div>
            <div class="d-flex align-items-center box-shadow px-3 py-1 rounded-2">
              <i class="ri-pie-chart-2-fill text-info fs-4"></i>
              <span class="me-1 fw-semibold ps-1">41</span>
              <span class="text-info">Total</span>
            </div>
            <a href="ajouter-assurance.html" class="btn btn-primary ms-auto">Ajouter nouveau</a>
          </div>
        </div>

        <div class="card-body">
          <!-- Bar de recherche start -->
          <div class="card">
            <div class="card-body">
              <input type="search" id="search" class="form-control" placeholder="Barre de Recherche" />
            </div>
          </div>
          <!-- Bar de recherche end -->

          <!-- Body body start -->
          <div class="table-outer">
            <!-- Table starts -->
            <div class="table-responsive">
              <table id="basicExample" class="table  m-0 align-middle">
                <thead>
                  <tr>
                     <th>#ACTION</th>
                    <th>#</th>
                    <th>Nom ASSUREUR</th>
                    <th>BOITE POSTALE</th>
                    <th>NUI</th>
                    <th>RCCM</th>
                    <th>ADRESSE</th>
                    @* <th>ACTIF</th> *@
                   
                  </tr>
                </thead>
                <tbody id="testfiltre">
                  <!-- Rows can be generated dynamically -->
                  <!-- Example of single row -->
                  @foreach (var item in Model)
                  {
                    <tr class="montest">
                      <td>
                          <button onclick="location.href='/Assurance/Edit/@item.Id';" type="button" class="btn btn-outline-secondary" title="Modifier">
                              <i class="fa fa-pencil"></i>
                          </button>
                          <button onclick="location.href='/Assurance/Delete/@item.Id';" type="button" class="btn btn-outline-secondary" title="Supprimer">
                              <i class="fa fa-trash-o"></i>
                          </button>
                      </td>
                      <td>
                        <img src="/template2/assets/images/assurance.png" class="img-shadow img-2x  me-1" alt="e-Dr Tim Hospital Management" />
                      </td>
                      <td>
                        <a href="" style="color: #126aef;font-weight: bold;">@item.Nom</a>
                        <div>📞 @item.Telephone</div>
                      </td>
                      <td>@item.Bp</td>
                      <td>@item.Niu</td>
                      <td>@item.RC</td>
                      <td>@item.Adresse</td>
                      @* @if(item.Actif==true){<td>✅</td>}else{<td>❌</td>} *@
                      
                      
                    </tr>
                  }
                  

                  <!-- Repeat rows as needed -->
                </tbody>
              </table>
              <!-- Table end -->
            </div>
            <!-- Body body end -->
            
          </div>
        </div>
      </div>
    </div>
    <!-- App body end -->
  </div>
</div>

<a  style="position: fixed;right: 50px;bottom: 45px;" asp-action="Create" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-plus"></i></a>
<a  style="color: white;position: fixed;right: 100px;bottom: 45px;" onclick="return tableToExcel('testfiltre', 'Example Table');" class="btn btn-lg btn-primary btn-lg-square"><i  class="fa fa-file-excel-o"></i></a>