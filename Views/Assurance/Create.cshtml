@model BANA.Models.Assurance

@{
    ViewData["Title"] = "Create";
}

<!-- App container starts -->
<div class="app-container">
    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">
        <!-- Breadcrumb starts -->
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="ri-home-8-line lh-1 pe-3 me-3 border-end"></i>
                <a asp-action="Index" asp-controller="Departement">Acceuil</a>
            </li>
            <li class="breadcrumb-item text-primary" aria-current="page">
                Toutes les assurances
            </li>
        </ol>
        <!-- Breadcrumb ends -->
    </div>
    <!-- App Hero header ends -->

    <!-- app body start -->
    <div class="app-body">
        <div class="col-sm-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title">
            Polyclinique de Poitiers<br /><h7 style="font-size: 12px; color: #4c545e"
              >Ajouter un Nouveau</h7
            >
          </h5>
                </div>

                <div class="card-body">
                    <form asp-action="Create">
                        <div class="row gap-3">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Nom de assureur
                                                <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="Nom" type="text" class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Nom" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Boite postale </label>
                                            <input asp-for="Bp" type="text" class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Bp" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">NIU <span class="text-danger">*</span></label>
                                            <input  asp-for=Niu class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Niu" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Numéro de téléphone</label>
                                            <input asp-for="Telephone" class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Telephone" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Registre de Commerce</label>
                                            <input asp-for="RC"  class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="RC" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="card mb-3">
                                        <div class="form-control">
                                            <label class="form-label" for="a2">Adresse</label>
                                            <input asp-for="Adresse"  class="form-control" style="height: 50px; border: #c3dff1" />
                                            <span asp-validation-for="Adresse" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-check">
                            <input asp-for="Actif" checked class="form-check-input"  />
                            <label class="form-check-label" for="flexCheckDefault">Activer</label>
                        </div>
                        <div style="display: flex; justify-content: end; gap: 10px">
                            <button type="button" onclick="history.back()" class="btn btn-outline-secondary">
                                Annuler
                            </button>
                            <button type="submit" class="btn btn-info">
                                <i class="ri-save-3-line"></i> Enregistrer
                            </button>
                           
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- app body end-->
</div>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
